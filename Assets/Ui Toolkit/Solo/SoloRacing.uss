/* =====================================================================
   SOLO RACING HUB  (requires Common.uss)
   Three mode cards in a stepped skyline (tall / medium / short) so the
   screen reads as a staircase instead of a grid. Story is the largest
   because it is the main solo experience.
   ===================================================================== */

.modes {
    flex-direction: row;
    align-items: flex-end;
    flex-grow: 1;
    margin-top: 24px;
}

.mcard {
    flex-basis: 0;
    margin-right: 14px;
    background-color: var(--c-surface);
    transform-origin: 50% 100%;
}

.mcard:last-child { margin-right: 0; }

.mcard--lg { flex-grow: 1.35; height: 100%; }
.mcard--md { flex-grow: 1;    height: 88%; }
.mcard--sm { flex-grow: 0.9;  height: 76%; }

.mcard:hover { background-color: var(--c-surface-hi); scale: 1.03 1.03; translate: 0 -8px; }

/* IMAGE SLOTS: key art per mode */
.mcard__art {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    transition-property: background-color;
    transition-duration: 0.3s;
}

.art-s1 { background-color: rgba(255, 46, 176, 0.14); }
.art-s2 { background-color: rgba(255, 190, 0, 0.12); }
.art-s3 { background-color: rgba(0, 229, 255, 0.12); }

.mcard:hover .art-s1 { background-color: rgba(255, 46, 176, 0.26); }
.mcard:hover .art-s2 { background-color: rgba(255, 190, 0, 0.22); }
.mcard:hover .art-s3 { background-color: rgba(0, 229, 255, 0.22); }

.mcard__slash {
    position: absolute;
    top: -40%;
    height: 200%;
    rotate: 24deg;
    transition-property: translate;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
}

.mcard__slash--a { right: 22%; width: 90px; background-color: var(--accent-soft); }
.mcard__slash--b { right: 10%; width: 14px; background-color: var(--accent-mid); }
.mcard:hover .mcard__slash { translate: -30px 0; }

.mcard__content { flex-grow: 1; padding: 26px 28px 26px 36px; }
.mcard__top { flex-direction: row; align-items: center; }

.mcard__index {
    font-size: 26px;
    letter-spacing: 4px;
    color: var(--accent);
    -unity-font-style: bold-and-italic;
}

.mcard__title {
    font-size: 76px;
    letter-spacing: 8px;
    color: var(--c-text);
    white-space: nowrap;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

.mcard--md .mcard__title, .mcard--sm .mcard__title { font-size: 58px; letter-spacing: 6px; }

.mcard__sub {
    margin-bottom: 20px;
    font-size: 13px;
    letter-spacing: 5px;
    color: var(--c-text-2);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.mcard__body { margin-bottom: 22px; }

.mcard__stat {
    margin: 4px 0 10px 0;
    font-size: 24px;
    letter-spacing: 3px;
    color: var(--c-text);
    white-space: nowrap;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

.mcard__row { flex-direction: row; margin-top: 8px; }

.mcard__small {
    font-size: 12px;
    letter-spacing: 3px;
    color: var(--c-text-2);
    -unity-font-style: bold;
}

.mcard__cta {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    height: 62px;
    padding: 0 28px 0 30px;
    background-color: var(--accent);
}

.mcard:hover .mcard__cta { background-color: var(--accent-hi); }

.mcard__cta-text {
    margin-right: 20px;
    font-size: 20px;
    letter-spacing: 6px;
    color: var(--c-ink);
    -unity-font-style: bold-and-italic;
}

.mcard__cta .chevron, .mcard:hover .mcard__cta .chevron { border-color: var(--c-ink); }

/* Arc dots (story card) */
.arc-dots { flex-direction: row; align-items: center; margin-top: 14px; }

.arc-dot {
    width: 34px;
    height: 34px;
    margin-right: 8px;
    align-items: center;
    justify-content: center;
    background-color: var(--c-fill-mid);
}

.arc-dot--on { background-color: var(--accent-mid); border-bottom-width: 3px; border-color: var(--accent); }
.arc-dot .lock--sm { margin-right: 0; }
.arc-dots__text { margin-left: 8px; }

/* Ranked emblem */
.mcard__rank { flex-direction: row; align-items: center; margin-bottom: 10px; }
.mcard__rank-text { margin-left: 22px; }

.emblem {
    width: 44px;
    height: 44px;
    margin: 8px 0 8px 8px;
    align-items: center;
    justify-content: center;
    rotate: 45deg;
    border-width: 3px;
    border-color: var(--accent);
    background-color: var(--accent-soft);
}

.emblem__core { width: 16px; height: 16px; background-color: var(--accent); }

/* Free race facts */
.facts { flex-direction: row; margin-bottom: 12px; }
.fact { margin-right: 24px; }

.fact__num {
    font-size: 40px;
    letter-spacing: 2px;
    color: var(--c-text);
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

.fact__label {
    font-size: 11px;
    letter-spacing: 4px;
    color: var(--c-text-3);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

/* Bottom strip */
.hub-bottom {
    flex-direction: row;
    flex-shrink: 0;
    margin-top: 18px;
}

.resume {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    height: 92px;
    margin-right: 14px;
    padding: 0 28px 0 0;
    background-color: var(--c-surface);
}

.resume:hover { background-color: var(--c-surface-hi); scale: 1.015 1.015; transform-origin: 0% 50%; }

.resume__thumb {
    width: 150px;
    height: 100%;
    margin-right: 24px;
    overflow: hidden;
    background-color: rgba(255, 46, 176, 0.2);
    -unity-background-scale-mode: scale-and-crop;
}

.car__slash {
    position: absolute;
    right: 22%;
    top: -50%;
    width: 26px;
    height: 220%;
    rotate: 24deg;
    background-color: var(--c-fill-soft);
}

.resume__text { flex-grow: 1; }

.resume__title {
    font-size: 24px;
    letter-spacing: 3px;
    color: var(--c-text);
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

.daily {
    flex-direction: row;
    align-items: center;
    width: 36%;
    height: 92px;
    padding: 0 28px 0 30px;
    background-color: var(--c-surface);
}

.daily:hover { background-color: var(--c-surface-hi); scale: 1.03 1.03; transform-origin: 100% 50%; }
.daily__text { flex-grow: 1; }

.daily__title {
    font-size: 20px;
    letter-spacing: 3px;
    color: var(--c-text);
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}
