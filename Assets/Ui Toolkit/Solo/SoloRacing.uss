/* =====================================================================
   SOLO RACING HUB  (requires Common.uss)  /  CINEMATIC PASS
   Solo = Story campaigns + Training. Ranked and unranked races are
   online only and live in the Multiplayer screen.

   WHAT CHANGED
   - Full-screen backdrop with image slot (#cine-bg-art), vignette, shafts.
   - Story card: the five character strips now run the full height of the
     card as a lineup on the right, text sits on a dark fade on the left.
     The active strip is wider and grows a bit more on hover.
   - Bigger type, taller training rows, taller bottom strip, glass panels.
   Image slots: .scard__art, .slice__art, .resume__thumb, #cine-bg-art.
   ===================================================================== */

/* ---------------------------------------------------------------------
   0. CINEMATIC BACKDROP (same block as Story.uss, can move to Common.uss)
   #cine-bg-art is the image slot. Put an accent-xxx class on #cine-bg
   from C# so the light shafts take that color.
   Intro animation: add .cine-bg--intro on awake, remove it next frame.
   --------------------------------------------------------------------- */
.cine-bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.cine-bg__art {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 229, 255, 0.05);
    -unity-background-scale-mode: scale-and-crop;
}

.cine-bg__shaft {
    position: absolute;
    top: -60%;
    height: 240%;
    rotate: 24deg;
    translate: 0 0;
    transition-property: translate, opacity;
    transition-duration: 1s;
    transition-timing-function: ease-out;
}

.cine-bg__shaft--a { left: 30%; width: 260px; background-color: rgba(255, 255, 255, 0.025); }
.cine-bg__shaft--b { left: 41%; width: 40px;  background-color: var(--accent-soft); }
.cine-bg__shaft--c { left: 43%; width: 6px;   background-color: var(--accent-mid); }
.cine-bg--intro .cine-bg__shaft { translate: 500px 0; opacity: 0; }

/* Stacked low-alpha bands fake a gradient (USS has no gradients). */
.cine-vig { position: absolute; left: 0; right: 0; background-color: rgba(3, 6, 13, 0.11); }
.cine-vig--b1 { bottom: 0; height: 70%; }
.cine-vig--b2 { bottom: 0; height: 55%; }
.cine-vig--b3 { bottom: 0; height: 42%; }
.cine-vig--b4 { bottom: 0; height: 30%; }
.cine-vig--b5 { bottom: 0; height: 20%; }
.cine-vig--b6 { bottom: 0; height: 11%; }
.cine-vig--t1 { top: 0; height: 26%; }
.cine-vig--t2 { top: 0; height: 18%; }
.cine-vig--t3 { top: 0; height: 10%; }
.cine-vig--t4 { top: 0; height: 4%; }

.hub-body {
    flex-direction: row;
    flex-grow: 1;
    margin-top: 20px;
}

/* ---------------------------------------------------------------------
   1. STORY CARD (left, tall poster)
   --------------------------------------------------------------------- */
.scard {
    flex-grow: 1.5;
    flex-basis: 0;
    margin-right: 18px;
    overflow: hidden;
    background-color: rgba(6, 10, 20, 0.72);
    transform-origin: 50% 50%;
}

.scard:hover { background-color: rgba(14, 22, 40, 0.8); scale: 1.015 1.015; }

/* IMAGE SLOT: story key art */
.scard__art {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(255, 46, 176, 0.12);
    -unity-background-scale-mode: scale-and-crop;
    transition-property: background-color;
    transition-duration: 0.3s;
}

.scard:hover .scard__art { background-color: rgba(255, 46, 176, 0.22); }

.scard__slash {
    position: absolute;
    top: -40%;
    height: 200%;
    rotate: 24deg;
    transition-property: translate;
    transition-duration: 0.35s;
}

.scard__slash--a { right: 20%; width: 110px; background-color: var(--accent-soft); }
.scard__slash--b { right: 9%; width: 16px; background-color: var(--accent-mid); }
.scard:hover .scard__slash { translate: -30px 0; }

/* Dark fades for text legibility: left to right and bottom up */
.scard__fade { position: absolute; background-color: rgba(3, 6, 13, 0.12); }
.scard__fade--l1 { left: 0; top: 0; bottom: 0; width: 74%; }
.scard__fade--l2 { left: 0; top: 0; bottom: 0; width: 58%; }
.scard__fade--l3 { left: 0; top: 0; bottom: 0; width: 44%; }
.scard__fade--l4 { left: 0; top: 0; bottom: 0; width: 30%; }
.scard__fade--l5 { left: 0; top: 0; bottom: 0; width: 16%; }
.scard__fade--b1 { left: 0; right: 0; bottom: 0; height: 60%; }
.scard__fade--b2 { left: 0; right: 0; bottom: 0; height: 42%; }
.scard__fade--b3 { left: 0; right: 0; bottom: 0; height: 26%; }

.scard__content { flex-grow: 1; padding: 30px 38px 34px 44px; }
.scard__top { flex-direction: row; align-items: center; }

.scard__index {
    font-size: 32px;
    letter-spacing: 4px;
    color: var(--accent);
    -unity-font-style: bold-and-italic;
}

/* Arc lineup: full-height character strips on the right half of the card */
.slices {
    position: absolute;
    left: 46%;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: row;
    align-items: stretch;
}

.slice {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 4px;
    overflow: hidden;
    background-color: var(--c-fill-soft);
    transition-property: flex-grow;
    transition-duration: 0.3s;
}

.slice--on { flex-grow: 2.4; border-bottom-width: 6px; border-color: rgb(0, 229, 255); }
.scard:hover .slice--on { flex-grow: 2.9; }

.slice__art {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.slice__veil {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(3, 6, 13, 0.6);
}

.slice__lock {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    scale: 1.5 1.5;
}

.slice__lock .lock--sm { margin-right: 0; }

.scard__title {
    font-size: 116px;
    letter-spacing: 12px;
    color: var(--c-text);
    white-space: nowrap;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

.scard__sub {
    max-width: 44%;
    margin-bottom: 22px;
    font-size: 13px;
    letter-spacing: 4px;
    color: var(--c-text-2);
    white-space: normal;
    -unity-font-style: bold;
    -unity-text-align: upper-left;
}

.scard__now { margin-bottom: 24px; max-width: 44%; }

.scard__now-name {
    margin: 2px 0 8px 0;
    font-size: 28px;
    letter-spacing: 3px;
    color: var(--c-text);
    white-space: nowrap;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

.scard__row { flex-direction: row; margin-bottom: 10px; }

.scard__small {
    font-size: 12px;
    letter-spacing: 3px;
    color: var(--c-text-2);
    -unity-font-style: bold;
}

.scard__cta {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    height: 80px;
    padding: 0 38px 0 40px;
    background-color: var(--accent);
}

.scard:hover .scard__cta { background-color: var(--accent-hi); }

.scard__cta-text {
    margin-right: 24px;
    font-size: 24px;
    letter-spacing: 8px;
    color: var(--c-ink);
    -unity-font-style: bold-and-italic;
}

.scard__cta .chevron, .scard:hover .scard__cta .chevron { border-color: var(--c-ink); }

/* ---------------------------------------------------------------------
   2. TRAINING COLUMN (right, stepped rows)
   --------------------------------------------------------------------- */
.train-col {
    flex-grow: 1;
    flex-basis: 0;
    justify-content: flex-end;
}

.train-head { margin-bottom: 18px; }

.train-head__title {
    font-size: 92px;
    letter-spacing: 11px;
    color: var(--c-text);
    white-space: nowrap;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

.train-head__sub {
    font-size: 13px;
    letter-spacing: 4px;
    color: var(--c-text-2);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.trow {
    flex-direction: row;
    align-items: center;
    height: 128px;
    margin-bottom: 10px;
    padding: 0 30px 0 32px;
    background-color: rgba(6, 10, 20, 0.72);
    transform-origin: 100% 50%;
}

/* Cascade: each row steps in, like the main menu */
.trow--0 { margin-left: 0; }
.trow--1 { margin-left: 32px; }
.trow--2 { margin-left: 64px; }
.trow--3 { margin-left: 96px; }

.trow:hover { background-color: rgba(14, 22, 40, 0.85); scale: 1.04 1.04; translate: -10px 0; }

.trow__idx {
    width: 38px;
    font-size: 26px;
    letter-spacing: 2px;
    color: var(--accent);
    -unity-font-style: bold-and-italic;
}

.trow__ico { margin: 0 28px 0 8px; scale: 1.25 1.25; }
.trow__text { flex-grow: 1; flex-shrink: 1; }

.trow__title {
    font-size: 36px;
    letter-spacing: 6px;
    color: var(--c-text);
    white-space: nowrap;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

.trow__desc {
    font-size: 13px;
    letter-spacing: 3px;
    color: var(--c-text-2);
    white-space: nowrap;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.trow__tag { margin-right: 18px; }

/* ---------------------------------------------------------------------
   3. BOTTOM STRIP
   --------------------------------------------------------------------- */
.hub-bottom { flex-direction: row; flex-shrink: 0; margin-top: 18px; }

.resume {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    height: 108px;
    margin-right: 14px;
    padding: 0 30px 0 0;
    background-color: rgba(6, 10, 20, 0.72);
}

.resume:hover { background-color: rgba(14, 22, 40, 0.85); scale: 1.015 1.015; transform-origin: 0% 50%; }

.resume__thumb {
    width: 200px;
    height: 100%;
    margin-right: 26px;
    overflow: hidden;
    background-color: rgba(255, 46, 176, 0.2);
    -unity-background-scale-mode: scale-and-crop;
}

.car__slash {
    position: absolute;
    right: 22%;
    top: -50%;
    width: 26px;
    height: 220%;
    rotate: 24deg;
    background-color: var(--c-fill-soft);
}

.resume__text { flex-grow: 1; }

.resume__title {
    font-size: 26px;
    letter-spacing: 3px;
    color: var(--c-text);
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

.daily {
    flex-direction: row;
    align-items: center;
    width: 36%;
    height: 108px;
    padding: 0 30px 0 32px;
    background-color: rgba(6, 10, 20, 0.72);
}

.daily:hover { background-color: rgba(14, 22, 40, 0.85); scale: 1.03 1.03; transform-origin: 100% 50%; }
.daily__text { flex-grow: 1; }

.daily__title {
    font-size: 22px;
    letter-spacing: 3px;
    color: var(--c-text);
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}
