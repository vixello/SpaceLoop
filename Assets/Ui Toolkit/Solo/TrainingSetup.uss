/* =====================================================================
   TRAINING SETUP  (requires Common.uss)  /  CINEMATIC PASS
   Backdrop: #cine-bg-art takes a picture or, simpler, a tint in the color of
   the selected planet (style.backgroundColor with ~0.10 alpha). Rail orbs,
   track cards and the launch button are bigger, panels are glass.
   Solar rail (planets, drifting left to right) | 3D planet + info plate |
   flight plan (tracks) and training rig (toggles, traffic, weather).
   Training gives no rank points. Locked planets and tracks stay visible
   with their unlock reason.
   Toggle .orb--sel on the rail, .track--sel on tracks, .tog--on on
   toggles from C#.
   ===================================================================== */

.body {
    flex-direction: row;
    flex-grow: 1;
    margin-top: 18px;
}

/* ---------------------------------------------------------------------
   0. CINEMATIC BACKDROP (same block as Story.uss, can move to Common.uss)
   #cine-bg-art is the image slot. Put an accent-xxx class on #cine-bg
   from C# so the light shafts take that color.
   Intro animation: add .cine-bg--intro on awake, remove it next frame.
   --------------------------------------------------------------------- */
.cine-bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.cine-bg__art {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 229, 255, 0.05);
    -unity-background-scale-mode: scale-and-crop;
}

.cine-bg__shaft {
    position: absolute;
    top: -60%;
    height: 240%;
    rotate: 24deg;
    translate: 0 0;
    transition-property: translate, opacity;
    transition-duration: 1s;
    transition-timing-function: ease-out;
}

.cine-bg__shaft--a { left: 30%; width: 260px; background-color: rgba(255, 255, 255, 0.025); }
.cine-bg__shaft--b { left: 41%; width: 40px;  background-color: var(--accent-soft); }
.cine-bg__shaft--c { left: 43%; width: 6px;   background-color: var(--accent-mid); }
.cine-bg--intro .cine-bg__shaft { translate: 500px 0; opacity: 0; }

/* Stacked low-alpha bands fake a gradient (USS has no gradients). */
.cine-vig { position: absolute; left: 0; right: 0; background-color: rgba(3, 6, 13, 0.11); }
.cine-vig--b1 { bottom: 0; height: 70%; }
.cine-vig--b2 { bottom: 0; height: 55%; }
.cine-vig--b3 { bottom: 0; height: 42%; }
.cine-vig--b4 { bottom: 0; height: 30%; }
.cine-vig--b5 { bottom: 0; height: 20%; }
.cine-vig--b6 { bottom: 0; height: 11%; }
.cine-vig--t1 { top: 0; height: 26%; }
.cine-vig--t2 { top: 0; height: 18%; }
.cine-vig--t3 { top: 0; height: 10%; }
.cine-vig--t4 { top: 0; height: 4%; }

/* ---------------------------------------------------------------------
   1. SOLAR RAIL
   --------------------------------------------------------------------- */
.solar { width: 330px; flex-shrink: 0; margin-right: 20px; }
.rail-label { margin-bottom: 8px; }

.orb {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
    padding: 8px 16px 8px 14px;
    overflow: visible;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 3px;
    border-color: rgba(0, 0, 0, 0);
}

.orb:focus { border-color: rgba(0, 0, 0, 0); }
.orb:hover { background-color: var(--c-fill-soft); translate: 8px 0; }
.orb--sel, .orb--sel:focus, .orb--sel:hover { background-color: var(--accent-soft); border-color: var(--accent); }

.orb--off0 { margin-left: 0; }
.orb--off1 { margin-left: 30px; }
.orb--off2 { margin-left: 52px; }
.orb--off3 { margin-left: 18px; }

.orb__atmo {
    position: absolute;
    left: 1px;
    top: 50%;
    translate: 0 -50%;
    border-width: 2px;
}

.orb__body {
    flex-shrink: 0;
    margin-right: 24px;
    overflow: hidden;
}

.orb--lg .orb__body { width: 124px; height: 124px; border-radius: 62px; }
.orb--md .orb__body { width: 94px;  height: 94px;  border-radius: 47px; }
.orb--sm .orb__body { width: 74px;  height: 74px;  border-radius: 37px; }

.orb--lg .orb__atmo { width: 148px; height: 148px; border-radius: 74px; }
.orb--md .orb__atmo { width: 116px; height: 116px; border-radius: 58px; }
.orb--sm .orb__atmo { width: 94px;  height: 94px;  border-radius: 47px; }

.orb__shade {
    position: absolute;
    left: 38%;
    top: -12%;
    width: 120%;
    height: 130%;
    border-radius: 70px;
    background-color: rgba(2, 5, 12, 0.55);
}

.orb__band { position: absolute; left: 0; right: 0; background-color: rgba(255, 255, 255, 0.14); }
.orb__band--a { top: 32%; height: 10%; }
.orb__band--b { top: 62%; height: 6%; }

.orb__ring {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    border-width: 3px;
    border-radius: 100px;
    border-color: rgba(236, 244, 255, 0.45);
    rotate: -16deg;
}

.orb--md .orb__ring { left: -16px; width: 146px; height: 34px; }
.orb--sm .orb__ring { left: -14px; width: 120px; height: 28px; }

.orb__lock {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    left: 14px;
    align-items: center;
    justify-content: center;
    background-color: rgba(3, 6, 13, 0.55);
}

.orb--md .orb__lock { width: 94px; height: 94px; border-radius: 47px; }
.orb--sm .orb__lock { width: 74px; height: 74px; border-radius: 37px; }
.orb__lock .lock { scale: 0.8 0.8; }

.orb__text { flex-grow: 1; flex-shrink: 1; }

.orb__name {
    font-size: 30px;
    letter-spacing: 5px;
    color: var(--c-text);
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

.orb--sm .orb__name, .orb--md .orb__name { font-size: 24px; }
.orb--locked .orb__name { color: var(--c-text-2); }

.orb__sub {
    font-size: 12px;
    letter-spacing: 4px;
    color: var(--c-text-3);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.orb__req { flex-direction: row; align-items: center; }

.orb__req-text {
    font-size: 11px;
    letter-spacing: 3px;
    color: rgb(255, 190, 0);
    white-space: nowrap;
    -unity-font-style: bold;
}

/* ---------------------------------------------------------------------
   2. CENTER PLATE
   --------------------------------------------------------------------- */
.center {
    flex-grow: 1;
    flex-shrink: 1;
    align-items: center;
    margin: 0 20px 0 20px;
}

.plate { align-items: center; }

.plate__name {
    font-size: 112px;
    letter-spacing: 13px;
    color: var(--c-text);
    white-space: nowrap;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-center;
}

.pstats { flex-direction: row; margin-top: 4px; }

.pstat {
    margin: 0 14px 0 14px;
    padding: 8px 22px 8px 22px;
    align-items: center;
    background-color: rgba(6, 10, 20, 0.72);
    border-bottom-width: 2px;
    border-color: var(--accent);
}

.pstat__label {
    font-size: 10px;
    letter-spacing: 4px;
    color: var(--c-text-3);
    -unity-font-style: bold;
}

.pstat__val {
    font-size: 22px;
    letter-spacing: 2px;
    color: var(--c-text);
    -unity-font-style: bold-and-italic;
}

.plate__desc {
    max-width: 700px;
    margin-top: 16px;
    font-size: 14px;
    letter-spacing: 3px;
    color: var(--c-text-2);
    white-space: normal;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
}

/* ---------------------------------------------------------------------
   3. FLIGHT PLAN + RIG
   --------------------------------------------------------------------- */
.flight { width: 42%; min-width: 680px; max-width: 820px; flex-shrink: 0; }
.flight .tabs-row { margin-bottom: 8px; }
.flight .tab { height: 60px; background-color: rgba(6, 10, 20, 0.72); }
.flight .tab--active { background-color: var(--accent-soft); }

.flight__body {
    flex-grow: 1;
    padding: 16px 18px 18px 18px;
    background-color: rgba(6, 10, 20, 0.8);
    border-top-width: 2px;
    border-color: var(--accent);
}

.flight__head { flex-direction: row; align-items: center; margin-bottom: 10px; flex-shrink: 0; }

.carousel-count {
    font-size: 12px;
    letter-spacing: 4px;
    color: var(--c-text-2);
    -unity-font-style: bold;
}

.track-list { flex-grow: 1; }

.track {
    flex-direction: row;
    align-items: center;
    height: 124px;
    margin-bottom: 8px;
    padding: 0 20px 0 0;
    background-color: var(--c-fill-soft);
}

.track:hover { background-color: var(--c-fill-mid); translate: 8px 0; }
.track--sel, .track--sel:hover { background-color: var(--accent-soft); border-left-width: 0; }
.track--sel .edge { width: 7px; }

/* IMAGE SLOT: track preview */
.track__img {
    width: 220px;
    height: 100%;
    margin-right: 22px;
    overflow: hidden;
    background-color: var(--accent-soft);
    -unity-background-scale-mode: scale-and-crop;
}

.track__veil {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(3, 6, 13, 0.62);
}

.track__lock {
    scale: 1.5 1.5;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.track__text { flex-grow: 1; flex-shrink: 1; }

.track__name {
    font-size: 28px;
    letter-spacing: 3px;
    color: var(--c-text);
    white-space: nowrap;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

.track--locked .track__name { color: var(--c-text-2); }

.track__meta {
    font-size: 12px;
    letter-spacing: 3px;
    color: var(--c-text-2);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.track__right { align-items: flex-end; }

.track__best-label {
    font-size: 10px;
    letter-spacing: 4px;
    color: var(--c-text-3);
    -unity-font-style: bold;
}

.track__best {
    font-size: 22px;
    letter-spacing: 2px;
    color: var(--c-text);
    -unity-font-style: bold;
}

.track__reqrow { flex-direction: row; align-items: center; }

.track__req {
    font-size: 12px;
    letter-spacing: 3px;
    color: rgb(255, 190, 0);
    -unity-font-style: bold;
}

.stars { flex-direction: row; margin-top: 4px; }

.star {
    width: 13px;
    height: 13px;
    margin-left: 12px;
    rotate: 45deg;
    border-width: 2px;
    border-color: var(--c-text-3);
}

.star--on { background-color: rgb(255, 190, 0); border-color: rgb(255, 190, 0); }

.pips { flex-direction: row; margin-top: 4px; }

.pip {
    width: 12px;
    height: 22px;
    margin-right: 5px;
    rotate: 14deg;
    background-color: var(--c-fill-mid);
}

.pip--sm { width: 9px; height: 14px; margin-right: 4px; }
.pip--on { background-color: var(--accent); }

.car__slash {
    position: absolute;
    right: 22%;
    top: -50%;
    width: 26px;
    height: 220%;
    rotate: 24deg;
    background-color: var(--c-fill-soft);
}

/* Rig */
.rig { flex-shrink: 0; margin-top: 8px; padding-top: 12px; border-top-width: 1px; border-color: var(--c-hair); }
.rig__label { margin-bottom: 10px; }

.togs { flex-direction: row; margin-bottom: 10px; }

.tog {
    flex-grow: 1;
    flex-basis: 0;
    height: 84px;
    margin-right: 8px;
    padding: 10px 14px 9px 16px;
    justify-content: space-between;
    background-color: var(--c-fill-soft);
    border-bottom-width: 3px;
    border-color: var(--c-hair-strong);
}

.tog:last-child { margin-right: 0; }
.tog:focus { border-color: var(--c-hair-strong); }
.tog:hover { background-color: var(--c-fill-mid); scale: 1.04 1.04; }
.tog--on, .tog--on:focus { border-color: var(--accent); background-color: var(--accent-soft); }
.tog--on:hover { background-color: var(--accent-mid); }

.tog__label {
    font-size: 15px;
    letter-spacing: 3px;
    color: var(--c-text);
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

.tog__sub {
    font-size: 10px;
    letter-spacing: 3px;
    color: var(--c-text-3);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.switch {
    width: 56px;
    height: 24px;
    background-color: var(--c-fill-mid);
}

.switch__knob {
    position: absolute;
    left: 3px;
    top: 3px;
    width: 18px;
    height: 18px;
    background-color: var(--c-text-2);
    transition-property: left, background-color;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.tog--on .switch { background-color: var(--accent-mid); }
.tog--on .switch__knob { left: 35px; background-color: var(--accent); }

.opt-line { flex-direction: row; align-items: center; margin-bottom: 2px; }
.opt-line__label { width: 130px; flex-shrink: 0; margin-bottom: 8px; }
.opt-line .chip { height: 36px; margin: 0 8px 8px 0; padding: 0 16px 0 16px; }

.launch { width: 100%; height: 96px; margin-top: 8px; flex-shrink: 0; }
.launch .btn-cta__label { font-size: 30px; letter-spacing: 9px; }
