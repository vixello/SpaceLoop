                                </ui:Button>
                            </ui:ScrollView>
                        </ui:VisualElement>
                        <!-- Locked character arc example: every chapter shows the same lock reason. C# builds one page per arc and part. -->
                        <ui:VisualElement class="page page--hidden" name="page-arc-mira-part1" picking-mode="Ignore">
                            <ui:ScrollView class="ch-list" mode="Horizontal" touch-scroll-type="Elastic" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                                <ui:Button class="btn ch ch--lock-char">
                                    <ui:VisualElement class="ch__art" picking-mode="Ignore">
                                        <ui:VisualElement class="car__slash" picking-mode="Ignore" />
                                        <ui:VisualElement class="ch__num" picking-mode="Ignore">
                                            <ui:Label class="ch__num-text" text="01" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                        <ui:Label class="tag ch__kind" text="RACE" picking-mode="Ignore" />
                                        <ui:VisualElement class="ch__veil" picking-mode="Ignore" />
                                        <ui:VisualElement class="ch__lock" picking-mode="Ignore">
                                            <ui:VisualElement class="lock" picking-mode="Ignore">
                                                <ui:VisualElement class="lock__shackle" picking-mode="Ignore" />
                                                <ui:VisualElement class="lock__body" picking-mode="Ignore" />
                                            </ui:VisualElement>
                                        </ui:VisualElement>
