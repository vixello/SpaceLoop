                                    <ui:VisualElement class="ch__bar" picking-mode="Ignore" />
                                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                    <ui:VisualElement class="ch__fade ch__fade--a" picking-mode="Ignore" />
                                    <ui:VisualElement class="ch__fade ch__fade--b" picking-mode="Ignore" />
                                    <ui:VisualElement class="ch__info" picking-mode="Ignore">
                                        <ui:Label class="ch__title" text="RED HORIZON" picking-mode="Ignore" />
                                        <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                        <ui:VisualElement class="ch__reqrow" picking-mode="Ignore">
                                            <ui:VisualElement class="lock lock--sm" picking-mode="Ignore">
                                                <ui:VisualElement class="lock__shackle" picking-mode="Ignore" />
                                                <ui:VisualElement class="lock__body" picking-mode="Ignore" />
                                            </ui:VisualElement>
                                            <ui:Label class="ch__req" text="FINISH CH. 10" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:Button>
                                <ui:VisualElement class="ch-link ch-link--lock" picking-mode="Ignore" />
                                <ui:Button class="btn ch ch--lock-prog ch--boss">
                                    <ui:VisualElement class="ch__art" picking-mode="Ignore">
                                        <ui:VisualElement class="car__slash" picking-mode="Ignore" />
                                        <ui:VisualElement class="ch__num" picking-mode="Ignore">
                                            <ui:Label class="ch__num-text" text="12" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                        <ui:Label class="tag ch__kind" text="BOSS" picking-mode="Ignore" />
                                        <ui:VisualElement class="ch__veil" picking-mode="Ignore" />
                                        <ui:VisualElement class="ch__lock" picking-mode="Ignore">
                                            <ui:VisualElement class="lock" picking-mode="Ignore">
                                                <ui:VisualElement class="lock__shackle" picking-mode="Ignore" />
                                                <ui:VisualElement class="lock__body" picking-mode="Ignore" />
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="ch__bar" picking-mode="Ignore" />
                                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                    <ui:VisualElement class="ch__fade ch__fade--a" picking-mode="Ignore" />
                                    <ui:VisualElement class="ch__fade ch__fade--b" picking-mode="Ignore" />
                                    <ui:VisualElement class="ch__info" picking-mode="Ignore">
                                        <ui:Label class="ch__title" text="ASHES OF AURELIA" picking-mode="Ignore" />
