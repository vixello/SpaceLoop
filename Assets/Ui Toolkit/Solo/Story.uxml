<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/Ui Toolkit/Common/Common.uss" />
    <ui:Style src="project://database/Assets/Ui Toolkit/Solo/Story.uss" />
    <ui:Template name="Scrims" src="project://database/Assets/Ui Toolkit/Common/Components/Scrims.uxml" />
    <ui:Template name="ScreenHeader" src="project://database/Assets/Ui Toolkit/Common/Components/ScreenHeader.uxml" />

    <!-- Story screen (cinematic). Backdrop art + vignette behind. Arc rail on the left, big title card, part tabs and poster chapter path in the center, glass chapter detail on the right. -->
    <ui:VisualElement class="screen" name="root" picking-mode="Position">
        <!-- Backdrop: set background-image on story-bg-art from C# (arc or chapter key art). Put the arc accent class on story-bg. -->
        <ui:VisualElement class="story-bg story-bg--intro accent-cyan" name="story-bg" picking-mode="Ignore">
            <ui:VisualElement class="story-bg__art" name="story-bg-art" picking-mode="Ignore" />
            <ui:VisualElement class="story-bg__shaft story-bg__shaft--a" picking-mode="Ignore" />
            <ui:VisualElement class="story-bg__shaft story-bg__shaft--b" picking-mode="Ignore" />
            <ui:VisualElement class="story-bg__shaft story-bg__shaft--c" picking-mode="Ignore" />
            <ui:VisualElement class="story-vig story-vig--b1" picking-mode="Ignore" />
            <ui:VisualElement class="story-vig story-vig--b2" picking-mode="Ignore" />
            <ui:VisualElement class="story-vig story-vig--b3" picking-mode="Ignore" />
            <ui:VisualElement class="story-vig story-vig--b4" picking-mode="Ignore" />
            <ui:VisualElement class="story-vig story-vig--b5" picking-mode="Ignore" />
            <ui:VisualElement class="story-vig story-vig--b6" picking-mode="Ignore" />
            <ui:VisualElement class="story-vig story-vig--t1" picking-mode="Ignore" />
            <ui:VisualElement class="story-vig story-vig--t2" picking-mode="Ignore" />
            <ui:VisualElement class="story-vig story-vig--t3" picking-mode="Ignore" />
            <ui:VisualElement class="story-vig story-vig--t4" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="layer drag-zone" name="rotate-drag-zone" picking-mode="Position" />
        <ui:Instance class="layer" template="Scrims" picking-mode="Ignore" />
        <ui:VisualElement class="layer hud" name="hud" picking-mode="Ignore">
            <ui:Instance template="ScreenHeader" name="screen-header" picking-mode="Ignore">
                <ui:AttributeOverrides element-name="screen-eyebrow" text="SOLO RACING  /  CAMPAIGN" />
                <ui:AttributeOverrides element-name="screen-title" text="STORY" />
            </ui:Instance>
            <ui:VisualElement class="body" picking-mode="Ignore">
                <ui:VisualElement class="arc-rail" picking-mode="Ignore">
                    <ui:Label class="eyebrow rail-label" text="CHARACTER ARCS" picking-mode="Ignore" />
                    <ui:Button class="btn arc accent-cyan arc--active" name="arc-kai">
                        <ui:VisualElement class="sheen" picking-mode="Ignore" />
                        <ui:VisualElement class="edge" picking-mode="Ignore" />
                        <ui:VisualElement class="arc__portrait" picking-mode="Ignore">
                            <ui:VisualElement class="car__slash" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="arc__text" picking-mode="Ignore">
                            <ui:Label class="arc__char" text="KAI NOVA" picking-mode="Ignore" />
                            <ui:Label class="arc__title" text="EMBER RUN" picking-mode="Ignore" />
                            <ui:VisualElement class="arc__prog" picking-mode="Ignore">
                                <ui:VisualElement class="pbar pbar--thin" picking-mode="Ignore">
                                    <ui:VisualElement class="pbar__fill" style="width: 38%;" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:Label class="arc__count" text="7 / 18" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button class="btn arc accent-amber arc--open" name="arc-dax">
                        <ui:VisualElement class="sheen" picking-mode="Ignore" />
                        <ui:VisualElement class="edge" picking-mode="Ignore" />
                        <ui:VisualElement class="arc__portrait" picking-mode="Ignore">
                            <ui:VisualElement class="car__slash" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="arc__text" picking-mode="Ignore">
                            <ui:Label class="arc__char" text="DAX OROZCO" picking-mode="Ignore" />
                            <ui:Label class="arc__title" text="IRON CIRCUIT" picking-mode="Ignore" />
                            <ui:VisualElement class="arc__prog" picking-mode="Ignore">
                                <ui:VisualElement class="pbar pbar--thin" picking-mode="Ignore">
                                    <ui:VisualElement class="pbar__fill" style="width: 20%;" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:Label class="arc__count" text="3 / 15" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button class="btn arc accent-green arc--lock-prog" name="arc-juno">
                        <ui:VisualElement class="sheen" picking-mode="Ignore" />
                        <ui:VisualElement class="edge" picking-mode="Ignore" />
                        <ui:VisualElement class="arc__portrait" picking-mode="Ignore">
                            <ui:VisualElement class="car__slash" picking-mode="Ignore" />
                            <ui:VisualElement class="arc__veil" picking-mode="Ignore" />
                            <ui:VisualElement class="arc__lock" picking-mode="Ignore">
                                <ui:VisualElement class="lock" picking-mode="Ignore">
                                    <ui:VisualElement class="lock__shackle" picking-mode="Ignore" />
                                    <ui:VisualElement class="lock__body" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="arc__text" picking-mode="Ignore">
                            <ui:Label class="arc__char" text="JUNO PARK" picking-mode="Ignore" />
                            <ui:Label class="arc__title" text="STARLIGHT" picking-mode="Ignore" />
                            <ui:VisualElement class="arc__req" picking-mode="Ignore">
                                <ui:VisualElement class="lock lock--sm" picking-mode="Ignore">
                                    <ui:VisualElement class="lock__shackle" picking-mode="Ignore" />
                                    <ui:VisualElement class="lock__body" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:Label class="arc__req-text" text="FINISH KAI PART II" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button class="btn arc accent-magenta arc--lock-char" name="arc-mira">
                        <ui:VisualElement class="sheen" picking-mode="Ignore" />
                        <ui:VisualElement class="edge" picking-mode="Ignore" />
                        <ui:VisualElement class="arc__portrait" picking-mode="Ignore">
                            <ui:VisualElement class="car__slash" picking-mode="Ignore" />
                            <ui:VisualElement class="arc__veil" picking-mode="Ignore" />
                            <ui:VisualElement class="arc__lock" picking-mode="Ignore">
                                <ui:VisualElement class="lock" picking-mode="Ignore">
                                    <ui:VisualElement class="lock__shackle" picking-mode="Ignore" />
                                    <ui:VisualElement class="lock__body" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="arc__text" picking-mode="Ignore">
                            <ui:Label class="arc__char" text="MIRA VOSS" picking-mode="Ignore" />
                            <ui:Label class="arc__title" text="BLACK TIDE" picking-mode="Ignore" />
                            <ui:VisualElement class="arc__req" picking-mode="Ignore">
                                <ui:VisualElement class="lock lock--sm" picking-mode="Ignore">
                                    <ui:VisualElement class="lock__shackle" picking-mode="Ignore" />
                                    <ui:VisualElement class="lock__body" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:Label class="arc__req-text" text="UNLOCK MIRA VOSS" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button class="btn arc accent-violet arc--lock-char" name="arc-zero">
                        <ui:VisualElement class="sheen" picking-mode="Ignore" />
                        <ui:VisualElement class="edge" picking-mode="Ignore" />
                        <ui:VisualElement class="arc__portrait" picking-mode="Ignore">
                            <ui:VisualElement class="car__slash" picking-mode="Ignore" />
                            <ui:VisualElement class="arc__veil" picking-mode="Ignore" />
                            <ui:VisualElement class="arc__lock" picking-mode="Ignore">
                                <ui:VisualElement class="lock" picking-mode="Ignore">
                                    <ui:VisualElement class="lock__shackle" picking-mode="Ignore" />
                                    <ui:VisualElement class="lock__body" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="arc__text" picking-mode="Ignore">
                            <ui:Label class="arc__char" text="ZERO-7" picking-mode="Ignore" />
                            <ui:Label class="arc__title" text="NULL SIGNAL" picking-mode="Ignore" />
                            <ui:VisualElement class="arc__req" picking-mode="Ignore">
                                <ui:VisualElement class="lock lock--sm" picking-mode="Ignore">
                                    <ui:VisualElement class="lock__shackle" picking-mode="Ignore" />
                                    <ui:VisualElement class="lock__body" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:Label class="arc__req-text" text="UNLOCK ZERO-7" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement class="story-center" picking-mode="Ignore">
                    <ui:VisualElement class="arc-banner accent-cyan" picking-mode="Ignore">
                        <ui:VisualElement class="arc-banner__text" picking-mode="Ignore">
                            <ui:Label class="eyebrow eyebrow--accent" text="KAI NOVA  /  VANGUARD" name="arc-char" picking-mode="Ignore" />
                            <ui:Label class="arc-banner__title" text="EMBER RUN" name="arc-title" picking-mode="Ignore" />
                            <ui:Label class="arc-banner__desc" text="A BURNED-OUT PILOT RETURNS TO AURELIA TO FIND WHO SABOTAGED THE LAST GRAND PRIX." name="arc-desc" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="arc-banner__stats" picking-mode="Ignore">
                            <ui:VisualElement class="fact" picking-mode="Ignore">
                                <ui:Label class="fact__num" text="7 / 18" picking-mode="Ignore" />
                                <ui:Label class="fact__label" text="CHAPTERS" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="fact" picking-mode="Ignore">
                                <ui:Label class="fact__num" text="12 / 54" picking-mode="Ignore" />
                                <ui:Label class="fact__label" text="STARS" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="tabs-row part-tabs" picking-mode="Position">
                        <ui:Button class="btn tab accent-cyan" name="part-1">
                            <ui:VisualElement class="sheen" picking-mode="Ignore" />
                            <ui:VisualElement class="edge" picking-mode="Ignore" />
                            <ui:VisualElement class="check part-check" picking-mode="Ignore" />
                            <ui:Label class="tab__label" text="PART I  /  IGNITION" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button class="btn tab accent-cyan tab--active" name="part-2">
                            <ui:VisualElement class="sheen" picking-mode="Ignore" />
                            <ui:VisualElement class="edge" picking-mode="Ignore" />
                            <ui:Label class="tab__label" text="PART II  /  EMBER RUN" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button class="btn tab accent-cyan tab--locked" name="part-3">
                            <ui:VisualElement class="sheen" picking-mode="Ignore" />
                            <ui:VisualElement class="edge" picking-mode="Ignore" />
                            <ui:VisualElement class="lock lock--sm" picking-mode="Ignore">
                                <ui:VisualElement class="lock__shackle" picking-mode="Ignore" />
                                <ui:VisualElement class="lock__body" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:Label class="tab__label" text="PART III  /  ZENITH" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="story-pages" picking-mode="Ignore">
                        <ui:VisualElement class="page" name="page-arc-kai-part2" picking-mode="Ignore">
                            <ui:ScrollView class="ch-list" mode="Horizontal" touch-scroll-type="Elastic" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                                <ui:Button class="btn ch ch--current ch--sel">
                                    <ui:VisualElement class="ch__art" picking-mode="Ignore">
                                        <ui:VisualElement class="car__slash" picking-mode="Ignore" />
                                        <ui:VisualElement class="ch__num" picking-mode="Ignore">
                                            <ui:Label class="ch__num-text" text="07" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                        <ui:Label class="tag ch__kind" text="RACE" picking-mode="Ignore" />
                                        <ui:VisualElement class="ch__play" picking-mode="Ignore">
                                            <ui:VisualElement class="ch__play-tri" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="ch__bar" picking-mode="Ignore" />
                                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                    <ui:VisualElement class="ch__fade ch__fade--a" picking-mode="Ignore" />
                                    <ui:VisualElement class="ch__fade ch__fade--b" picking-mode="Ignore" />
                                    <ui:VisualElement class="ch__info" picking-mode="Ignore">
                                        <ui:Label class="ch__title" text="EMBER RUN" picking-mode="Ignore" />
                                        <ui:VisualElement class="stars" picking-mode="Ignore">
                                            <ui:VisualElement class="star" picking-mode="Ignore" />
                                            <ui:VisualElement class="star" picking-mode="Ignore" />
                                            <ui:VisualElement class="star" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                        <ui:Label class="ch__state ch__state--on" text="PLAY NOW" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:Button>
                                <ui:VisualElement class="ch-link ch-link--now" picking-mode="Ignore" />
                                <ui:Button class="btn ch ch--lock-prog">
                                    <ui:VisualElement class="ch__art" picking-mode="Ignore">
                                        <ui:VisualElement class="car__slash" picking-mode="Ignore" />
                                        <ui:VisualElement class="ch__num" picking-mode="Ignore">
                                            <ui:Label class="ch__num-text" text="08" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                        <ui:Label class="tag ch__kind" text="DUEL" picking-mode="Ignore" />
                                        <ui:VisualElement class="ch__veil" picking-mode="Ignore" />
                                        <ui:VisualElement class="ch__lock" picking-mode="Ignore">
                                            <ui:VisualElement class="lock" picking-mode="Ignore">
                                                <ui:VisualElement class="lock__shackle" picking-mode="Ignore" />
                                                <ui:VisualElement class="lock__body" picking-mode="Ignore" />
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="ch__bar" picking-mode="Ignore" />
                                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                    <ui:VisualElement class="ch__fade ch__fade--a" picking-mode="Ignore" />
                                    <ui:VisualElement class="ch__fade ch__fade--b" picking-mode="Ignore" />
                                    <ui:VisualElement class="ch__info" picking-mode="Ignore">
                                        <ui:Label class="ch__title" text="SMOKE AND MIRRORS" picking-mode="Ignore" />
                                        <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                        <ui:VisualElement class="ch__reqrow" picking-mode="Ignore">
                                            <ui:VisualElement class="lock lock--sm" picking-mode="Ignore">
                                                <ui:VisualElement class="lock__shackle" picking-mode="Ignore" />
                                                <ui:VisualElement class="lock__body" picking-mode="Ignore" />
                                            </ui:VisualElement>
                                            <ui:Label class="ch__req" text="FINISH CH. 7" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:Button>
                                <ui:VisualElement class="ch-link ch-link--lock" picking-mode="Ignore" />
                                <ui:Button class="btn ch ch--lock-prog">
                                    <ui:VisualElement class="ch__art" picking-mode="Ignore">
                                        <ui:VisualElement class="car__slash" picking-mode="Ignore" />
                                        <ui:VisualElement class="ch__num" picking-mode="Ignore">
                                            <ui:Label class="ch__num-text" text="09" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                        <ui:Label class="tag ch__kind" text="RACE" picking-mode="Ignore" />
                                        <ui:VisualElement class="ch__veil" picking-mode="Ignore" />
                                        <ui:VisualElement class="ch__lock" picking-mode="Ignore">
                                            <ui:VisualElement class="lock" picking-mode="Ignore">
                                                <ui:VisualElement class="lock__shackle" picking-mode="Ignore" />
                                                <ui:VisualElement class="lock__body" picking-mode="Ignore" />
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="ch__bar" picking-mode="Ignore" />
                                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                    <ui:VisualElement class="ch__fade ch__fade--a" picking-mode="Ignore" />
                                    <ui:VisualElement class="ch__fade ch__fade--b" picking-mode="Ignore" />
                                    <ui:VisualElement class="ch__info" picking-mode="Ignore">
                                        <ui:Label class="ch__title" text="THE LONG WAY DOWN" picking-mode="Ignore" />
                                        <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                        <ui:VisualElement class="ch__reqrow" picking-mode="Ignore">
                                            <ui:VisualElement class="lock lock--sm" picking-mode="Ignore">
                                                <ui:VisualElement class="lock__shackle" picking-mode="Ignore" />
                                                <ui:VisualElement class="lock__body" picking-mode="Ignore" />
                                            </ui:VisualElement>
                                            <ui:Label class="ch__req" text="FINISH CH. 8" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:Button>
                                <ui:VisualElement class="ch-link ch-link--lock" picking-mode="Ignore" />
                                <ui:Button class="btn ch ch--lock-prog">
                                    <ui:VisualElement class="ch__art" picking-mode="Ignore">
                                        <ui:VisualElement class="car__slash" picking-mode="Ignore" />
                                        <ui:VisualElement class="ch__num" picking-mode="Ignore">
                                            <ui:Label class="ch__num-text" text="10" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                        <ui:Label class="tag ch__kind" text="STORY" picking-mode="Ignore" />
                                        <ui:VisualElement class="ch__veil" picking-mode="Ignore" />
                                        <ui:VisualElement class="ch__lock" picking-mode="Ignore">
                                            <ui:VisualElement class="lock" picking-mode="Ignore">
                                                <ui:VisualElement class="lock__shackle" picking-mode="Ignore" />
                                                <ui:VisualElement class="lock__body" picking-mode="Ignore" />
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="ch__bar" picking-mode="Ignore" />
                                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                    <ui:VisualElement class="ch__fade ch__fade--a" picking-mode="Ignore" />
                                    <ui:VisualElement class="ch__fade ch__fade--b" picking-mode="Ignore" />
                                    <ui:VisualElement class="ch__info" picking-mode="Ignore">
                                        <ui:Label class="ch__title" text="BROKEN SIGNAL" picking-mode="Ignore" />
                                        <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                        <ui:VisualElement class="ch__reqrow" picking-mode="Ignore">
                                            <ui:VisualElement class="lock lock--sm" picking-mode="Ignore">
                                                <ui:VisualElement class="lock__shackle" picking-mode="Ignore" />
                                                <ui:VisualElement class="lock__body" picking-mode="Ignore" />
                                            </ui:VisualElement>
                                            <ui:Label class="ch__req" text="FINISH CH. 9" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:Button>
                                <ui:VisualElement class="ch-link ch-link--lock" picking-mode="Ignore" />
                                <ui:Button class="btn ch ch--lock-prog">
                                    <ui:VisualElement class="ch__art" picking-mode="Ignore">
                                        <ui:VisualElement class="car__slash" picking-mode="Ignore" />
                                        <ui:VisualElement class="ch__num" picking-mode="Ignore">
                                            <ui:Label class="ch__num-text" text="11" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                        <ui:Label class="tag ch__kind" text="RACE" picking-mode="Ignore" />
                                        <ui:VisualElement class="ch__veil" picking-mode="Ignore" />
                                        <ui:VisualElement class="ch__lock" picking-mode="Ignore">
                                            <ui:VisualElement class="lock" picking-mode="Ignore">
                                                <ui:VisualElement class="lock__shackle" picking-mode="Ignore" />
                                                <ui:VisualElement class="lock__body" picking-mode="Ignore" />
                                            </ui:VisualElement>
