/* =====================================================================
   RACE SETUP  (requires Common.uss)
   Mode switch (Ranked / Unranked) | track list for the chosen planet |
   setup panel | planet strip at the bottom.
   Toggle .page--hidden on pane-ranked / pane-unranked, .mode--active on
   the mode buttons, .planet--sel on the planet strip from C#.
   Locked planets and tracks stay visible with their unlock reason.
   ===================================================================== */

.body {
    flex-direction: row;
    flex-grow: 1;
    margin-top: 18px;
}

/* ---------------------------------------------------------------------
   1. MODE SWITCH
   --------------------------------------------------------------------- */
.mode-row {
    flex-direction: row;
    align-items: center;
    height: 70px;
    margin-top: 18px;
    flex-shrink: 0;
}

.mode {
    width: 360px;
    height: 100%;
    padding: 0 28px 0 28px;
    justify-content: center;
    background-color: var(--c-surface);
}

.mode:hover { background-color: var(--c-surface-hi); scale: 1.03 1.03; }

.mode__eyebrow {
    font-size: 12px;
    letter-spacing: 5px;
    color: var(--accent);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.mode__name {
    font-size: 28px;
    letter-spacing: 5px;
    color: var(--c-text-2);
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

.mode__bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 4px;
    background-color: var(--accent);
    scale: 0 1;
    transform-origin: 0% 50%;
    transition-property: scale;
    transition-duration: 0.25s;
}

.mode:hover .mode__bar { scale: 0.4 1; }
.mode:hover .mode__name { color: var(--c-text); }
.mode--active, .mode--active:hover { background-color: var(--accent-soft); }
.mode--active .mode__name { color: var(--c-text); }
.mode--active .mode__bar, .mode--active:hover .mode__bar { scale: 1 1; }

.mode__sep {
    width: 6px;
    height: 90px;
    margin: 0 14px 0 14px;
    rotate: 24deg;
    background-color: var(--c-hair-strong);
}

/* ---------------------------------------------------------------------
   2. TRACK LIST (left)
   --------------------------------------------------------------------- */
.track-panel {
    width: 33%;
    min-width: 520px;
    max-width: 680px;
    padding: 18px 18px 8px 18px;
    background-color: var(--c-surface);
    border-top-width: 2px;
    border-color: var(--accent);
}

.track-panel__head {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 14px;
}

.track-panel__name {
    font-size: 46px;
    letter-spacing: 7px;
    color: var(--c-text);
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

.carousel-count {
    margin-bottom: 8px;
    font-size: 12px;
    letter-spacing: 4px;
    color: var(--c-text-2);
    -unity-font-style: bold;
}

.track-list { flex-grow: 1; }

.track {
    flex-direction: row;
    align-items: center;
    height: 112px;
    margin-bottom: 8px;
    padding: 0 18px 0 0;
    background-color: var(--c-fill-soft);
}

.track:hover { background-color: var(--c-fill-mid); translate: 8px 0; }
.track--sel, .track--sel:hover { background-color: var(--accent-soft); }
.track--sel .edge { width: 7px; }

/* IMAGE SLOT: track preview */
.track__img {
    width: 170px;
    height: 100%;
    margin-right: 20px;
    overflow: hidden;
    background-color: var(--accent-soft);
    -unity-background-scale-mode: scale-and-crop;
}

.track__veil {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(3, 6, 13, 0.62);
}

.track__lock {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.track__text { flex-grow: 1; flex-shrink: 1; }

.track__name {
    font-size: 24px;
    letter-spacing: 3px;
    color: var(--c-text);
    white-space: nowrap;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

.track--locked .track__name { color: var(--c-text-2); }

.track__meta {
    font-size: 12px;
    letter-spacing: 3px;
    color: var(--c-text-2);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.track__right { align-items: flex-end; }

.track__best-label {
    font-size: 10px;
    letter-spacing: 4px;
    color: var(--c-text-3);
    -unity-font-style: bold;
}

.track__best {
    font-size: 20px;
    letter-spacing: 2px;
    color: var(--c-text);
    -unity-font-style: bold;
}

.ch__reqrow { flex-direction: row; align-items: center; }

.ch__req {
    font-size: 11px;
    letter-spacing: 3px;
    color: rgb(255, 190, 0);
    -unity-font-style: bold;
}

.stars { flex-direction: row; margin-top: 4px; }

.star {
    width: 12px;
    height: 12px;
    margin-left: 10px;
    rotate: 45deg;
    border-width: 2px;
    border-color: var(--c-text-3);
}

.star--on { background-color: rgb(255, 190, 0); border-color: rgb(255, 190, 0); }

.pips { flex-direction: row; margin-top: 6px; }

.pip {
    width: 14px;
    height: 26px;
    margin-right: 6px;
    rotate: 14deg;
    background-color: var(--c-fill-mid);
}

.pip--sm { width: 10px; height: 16px; margin-right: 5px; }
.pip--on { background-color: var(--accent); }

.car__slash {
    position: absolute;
    right: 22%;
    top: -50%;
    width: 26px;
    height: 220%;
    rotate: 24deg;
    background-color: var(--c-fill-soft);
}

/* ---------------------------------------------------------------------
   3. SETUP PANEL (right)
   --------------------------------------------------------------------- */
.setup-panel {
    width: 31%;
    min-width: 500px;
    max-width: 620px;
    padding: 22px 24px 22px 24px;
    background-color: var(--c-surface);
    border-top-width: 2px;
    border-color: var(--c-hair-strong);
}

.setup__go { width: 100%; height: 88px; margin-top: 14px; }
.setup__go .btn-cta__label { font-size: 28px; letter-spacing: 8px; }

.setup__note {
    font-size: 12px;
    letter-spacing: 3px;
    color: var(--c-text-3);
    white-space: normal;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.opt { margin-bottom: 8px; }
.opt__label { margin-bottom: 10px; }

/* Ranked pane */
.rk-head { flex-direction: row; align-items: center; margin-bottom: 14px; }
.rk-head__text { margin-left: 24px; }

.rk-head__name {
    font-size: 44px;
    letter-spacing: 6px;
    color: var(--c-text);
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

.rk-head__rp {
    font-size: 14px;
    letter-spacing: 3px;
    color: var(--c-text-2);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.emblem {
    width: 44px;
    height: 44px;
    margin: 8px;
    align-items: center;
    justify-content: center;
    rotate: 45deg;
    border-width: 3px;
    border-color: var(--accent);
    background-color: var(--accent-soft);
}

.emblem--lg { width: 58px; height: 58px; margin: 12px; }
.emblem__core { width: 20px; height: 20px; background-color: var(--accent); }

.ladder { flex-direction: row; margin: 20px 0 16px 0; }

.rung { flex-grow: 1; flex-basis: 0; align-items: center; }

.rung__bar { width: 100%; height: 4px; background-color: var(--c-fill-mid); }

.rung__gem {
    width: 14px;
    height: 14px;
    margin: 12px 0 8px 0;
    rotate: 45deg;
    border-width: 2px;
    border-color: var(--c-text-3);
}

.rung__name {
    font-size: 10px;
    letter-spacing: 2px;
    color: var(--c-text-3);
    -unity-font-style: bold;
}

.rung--done .rung__bar { background-color: var(--accent); }
.rung--done .rung__gem { background-color: var(--accent); border-color: var(--accent); }
.rung--done .rung__name { color: var(--c-text-2); }
.rung--now .rung__bar { background-color: var(--accent); }
.rung--now .rung__gem { background-color: var(--accent-hi); border-color: var(--accent-hi); scale: 1.4 1.4; }
.rung--now .rung__name { color: var(--c-text); }

.promo-box {
    flex-direction: row;
    align-items: center;
    padding: 14px 18px 14px 18px;
    background-color: var(--accent-soft);
    border-left-width: 3px;
    border-color: var(--accent);
}

.promo-box__text { flex-grow: 1; }

.promo-box__desc {
    font-size: 14px;
    letter-spacing: 2px;
    color: var(--c-text);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.rules, .rewards-box { margin-top: 16px; }

.rules__row { flex-direction: row; flex-wrap: wrap; margin-top: 8px; }

.rules__item {
    margin: 0 8px 8px 0;
    padding: 6px 14px 6px 14px;
    font-size: 12px;
    letter-spacing: 3px;
    color: var(--c-text);
    background-color: var(--c-fill-mid);
    -unity-font-style: bold;
}

.rewards { flex-direction: row; align-items: center; flex-wrap: wrap; margin-top: 8px; }
.rewards .price { margin-right: 22px; }

.sd__reward-item {
    font-size: 13px;
    letter-spacing: 3px;
    color: var(--c-text);
    -unity-font-style: bold;
}

/* ---------------------------------------------------------------------
   4. PLANET STRIP
   --------------------------------------------------------------------- */
.planet-strip {
    flex-direction: row;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 12px;
}

.planet {
    width: 188px;
    height: 206px;
    margin: 0 8px 0 8px;
    padding-top: 22px;
    align-items: center;
    overflow: visible;
    background-color: rgba(0, 0, 0, 0);
    border-bottom-width: 3px;
    border-color: rgba(0, 0, 0, 0);
}

.planet:focus { border-color: rgba(0, 0, 0, 0); }
.planet:hover { background-color: var(--c-fill-soft); scale: 1.08 1.08; translate: 0 -6px; border-color: var(--c-hair-strong); }
.planet--sel, .planet--sel:focus, .planet--sel:hover { background-color: var(--accent-soft); border-color: var(--accent); }

.planet__atmo {
    position: absolute;
    left: 28px;
    top: 10px;
    width: 132px;
    height: 132px;
    border-radius: 66px;
    border-width: 3px;
}

/* Body is clipped to a circle; the shade creates a night-side crescent */
.planet__body {
    width: 108px;
    height: 108px;
    margin-bottom: 18px;
    border-radius: 54px;
    overflow: hidden;
}

.planet__shade {
    position: absolute;
    left: 40px;
    top: -14px;
    width: 120px;
    height: 140px;
    border-radius: 60px;
    background-color: rgba(2, 5, 12, 0.55);
}

.planet__band { position: absolute; left: 0; right: 0; background-color: rgba(255, 255, 255, 0.14); }
.planet__band--a { top: 34px; height: 10px; }
.planet__band--b { top: 66px; height: 6px; }

.planet__ring {
    position: absolute;
    left: -6px;
    top: 52px;
    width: 200px;
    height: 44px;
    border-radius: 100px;
    border-width: 3px;
    border-color: rgba(236, 244, 255, 0.45);
    rotate: -16deg;
}

.planet__lock {
    position: absolute;
    left: 40px;
    top: 22px;
    width: 108px;
    height: 108px;
    align-items: center;
    justify-content: center;
    border-radius: 54px;
    background-color: rgba(3, 6, 13, 0.5);
}

.planet__name {
    font-size: 22px;
    letter-spacing: 5px;
    color: var(--c-text);
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-center;
}

.planet--locked .planet__name { color: var(--c-text-2); }

.planet__sub {
    font-size: 11px;
    letter-spacing: 4px;
    color: var(--c-text-3);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
