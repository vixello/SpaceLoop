                </ui:VisualElement>
                <ui:Label text="YOU NEED TO UPDATE THE GAME TO KEEP PLAYING ONLINE." picking-mode="Ignore" class="dlg__text" />
                <ui:VisualElement picking-mode="Ignore" class="ver">
                    <ui:Label text="0.9.4" picking-mode="Ignore" class="ver__old" />
                    <ui:VisualElement picking-mode="Ignore" class="ver__arrow">
                        <ui:VisualElement picking-mode="Ignore" class="chevron" />
