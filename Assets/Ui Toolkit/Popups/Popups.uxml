<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Ui%20Toolkit/Common/Common.uss?fileID=7433441132597879392&amp;guid=f1e0c419fffe5c54ea31b5bd59f0c918&amp;type=3#Common" />
    <Style src="project://database/Assets/Ui%20Toolkit/Popups/Popups.uss?fileID=7433441132597879392&amp;guid=c8d094e6a013300408ede7b3c6a9197a&amp;type=3#Popups" />
    <ui:VisualElement name="popups" picking-mode="Ignore" class="popups layer">
        <ui:VisualElement name="popup-link" class="modal-layer hidden" style="display: none;">
            <ui:VisualElement picking-mode="Ignore" class="dlg accent-cyan">
                <ui:VisualElement picking-mode="Ignore" class="dlg__bar" />
                <ui:VisualElement picking-mode="Ignore" class="dlg__head">
                    <ui:VisualElement picking-mode="Ignore" class="ico ico--link">
                        <ui:VisualElement picking-mode="Ignore" class="ico__a" />
                        <ui:VisualElement picking-mode="Ignore" class="ico__b" />
                        <ui:VisualElement picking-mode="Ignore" class="ico__c" />
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="dlg__headtext">
                        <ui:Label text="ACCOUNT" picking-mode="Ignore" class="eyebrow eyebrow--accent" />
                        <ui:Label text="LINK ACCOUNT" picking-mode="Ignore" class="dlg__title" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="LINK A LOGIN METHOD SO YOU CAN RECOVER YOUR PROGRESS AND PLAY ON ANOTHER DEVICE." picking-mode="Ignore" class="dlg__text" />
                <ui:VisualElement picking-mode="Ignore" class="provs">
                    <ui:VisualElement class="prov prov--linked">
                        <ui:VisualElement picking-mode="Ignore" class="prov__logo prov__logo--google">
                            <ui:VisualElement picking-mode="Ignore" class="g g--b" />
                            <ui:VisualElement picking-mode="Ignore" class="g g--r" />
                            <ui:VisualElement picking-mode="Ignore" class="g g--y" />
                            <ui:VisualElement picking-mode="Ignore" class="g g--g" />
                        </ui:VisualElement>
                        <ui:VisualElement picking-mode="Ignore" class="prov__text">
                            <ui:Label text="GOOGLE" picking-mode="Ignore" class="prov__name" />
                            <ui:Label text="NOVA.RUNNER@GMAIL.COM" picking-mode="Ignore" class="prov__sub" />
                        </ui:VisualElement>
                        <ui:Button name="btn-unlink-google" class="btn prov__btn prov__btn--linked">
                            <ui:VisualElement picking-mode="Ignore" class="sheen" />
                            <ui:Label text="UNLINK" picking-mode="Ignore" class="prov__btn-text" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="prov prov--open">
                        <ui:VisualElement picking-mode="Ignore" class="prov__logo prov__logo--apple" />
                        <ui:VisualElement picking-mode="Ignore" class="prov__text">
                            <ui:Label text="APPLE" picking-mode="Ignore" class="prov__name" />
                            <ui:Label text="NOT LINKED" picking-mode="Ignore" class="prov__sub" />
                        </ui:VisualElement>
                        <ui:Button name="btn-link-apple" class="btn prov__btn prov__btn--open">
                            <ui:VisualElement picking-mode="Ignore" class="sheen" />
                            <ui:Label text="LINK" picking-mode="Ignore" class="prov__btn-text" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="prov prov--open">
                        <ui:VisualElement picking-mode="Ignore" class="prov__logo prov__logo--fb" />
                        <ui:VisualElement picking-mode="Ignore" class="prov__text">
                            <ui:Label text="FACEBOOK" picking-mode="Ignore" class="prov__name" />
                            <ui:Label text="NOT LINKED" picking-mode="Ignore" class="prov__sub" />
                        </ui:VisualElement>
                        <ui:Button name="btn-link-facebook" class="btn prov__btn prov__btn--open">
                            <ui:VisualElement picking-mode="Ignore" class="sheen" />
                            <ui:Label text="LINK" picking-mode="Ignore" class="prov__btn-text" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="prov prov--soon">
                        <ui:VisualElement picking-mode="Ignore" class="prov__logo prov__logo--more" />
                        <ui:VisualElement picking-mode="Ignore" class="prov__text">
                            <ui:Label text="MORE OPTIONS" picking-mode="Ignore" class="prov__name" />
                            <ui:Label text="COMING SOON" picking-mode="Ignore" class="prov__sub" />
                        </ui:VisualElement>
                        <ui:Button name="btn-link-more" class="btn prov__btn prov__btn--soon">
                            <ui:VisualElement picking-mode="Ignore" class="sheen" />
                            <ui:Label text="SOON" picking-mode="Ignore" class="prov__btn-text" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="YOU NEED AT LEAST ONE LINKED LOGIN METHOD." picking-mode="Ignore" class="dlg__note" />
                <ui:VisualElement picking-mode="Ignore" class="dlg__row">
                    <ui:Button name="btn-link-close" class="btn btn-ghost dlg__btn accent-cyan">
                        <ui:VisualElement picking-mode="Ignore" class="sheen" />
                        <ui:Label text="CLOSE" picking-mode="Ignore" class="btn-ghost__label" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="popup-conflict" class="modal-layer hidden" style="display: none;">
