                                <ui:Label text="BRONZE II" picking-mode="Ignore" class="sstat__val" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="sstat">
                                <ui:Label text="PLAYTIME" picking-mode="Ignore" class="sstat__label" />
                                <ui:Label text="1H 12M" picking-mode="Ignore" class="sstat__val" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="sstat">
                                <ui:Label text="CREDITS" picking-mode="Ignore" class="sstat__label" />
                                <ui:Label text="4,200" picking-mode="Ignore" class="sstat__val" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="sstat">
                                <ui:Label text="VEHICLES" picking-mode="Ignore" class="sstat__label" />
                                <ui:Label text="1" picking-mode="Ignore" class="sstat__val" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="sstat">
                                <ui:Label text="LAST PLAYED" picking-mode="Ignore" class="sstat__label" />
                                <ui:Label text="TODAY" picking-mode="Ignore" class="sstat__val" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="save-linked" class="btn save save--sel">
                        <ui:VisualElement picking-mode="Ignore" class="sheen" />
                        <ui:VisualElement picking-mode="Ignore" class="save__top">
                            <ui:Label text="LINKED ACCOUNT" picking-mode="Ignore" class="tag tag--accent" />
                            <ui:VisualElement picking-mode="Ignore" class="spacer" />
                            <ui:Label text="MORE PROGRESS" picking-mode="Ignore" class="save__best" />
                            <ui:VisualElement picking-mode="Ignore" class="save__radio">
                                <ui:VisualElement picking-mode="Ignore" class="save__radio-dot" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement picking-mode="Ignore" class="save__who">
                            <ui:VisualElement picking-mode="Ignore" class="save__av" />
                            <ui:VisualElement picking-mode="Ignore" class="save__names">
                                <ui:Label text="NOVA_RUNNER" picking-mode="Ignore" class="save__pilot" />
                                <ui:Label text="GOOGLE" picking-mode="Ignore" class="save__via" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement picking-mode="Ignore" class="save__stats">
                            <ui:VisualElement picking-mode="Ignore" class="sstat">
                                <ui:Label text="LEVEL" picking-mode="Ignore" class="sstat__label" />
                                <ui:Label text="27" picking-mode="Ignore" class="sstat__val" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="sstat">
                                <ui:Label text="RANK" picking-mode="Ignore" class="sstat__label" />
                                <ui:Label text="PLATINUM II" picking-mode="Ignore" class="sstat__val" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="sstat">
                                <ui:Label text="PLAYTIME" picking-mode="Ignore" class="sstat__label" />
                                <ui:Label text="84H 40M" picking-mode="Ignore" class="sstat__val" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="sstat">
                                <ui:Label text="CREDITS" picking-mode="Ignore" class="sstat__label" />
                                <ui:Label text="128,450" picking-mode="Ignore" class="sstat__val" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="sstat">
                                <ui:Label text="VEHICLES" picking-mode="Ignore" class="sstat__label" />
                                <ui:Label text="4" picking-mode="Ignore" class="sstat__val" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="sstat">
                                <ui:Label text="LAST PLAYED" picking-mode="Ignore" class="sstat__label" />
                                <ui:Label text="2 DAYS AGO" picking-mode="Ignore" class="sstat__val" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Ignore" class="note-bad">
                    <ui:Label text="THIS CANNOT BE UNDONE. THE PROGRESS YOU DO NOT KEEP IS DELETED." picking-mode="Ignore" class="note-bad__text" />
