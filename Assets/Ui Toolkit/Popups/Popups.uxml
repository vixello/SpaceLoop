                <ui:VisualElement picking-mode="Ignore" class="dlg__row">
                    <ui:Button name="btn-conflict-cancel" class="btn btn-ghost dlg__btn accent-cyan">
                        <ui:VisualElement picking-mode="Ignore" class="sheen" />
                        <ui:Label text="CANCEL" picking-mode="Ignore" class="btn-ghost__label" />
                    </ui:Button>
                    <ui:Button name="btn-conflict-confirm" class="btn holdbtn accent-amber">
                        <ui:VisualElement picking-mode="Ignore" class="holdbtn__fill" style="width: 0%;" />
                        <ui:Label text="HOLD TO TRANSFER" picking-mode="Ignore" class="holdbtn__text" />
                        <ui:Label text="KEEP LINKED" picking-mode="Ignore" class="holdbtn__sub" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="popup-transfer" class="modal-layer hidden" style="display: none;">
            <ui:VisualElement picking-mode="Ignore" class="dlg accent-cyan">
                <ui:VisualElement picking-mode="Ignore" class="dlg__bar" />
                <ui:VisualElement picking-mode="Ignore" class="spin">
                    <ui:VisualElement picking-mode="Ignore" class="spin__arc" />
                </ui:VisualElement>
                <ui:Label text="DATA TRANSFER" picking-mode="Ignore" class="eyebrow eyebrow--accent dlg__center" />
                <ui:Label text="TRANSFERRING DATA" picking-mode="Ignore" class="dlg__title dlg__center" />
                <ui:VisualElement picking-mode="Ignore" class="tsteps">
                    <ui:VisualElement picking-mode="Ignore" class="tstep tstep--done">
                        <ui:VisualElement picking-mode="Ignore" class="tstep__dot">
                            <ui:VisualElement picking-mode="Ignore" class="check" />
                        </ui:VisualElement>
                        <ui:Label text="VERIFYING ACCOUNTS" picking-mode="Ignore" class="tstep__label" />
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="tstep tstep--active">
                        <ui:VisualElement picking-mode="Ignore" class="tstep__dot" />
                        <ui:Label text="UPLOADING PROGRESS" picking-mode="Ignore" class="tstep__label" />
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="tstep tstep--pending">
                        <ui:VisualElement picking-mode="Ignore" class="tstep__dot" />
                        <ui:Label text="MERGING PURCHASES" picking-mode="Ignore" class="tstep__label" />
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="tstep tstep--pending">
                        <ui:VisualElement picking-mode="Ignore" class="tstep__dot" />
                        <ui:Label text="FINISHING UP" picking-mode="Ignore" class="tstep__label" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Ignore" class="tbar">
                    <ui:VisualElement name="transfer-fill" picking-mode="Ignore" class="tbar__fill" style="width: 46%;" />
                </ui:VisualElement>
                <ui:Label text="DO NOT CLOSE THE GAME. THIS TAKES A FEW SECONDS." picking-mode="Ignore" class="dlg__note dlg__center" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="popup-transfer-done" class="modal-layer hidden" style="display: none;">
            <ui:VisualElement picking-mode="Ignore" class="dlg accent-green">
                <ui:VisualElement picking-mode="Ignore" class="dlg__bar" />
                <ui:VisualElement picking-mode="Ignore" class="dlg__head">
                    <ui:VisualElement picking-mode="Ignore" class="ico ico--ok">
                        <ui:VisualElement picking-mode="Ignore" class="ico__a" />
                        <ui:VisualElement picking-mode="Ignore" class="ico__b" />
                        <ui:VisualElement picking-mode="Ignore" class="ico__c" />
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="dlg__headtext">
                        <ui:Label text="DATA TRANSFER" picking-mode="Ignore" class="eyebrow eyebrow--accent" />
                        <ui:Label text="TRANSFER COMPLETE" picking-mode="Ignore" class="dlg__title" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="YOUR PROGRESS IS NOW SAVED TO YOUR LINKED GOOGLE ACCOUNT." picking-mode="Ignore" class="dlg__text" />
                <ui:VisualElement picking-mode="Ignore" class="breakdown">
                    <ui:VisualElement picking-mode="Ignore" class="brow">
                        <ui:Label text="ACCOUNT" picking-mode="Ignore" class="brow__label" />
                        <ui:VisualElement picking-mode="Ignore" class="spacer" />
                        <ui:Label text="NOVA_RUNNER" picking-mode="Ignore" class="brow__val" />
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="brow">
                        <ui:Label text="LEVEL" picking-mode="Ignore" class="brow__label" />
                        <ui:VisualElement picking-mode="Ignore" class="spacer" />
                        <ui:Label text="27" picking-mode="Ignore" class="brow__val" />
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="brow">
                        <ui:Label text="LINKED WITH" picking-mode="Ignore" class="brow__label" />
                        <ui:VisualElement picking-mode="Ignore" class="spacer" />
                        <ui:Label text="GOOGLE" picking-mode="Ignore" class="brow__val" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Ignore" class="dlg__row">
                    <ui:Button name="btn-transfer-done" class="btn btn-cta dlg__btn accent-green">
                        <ui:VisualElement picking-mode="Ignore" class="sheen" />
                        <ui:Label text="CONTINUE" picking-mode="Ignore" class="btn-cta__label" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="popup-error" class="modal-layer hidden" style="display: none;">
            <ui:VisualElement picking-mode="Ignore" class="dlg accent-red">
                <ui:VisualElement picking-mode="Ignore" class="dlg__bar" />
                <ui:VisualElement picking-mode="Ignore" class="dlg__head">
                    <ui:VisualElement picking-mode="Ignore" class="ico ico--warn">
                        <ui:VisualElement picking-mode="Ignore" class="ico__a" />
                        <ui:VisualElement picking-mode="Ignore" class="ico__b" />
                        <ui:VisualElement picking-mode="Ignore" class="ico__c" />
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="dlg__headtext">
                        <ui:Label text="ERROR" picking-mode="Ignore" class="eyebrow eyebrow--accent" />
                        <ui:Label text="SOMETHING WENT WRONG" name="error-title" picking-mode="Ignore" class="dlg__title" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="AN UNEXPECTED ERROR OCCURRED. PLEASE TRY AGAIN. IF IT KEEPS HAPPENING, CONTACT SUPPORT AND SHARE THE CODE BELOW." name="error-text" picking-mode="Ignore" class="dlg__text" />
                <ui:VisualElement picking-mode="Ignore" class="errcode">
                    <ui:VisualElement picking-mode="Ignore" class="errcode__main">
                        <ui:Label text="ERROR CODE" picking-mode="Ignore" class="eyebrow" />
                        <ui:Label text="ERR-4012" name="error-code" picking-mode="Ignore" class="errcode__val" />
                    </ui:VisualElement>
                    <ui:Button name="btn-copy-error" class="btn errcode__copy">
                        <ui:VisualElement picking-mode="Ignore" class="sheen" />
                        <ui:Label text="COPY DETAILS" picking-mode="Ignore" class="errcode__copy-text" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement name="error-details-box" picking-mode="Ignore" class="errdetails hidden">
                    <ui:Label text="Request: POST /v1/session  /  Status: 500  /  Trace: 7f3a-91c2-bb04  /  Build 1287" name="error-details" picking-mode="Ignore" class="errdetails__text" />
                </ui:VisualElement>
                <ui:Button name="btn-toggle-details" class="btn link">
                    <ui:Label text="SHOW DETAILS" picking-mode="Ignore" class="link__text" />
                </ui:Button>
                <ui:VisualElement picking-mode="Ignore" class="dlg__row">
                    <ui:Button name="btn-error-support" class="btn btn-ghost dlg__btn accent-cyan">
                        <ui:VisualElement picking-mode="Ignore" class="sheen" />
                        <ui:Label text="SUPPORT" picking-mode="Ignore" class="btn-ghost__label" />
                    </ui:Button>
                    <ui:Button name="btn-error-close" class="btn btn-ghost dlg__btn accent-red">
                        <ui:VisualElement picking-mode="Ignore" class="sheen" />
                        <ui:Label text="CLOSE" picking-mode="Ignore" class="btn-ghost__label" />
                    </ui:Button>
                    <ui:Button name="btn-error-retry" class="btn btn-cta dlg__btn accent-red">
                        <ui:VisualElement picking-mode="Ignore" class="sheen" />
                        <ui:Label text="RETRY" picking-mode="Ignore" class="btn-cta__label" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="popup-offline" class="modal-layer hidden" style="display: none;">
            <ui:VisualElement picking-mode="Ignore" class="dlg accent-amber">
                <ui:VisualElement picking-mode="Ignore" class="dlg__bar" />
                <ui:VisualElement picking-mode="Ignore" class="dlg__head">
                    <ui:VisualElement picking-mode="Ignore" class="ico ico--off">
                        <ui:VisualElement picking-mode="Ignore" class="ico__a" />
                        <ui:VisualElement picking-mode="Ignore" class="ico__b" />
                        <ui:VisualElement picking-mode="Ignore" class="ico__c" />
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="dlg__headtext">
                        <ui:Label text="NETWORK" picking-mode="Ignore" class="eyebrow eyebrow--accent" />
                        <ui:Label text="CONNECTION LOST" picking-mode="Ignore" class="dlg__title" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="WE CANNOT REACH THE SERVER. CHECK YOUR INTERNET CONNECTION. WE WILL KEEP TRYING." picking-mode="Ignore" class="dlg__text" />
                <ui:VisualElement picking-mode="Ignore" class="retry">
                    <ui:VisualElement picking-mode="Ignore" class="spin spin--sm">
                        <ui:VisualElement picking-mode="Ignore" class="spin__arc" />
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="retry__text">
                        <ui:Label text="RECONNECTING IN" picking-mode="Ignore" class="eyebrow" />
                        <ui:Label text="5" name="retry-count" picking-mode="Ignore" class="retry__num" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Ignore" class="dlg__row">
                    <ui:Button name="btn-offline-quit" class="btn btn-ghost dlg__btn accent-amber">
                        <ui:VisualElement picking-mode="Ignore" class="sheen" />
                        <ui:Label text="QUIT TO MENU" picking-mode="Ignore" class="btn-ghost__label" />
                    </ui:Button>
                    <ui:Button name="btn-offline-retry" class="btn btn-cta dlg__btn accent-amber">
                        <ui:VisualElement picking-mode="Ignore" class="sheen" />
                        <ui:Label text="RETRY NOW" picking-mode="Ignore" class="btn-cta__label" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="popup-update" class="modal-layer hidden" style="display: none;">
            <ui:VisualElement picking-mode="Ignore" class="dlg accent-cyan">
                <ui:VisualElement picking-mode="Ignore" class="dlg__bar" />
                <ui:VisualElement picking-mode="Ignore" class="dlg__head">
                    <ui:VisualElement picking-mode="Ignore" class="ico ico--up">
