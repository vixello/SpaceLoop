                        <ui:VisualElement picking-mode="Ignore" class="ico__b" />
                        <ui:VisualElement picking-mode="Ignore" class="ico__c" />
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="dlg__headtext">
                        <ui:Label text="LINK GOOGLE ACCOUNT" picking-mode="Ignore" class="eyebrow eyebrow--accent" />
                        <ui:Label text="DATA TRANSFER NEEDED" picking-mode="Ignore" class="dlg__title" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="THIS GOOGLE ACCOUNT ALREADY HAS PROGRESS. CHOOSE WHICH PROGRESS TO KEEP. THE OTHER ONE WILL BE REPLACED." picking-mode="Ignore" class="dlg__text" />
                <ui:VisualElement picking-mode="Ignore" class="saves">
                    <ui:Button name="save-device" class="btn save">
                        <ui:VisualElement picking-mode="Ignore" class="sheen" />
                        <ui:VisualElement picking-mode="Ignore" class="save__top">
                            <ui:Label text="THIS DEVICE" picking-mode="Ignore" class="tag" />
                            <ui:VisualElement picking-mode="Ignore" class="spacer" />
                            <ui:VisualElement picking-mode="Ignore" class="save__radio">
                                <ui:VisualElement picking-mode="Ignore" class="save__radio-dot" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement picking-mode="Ignore" class="save__who">
                            <ui:VisualElement picking-mode="Ignore" class="save__av" />
                            <ui:VisualElement picking-mode="Ignore" class="save__names">
                                <ui:Label text="GUEST_4821" picking-mode="Ignore" class="save__pilot" />
                                <ui:Label text="GUEST PROGRESS" picking-mode="Ignore" class="save__via" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement picking-mode="Ignore" class="save__stats">
                            <ui:VisualElement picking-mode="Ignore" class="sstat">
                                <ui:Label text="LEVEL" picking-mode="Ignore" class="sstat__label" />
                                <ui:Label text="3" picking-mode="Ignore" class="sstat__val" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="sstat">
