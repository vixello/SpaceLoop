/* =====================================================================
   GARAGE HUB  (requires Common.uss)
   Mode switch (Driver / Vehicle) toggles two panes: pane-driver and
   pane-vehicle. Toggle .page--hidden and .mode--active from C#.
   Pane accent: magenta for drivers, cyan for vehicles.
   Customization opens in its own screens (VehicleCustomization.uxml,
   DriverCustomization.uxml).
   ===================================================================== */

/* ---------------------------------------------------------------------
   1. VIEWFINDER FRAME (corner brackets around the 3D subject)
   --------------------------------------------------------------------- */
.viewfinder {
    position: absolute;
    left: 31%;
    right: 33%;
    top: 24%;
    bottom: 40%;
}

.vf {
    position: absolute;
    width: 44px;
    height: 44px;
    border-color: rgba(150, 200, 255, 0.40);
}

.vf--tl { left: 0;  top: 0;    border-left-width: 2px;  border-top-width: 2px; }
.vf--tr { right: 0; top: 0;    border-right-width: 2px; border-top-width: 2px; }
.vf--bl { left: 0;  bottom: 0; border-left-width: 2px;  border-bottom-width: 2px; }
.vf--br { right: 0; bottom: 0; border-right-width: 2px; border-bottom-width: 2px; }

/* ---------------------------------------------------------------------
   2. MODE SWITCH
   --------------------------------------------------------------------- */
.mode-row {
    flex-direction: row;
    align-items: center;
    height: 70px;
    margin-top: 18px;
    flex-shrink: 0;
}

.mode {
    width: 360px;
    height: 100%;
    padding: 0 28px 0 28px;
    justify-content: center;
    background-color: var(--c-surface);
}

.mode:hover { background-color: var(--c-surface-hi); scale: 1.03 1.03; }

.mode__eyebrow {
    font-size: 12px;
    letter-spacing: 5px;
    color: var(--accent);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.mode__name {
    font-size: 28px;
    letter-spacing: 4px;
    color: var(--c-text-2);
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
    transition-property: color;
    transition-duration: 0.18s;
}

.mode__bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 4px;
    background-color: var(--accent);
    scale: 0 1;
    transform-origin: 0% 50%;
    transition-property: scale;
    transition-duration: 0.25s;
}

.mode:hover .mode__bar { scale: 0.4 1; }
.mode:hover .mode__name { color: var(--c-text); }

.mode--active, .mode--active:hover { background-color: var(--accent-soft); }
.mode--active .mode__name { color: var(--c-text); }
.mode--active .mode__bar, .mode--active:hover .mode__bar { scale: 1 1; }

.mode__sep {
    width: 6px;
    height: 90px;
    margin: 0 14px 0 14px;
    rotate: 24deg;
    background-color: var(--c-hair-strong);
}

/* ---------------------------------------------------------------------
   3. BODY: LEFT IDENTITY / RIGHT LOADOUT
   --------------------------------------------------------------------- */
.body {
    flex-direction: row;
    flex-grow: 1;
    margin-top: 20px;
}

.col-left {
    width: 25%;
    min-width: 400px;
    max-width: 500px;
}

.col-right {
    width: 31%;
    min-width: 500px;
    max-width: 620px;
    padding: 18px 20px 20px 20px;
    background-color: var(--c-surface);
    border-top-width: 2px;
    border-color: var(--accent);
}

.car-title {
    margin-top: 2px;
    font-size: 58px;
    letter-spacing: 6px;
    color: var(--c-text);
    white-space: nowrap;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

.car-meta {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.car-meta__text {
    margin-left: 14px;
    font-size: 12px;
    letter-spacing: 4px;
    color: var(--c-text-2);
    -unity-font-style: bold;
}

/* Performance index */
.pi {
    flex-direction: row;
    align-items: center;
    margin-top: 18px;
    padding: 14px 18px 14px 14px;
    background-color: var(--c-surface);
    border-left-width: 4px;
    border-color: var(--accent);
}

.pi__badge {
    width: 66px;
    height: 66px;
    margin-right: 18px;
    align-items: center;
    justify-content: center;
    background-color: var(--accent);
}

.pi__class {
    font-size: 42px;
    color: var(--c-ink);
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-center;
}

.pi__row { flex-direction: row; align-items: flex-end; }

.pi__value {
    font-size: 50px;
    letter-spacing: 3px;
    color: var(--c-text);
    -unity-font-style: bold;
    -unity-text-align: lower-left;
}

.pi__delta {
    margin: 0 0 9px 14px;
    font-size: 22px;
    letter-spacing: 2px;
    color: var(--c-good);
    -unity-font-style: bold;
}

.pi__ring {
    width: 58px;
    height: 58px;
    border-radius: 29px;
    border-width: 5px;
    border-color: var(--c-fill-mid);
}

.pi__ring-fill {
    position: absolute;
    left: -5px;
    top: -5px;
    right: -5px;
    bottom: -5px;
    border-radius: 29px;
    border-width: 5px;
    border-color: var(--accent);
    border-left-color: rgba(0, 0, 0, 0);
}

/* Segmented stat bars */
.stats {
    margin-top: 14px;
    padding: 6px 18px 14px 18px;
    background-color: var(--c-surface);
}

.stat { margin-top: 14px; }

.stat__head { flex-direction: row; align-items: center; }

.stat__label {
    font-size: 14px;
    letter-spacing: 4px;
    color: var(--c-text-2);
    -unity-font-style: bold;
}

.stat__value {
    min-width: 40px;
    font-size: 20px;
    color: var(--c-text);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.stat__delta {
    margin-right: 10px;
    font-size: 16px;
    color: var(--c-good);
    -unity-font-style: bold;
}

.stat__track {
    height: 8px;
    margin-top: 6px;
    background-color: var(--c-fill-mid);
}

.stat__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: var(--accent);
}

.stat__delta-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    background-color: var(--c-good);
}

/* Thin dark dividers carve the bar into 10 segments */
.stat__tick {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: rgb(7, 11, 22);
}

/* ---------------------------------------------------------------------
   4. DRIVER LEFT COLUMN EXTRAS
   --------------------------------------------------------------------- */
.mastery {
    margin-top: 14px;
    padding: 14px 18px 16px 18px;
    background-color: var(--c-surface);
}

.mastery__head { flex-direction: row; align-items: center; }

.mastery__num {
    font-size: 15px;
    letter-spacing: 2px;
    color: var(--c-text);
    -unity-font-style: bold;
}

.mastery__bar {
    height: 8px;
    margin-top: 10px;
    background-color: var(--c-fill-mid);
}

.mastery__fill { height: 100%; background-color: var(--accent); }

.sig {
    flex-direction: row;
    align-items: center;
    height: 92px;
    margin-top: 12px;
    padding: 0 20px 0 0;
    background-color: var(--c-surface);
}

.sig:hover { background-color: var(--c-surface-hi); scale: 1.03 1.03; transform-origin: 0% 50%; }

.sig__thumb {
    width: 130px;
    height: 100%;
    margin-right: 18px;
    overflow: hidden;
    background-color: rgba(0, 229, 255, 0.14);
    -unity-background-scale-mode: scale-and-crop;
}

.sig__text { flex-grow: 1; }

.sig__name {
    font-size: 24px;
    letter-spacing: 3px;
    color: var(--c-text);
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

.sig__state {
    font-size: 12px;
    letter-spacing: 4px;
    color: var(--c-good);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.abil {
    margin-top: 12px;
    padding: 14px 18px 14px 18px;
    background-color: var(--c-surface);
    border-left-width: 3px;
    border-color: var(--accent);
}

.abil__text {
    margin-top: 6px;
    font-size: 14px;
    letter-spacing: 2px;
    color: var(--c-text-2);
    white-space: normal;
    -unity-text-align: upper-left;
}

/* ---------------------------------------------------------------------
   5. LOADOUT SLOTS (right) - each opens the customization screen
   --------------------------------------------------------------------- */
.slots-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.slot {
    flex-direction: row;
    align-items: center;
    height: 64px;
    margin-bottom: 8px;
    padding: 0 22px 0 22px;
    background-color: var(--c-fill-soft);
}

.slot:hover { background-color: var(--c-fill-mid); translate: -6px 0; }

.slot__ico { margin-right: 20px; }

.slot__text { flex-grow: 1; flex-shrink: 1; }

.slot__label {
    font-size: 12px;
    letter-spacing: 4px;
    color: var(--c-text-3);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.slot__value {
    font-size: 20px;
    letter-spacing: 3px;
    color: var(--c-text);
    white-space: nowrap;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

.slot__chip {
    width: 10px;
    height: 30px;
    margin-right: 22px;
    rotate: 16deg;
}

.customize-cta {
    width: 100%;
    height: 84px;
    margin-top: 10px;
}

.customize-cta .btn-cta__label { font-size: 28px; letter-spacing: 8px; }

/* ---------------------------------------------------------------------
   6. BOTTOM: CAROUSEL + ACTIONS
   --------------------------------------------------------------------- */
.bottom {
    flex-direction: row;
    align-items: flex-end;
    flex-shrink: 0;
    margin-top: 14px;
}

.carousel-wrap {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 28px;
}

.carousel-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.carousel-count {
    margin-left: 18px;
    font-size: 12px;
    letter-spacing: 4px;
    color: var(--c-text-2);
    -unity-font-style: bold;
}

.carousel-head .chips { margin-top: 8px; }
.carousel-head .chip { height: 36px; margin-bottom: 0; }

.carousel { height: 196px; }

.carousel .unity-scroll-view__content-container {
    flex-direction: row;
    align-items: flex-end;
    padding-top: 12px;
}

/* Vehicle card with preview image */
.car {
    width: 300px;
    height: 176px;
    margin-right: 12px;
    background-color: var(--c-fill-soft);
    border-width: 1px;
    border-color: var(--c-hair);
}

.car:focus { border-color: var(--c-hair); }

.car:hover {
    background-color: var(--c-fill-mid);
    border-color: var(--rarity);
    scale: 1.05 1.05;
    translate: 0 -6px;
}

.car--active, .car--active:focus { background-color: var(--rarity-soft); border-color: var(--accent); border-width: 2px; }

/* IMAGE SLOT: assign the vehicle preview texture here */
.car__preview {
    height: 114px;
    overflow: hidden;
    background-color: var(--rarity-soft);
    -unity-background-scale-mode: scale-and-crop;
}

.car__slash {
    position: absolute;
    right: 22%;
    top: -50%;
    width: 26px;
    height: 220%;
    rotate: 24deg;
    background-color: var(--c-fill-soft);
    transition-property: translate;
    transition-duration: 0.3s;
}

.car:hover .car__slash, .drv:hover .car__slash { translate: -22px 0; }

.car__veil {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 114px;
    background-color: rgba(3, 6, 13, 0.62);
}

.car__lock {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 114px;
    align-items: center;
    justify-content: center;
}

.car__bar {
    height: 3px;
    background-color: var(--rarity);
}

.car__sig {
    position: absolute;
    left: 8px;
    top: 8px;
    background-color: var(--accent);
}

.car__info { padding: 8px 14px 8px 16px; }

.car__name {
    font-size: 21px;
    letter-spacing: 2px;
    color: var(--c-text);
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

.car__state {
    font-size: 12px;
    letter-spacing: 4px;
    color: var(--c-text-3);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.car__state--on { color: var(--accent); }

.car__reqrow { flex-direction: row; align-items: center; }

.car__req {
    font-size: 12px;
    letter-spacing: 3px;
    color: rgb(255, 190, 0);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

/* Locked vehicles stay visible but dimmed; hover reveals them */
.car--locked .car__name { color: var(--c-text-2); }
.car--locked:hover { opacity: 1; }

/* Driver cards */
.carousel--drivers .unity-scroll-view__content-container { align-items: flex-end; }

.drv {
    width: 210px;
    height: 176px;
    margin-right: 12px;
    background-color: var(--c-fill-soft);
    border-width: 1px;
    border-color: var(--c-hair);
}

.drv:focus { border-color: var(--c-hair); }
.drv:hover { background-color: var(--c-fill-mid); border-color: var(--rarity); scale: 1.05 1.05; translate: 0 -6px; }
.drv--active, .drv--active:focus { background-color: var(--rarity-soft); border-color: var(--accent); border-width: 2px; }

/* IMAGE SLOT: driver portrait */
.drv__portrait {
    height: 100px;
    overflow: hidden;
    background-color: var(--rarity-soft);
    -unity-background-scale-mode: scale-and-crop;
}

.drv .car__veil, .drv .car__lock { height: 100px; }

.drv__info { padding: 6px 12px 6px 14px; }

.drv__role {
    font-size: 11px;
    letter-spacing: 4px;
    color: var(--accent);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.drv .car__name { font-size: 19px; }

.actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.actions__main { min-width: 320px; height: 84px; }
