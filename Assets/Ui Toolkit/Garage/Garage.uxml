                            <ui:VisualElement class="sheen" picking-mode="Ignore" />
                            <ui:Label class="btn-cta__label" text="EQUIP DRIVER" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button class="btn btn-cta actions__main accent-amber hidden" name="btn-unlock-driver">
                            <ui:VisualElement class="sheen" picking-mode="Ignore" />
                            <ui:Label class="btn-cta__label" text="UNLOCK IN SHOP" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
