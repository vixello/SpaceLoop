<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/Ui Toolkit/Common/Common.uss" />
    <ui:Style src="project://database/Assets/Ui Toolkit/Garage/Garage.uss" />
    <ui:Template name="Scrims" src="project://database/Assets/Ui Toolkit/Common/Components/Scrims.uxml" />
    <ui:Template name="ScreenHeader" src="project://database/Assets/Ui Toolkit/Common/Components/ScreenHeader.uxml" />

    <!-- 3D garage scene renders behind. Mode buttons switch the two panes (driver or vehicle). -->
    <ui:VisualElement class="screen" name="root" picking-mode="Position">
        <ui:VisualElement class="layer drag-zone" name="rotate-drag-zone" picking-mode="Position" />
        <ui:Instance class="layer" template="Scrims" picking-mode="Ignore" />
        <ui:VisualElement class="viewfinder" picking-mode="Ignore">
            <ui:VisualElement class="vf vf--tl" picking-mode="Ignore" />
            <ui:VisualElement class="vf vf--tr" picking-mode="Ignore" />
            <ui:VisualElement class="vf vf--bl" picking-mode="Ignore" />
            <ui:VisualElement class="vf vf--br" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="layer hud" name="hud" picking-mode="Ignore">
            <ui:Instance template="ScreenHeader" name="screen-header" picking-mode="Ignore">
                <ui:AttributeOverrides element-name="screen-eyebrow" text="YOUR COLLECTION  /  VEHICLES 4 OF 8  /  DRIVERS 3 OF 6" />
                <ui:AttributeOverrides element-name="screen-title" text="GARAGE" />
            </ui:Instance>
            <ui:VisualElement class="mode-row" picking-mode="Ignore">
                <ui:Button class="btn mode accent-magenta" name="mode-driver-btn">
                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                    <ui:VisualElement class="mode__bar" picking-mode="Ignore" />
                    <ui:Label class="mode__eyebrow" text="DRIVER" picking-mode="Ignore" />
                    <ui:Label class="mode__name" text="KAI NOVA" picking-mode="Ignore" />
                </ui:Button>
                <ui:VisualElement class="mode__sep" picking-mode="Ignore" />
                <ui:Button class="btn mode accent-cyan mode--active" name="mode-vehicle-btn">
                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                    <ui:VisualElement class="mode__bar" picking-mode="Ignore" />
                    <ui:Label class="mode__eyebrow" text="VEHICLE" picking-mode="Ignore" />
                    <ui:Label class="mode__name" text="ZEPHYR GT-X" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement class="page accent-cyan" name="pane-vehicle" picking-mode="Ignore">
                <ui:VisualElement class="body" picking-mode="Ignore">
                    <ui:VisualElement class="col-left" picking-mode="Ignore">
                        <ui:Label class="eyebrow eyebrow--accent" text="CLASS S  /  HYPERCAR" picking-mode="Ignore" />
                        <ui:Label class="car-title" text="ZEPHYR GT-X" name="car-name" picking-mode="Ignore" />
                        <ui:VisualElement class="car-meta" picking-mode="Ignore">
                            <ui:Label class="tag tag--accent" text="KAI NOVA SIGNATURE" picking-mode="Ignore" />
                            <ui:Label class="car-meta__text" text="OWNED  /  EQUIPPED" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="pi" picking-mode="Ignore">
                            <ui:VisualElement class="pi__badge" picking-mode="Ignore">
                                <ui:Label class="pi__class" text="S" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="pi__text" picking-mode="Ignore">
                                <ui:Label class="eyebrow" text="PERFORMANCE INDEX" picking-mode="Ignore" />
                                <ui:VisualElement class="pi__row" picking-mode="Ignore">
                                    <ui:Label class="pi__value" text="842" name="pi-value" picking-mode="Ignore" />
                                    <ui:Label class="pi__delta" text="+36" name="pi-delta" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="spacer" picking-mode="Ignore" />
                            <ui:VisualElement class="pi__ring" picking-mode="Ignore">
                                <ui:VisualElement class="pi__ring-fill" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="stats" picking-mode="Ignore">
                            <ui:VisualElement class="stat" picking-mode="Ignore">
                                <ui:VisualElement class="stat__head" picking-mode="Ignore">
                                    <ui:Label class="stat__label" text="SPEED" picking-mode="Ignore" />
                                    <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                    <ui:Label class="stat__delta" text="+8" picking-mode="Ignore" />
                                    <ui:Label class="stat__value" text="74" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:VisualElement class="stat__track" picking-mode="Ignore">
                                    <ui:VisualElement class="stat__fill" style="width: 74%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__delta-fill" style="left: 74%; width: 8%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 10%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 20%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 30%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 40%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 50%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 60%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 70%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 80%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 90%;" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="stat" picking-mode="Ignore">
                                <ui:VisualElement class="stat__head" picking-mode="Ignore">
                                    <ui:Label class="stat__label" text="ACCELERATION" picking-mode="Ignore" />
                                    <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                    <ui:Label class="stat__delta" text="" picking-mode="Ignore" />
                                    <ui:Label class="stat__value" text="68" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:VisualElement class="stat__track" picking-mode="Ignore">
                                    <ui:VisualElement class="stat__fill" style="width: 68%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 10%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 20%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 30%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 40%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 50%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 60%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 70%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 80%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 90%;" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="stat" picking-mode="Ignore">
                                <ui:VisualElement class="stat__head" picking-mode="Ignore">
                                    <ui:Label class="stat__label" text="HANDLING" picking-mode="Ignore" />
                                    <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                    <ui:Label class="stat__delta" text="+5" picking-mode="Ignore" />
                                    <ui:Label class="stat__value" text="81" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:VisualElement class="stat__track" picking-mode="Ignore">
                                    <ui:VisualElement class="stat__fill" style="width: 81%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__delta-fill" style="left: 81%; width: 5%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 10%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 20%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 30%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 40%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 50%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 60%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 70%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 80%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 90%;" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="stat" picking-mode="Ignore">
                                <ui:VisualElement class="stat__head" picking-mode="Ignore">
                                    <ui:Label class="stat__label" text="BOOST" picking-mode="Ignore" />
                                    <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                    <ui:Label class="stat__delta" text="" picking-mode="Ignore" />
                                    <ui:Label class="stat__value" text="59" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:VisualElement class="stat__track" picking-mode="Ignore">
                                    <ui:VisualElement class="stat__fill" style="width: 59%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 10%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 20%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 30%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 40%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 50%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 60%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 70%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 80%;" picking-mode="Ignore" />
                                    <ui:VisualElement class="stat__tick" style="left: 90%;" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="spacer" picking-mode="Ignore" />
                    <ui:VisualElement class="col-right" picking-mode="Ignore">
                        <ui:VisualElement class="slots-head" picking-mode="Ignore">
                            <ui:Label class="eyebrow" text="EQUIPPED PARTS" picking-mode="Ignore" />
                            <ui:VisualElement class="spacer" picking-mode="Ignore" />
                            <ui:Label class="eyebrow eyebrow--accent" text="6 SLOTS" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="slots" picking-mode="Ignore">
                            <ui:ScrollView name="slots-carousel" mode="Vertical" touch-scroll-type="Elastic" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">

                                <ui:Button class="btn slot" name="slot-paint">
                                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                    <ui:VisualElement class="edge" picking-mode="Ignore" />
                                    <ui:VisualElement class="slot__ico" picking-mode="Ignore">
                                        <ui:VisualElement class="glyph glyph--paint" picking-mode="Ignore">
                                            <ui:VisualElement class="g g-a" picking-mode="Ignore" />
                                            <ui:VisualElement class="g g-b" picking-mode="Ignore" />
                                            <ui:VisualElement class="g g-c" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="slot__text" picking-mode="Ignore">
                                        <ui:Label class="slot__label" text="PAINT" picking-mode="Ignore" />
                                        <ui:Label class="slot__value" text="VOID BLUE  /  METALLIC" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="slot__chip" style="background-color: rgb(20,40,120);" picking-mode="Ignore" />
                                    <ui:VisualElement class="chevron" picking-mode="Ignore" />
                                </ui:Button>
                                <ui:Button class="btn slot" name="slot-wrap">
                                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                    <ui:VisualElement class="edge" picking-mode="Ignore" />
                                    <ui:VisualElement class="slot__ico" picking-mode="Ignore">
                                        <ui:VisualElement class="glyph glyph--wrap" picking-mode="Ignore">
                                            <ui:VisualElement class="g g-a" picking-mode="Ignore" />
                                            <ui:VisualElement class="g g-b" picking-mode="Ignore" />
                                            <ui:VisualElement class="g g-c" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="slot__text" picking-mode="Ignore">
                                        <ui:Label class="slot__label" text="WRAP" picking-mode="Ignore" />
                                        <ui:Label class="slot__value" text="CARBON WEAVE" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="slot__chip" style="background-color: rgb(60,70,90);" picking-mode="Ignore" />
                                    <ui:VisualElement class="chevron" picking-mode="Ignore" />
                                </ui:Button>
                                <ui:Button class="btn slot" name="slot-exhaust">
                                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                    <ui:VisualElement class="edge" picking-mode="Ignore" />
                                    <ui:VisualElement class="slot__ico" picking-mode="Ignore">
                                        <ui:VisualElement class="glyph glyph--exhaust" picking-mode="Ignore">
                                            <ui:VisualElement class="g g-a" picking-mode="Ignore" />
                                            <ui:VisualElement class="g g-b" picking-mode="Ignore" />
                                            <ui:VisualElement class="g g-c" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="slot__text" picking-mode="Ignore">
                                        <ui:Label class="slot__label" text="EXHAUST" picking-mode="Ignore" />
                                        <ui:Label class="slot__value" text="PLASMA CYAN" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="slot__chip" style="background-color: rgb(0,229,255);" picking-mode="Ignore" />
                                    <ui:VisualElement class="chevron" picking-mode="Ignore" />
                                </ui:Button>
                                <ui:Button class="btn slot" name="slot-trail">
                                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                    <ui:VisualElement class="edge" picking-mode="Ignore" />
                                    <ui:VisualElement class="slot__ico" picking-mode="Ignore">
                                        <ui:VisualElement class="glyph glyph--trail" picking-mode="Ignore">
                                            <ui:VisualElement class="g g-a" picking-mode="Ignore" />
                                            <ui:VisualElement class="g g-b" picking-mode="Ignore" />
                                            <ui:VisualElement class="g g-c" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="slot__text" picking-mode="Ignore">
                                        <ui:Label class="slot__label" text="ENERGY TRAIL" picking-mode="Ignore" />
                                        <ui:Label class="slot__value" text="STREAK" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="slot__chip" style="background-color: rgb(176,96,255);" picking-mode="Ignore" />
                                    <ui:VisualElement class="chevron" picking-mode="Ignore" />
                                </ui:Button>
                                <ui:Button class="btn slot" name="slot-glow">
                                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                    <ui:VisualElement class="edge" picking-mode="Ignore" />
                                    <ui:VisualElement class="slot__ico" picking-mode="Ignore">
                                        <ui:VisualElement class="glyph glyph--glow" picking-mode="Ignore">
                                            <ui:VisualElement class="g g-a" picking-mode="Ignore" />
                                            <ui:VisualElement class="g g-b" picking-mode="Ignore" />
                                            <ui:VisualElement class="g g-c" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="slot__text" picking-mode="Ignore">
                                        <ui:Label class="slot__label" text="UNDERGLOW" picking-mode="Ignore" />
                                        <ui:Label class="slot__value" text="NEON PINK" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="slot__chip" style="background-color: rgb(255,46,176);" picking-mode="Ignore" />
                                    <ui:VisualElement class="chevron" picking-mode="Ignore" />
                                </ui:Button>
                                <ui:Button class="btn slot" name="slot-aero">
                                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                    <ui:VisualElement class="edge" picking-mode="Ignore" />
                                    <ui:VisualElement class="slot__ico" picking-mode="Ignore">
                                        <ui:VisualElement class="glyph glyph--aero" picking-mode="Ignore">
                                            <ui:VisualElement class="g g-a" picking-mode="Ignore" />
                                            <ui:VisualElement class="g g-b" picking-mode="Ignore" />
                                            <ui:VisualElement class="g g-c" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="slot__text" picking-mode="Ignore">
                                        <ui:Label class="slot__label" text="AERO KIT" picking-mode="Ignore" />
                                        <ui:Label class="slot__value" text="DELTA WING" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="slot__chip" style="background-color: rgb(236,244,255);" picking-mode="Ignore" />
                                    <ui:VisualElement class="chevron" picking-mode="Ignore" />
                                </ui:Button>
                            </ui:ScrollView>

                        </ui:VisualElement>
                        <ui:Button class="btn btn-cta customize-cta" name="btn-customize-vehicle">
                            <ui:VisualElement class="sheen" picking-mode="Ignore" />
                            <ui:Label class="btn-cta__label" text="CUSTOMIZE VEHICLE" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="bottom" picking-mode="Ignore">
                    <ui:VisualElement class="carousel-wrap" picking-mode="Ignore">
                        <ui:VisualElement class="carousel-head" picking-mode="Ignore">
                            <ui:Label class="eyebrow" text="VEHICLES" picking-mode="Ignore" />
                            <ui:Label class="carousel-count" text="4 OWNED   /   4 LOCKED" picking-mode="Ignore" />
                            <ui:VisualElement class="spacer" picking-mode="Ignore" />
                            <ui:VisualElement class="chips" picking-mode="Ignore">
                                <ui:Button class="btn chip chip--active">
                                    <ui:Label class="chip__label" text="ALL" picking-mode="Ignore" />
                                </ui:Button>
                                <ui:Button class="btn chip">
                                    <ui:Label class="chip__label" text="OWNED" picking-mode="Ignore" />
                                </ui:Button>
                                <ui:Button class="btn chip">
                                    <ui:Label class="chip__label" text="LOCKED" picking-mode="Ignore" />
                                </ui:Button>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <!-- Car preview images: set background-image on each .car__preview (name car-preview-N) from C# or USS. -->
                        <ui:ScrollView class="carousel" name="car-carousel" mode="Horizontal" touch-scroll-type="Elastic" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                            <ui:Button class="btn car rarity-epic car--active" name="car-0">
                                <ui:VisualElement class="car__preview" name="car-preview-0" picking-mode="Ignore">
                                    <ui:VisualElement class="car__slash" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:VisualElement class="car__bar" picking-mode="Ignore" />
                                <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                <ui:Label class="tag car__sig" text="KAI SIGNATURE" picking-mode="Ignore" />
                                <ui:VisualElement class="car__info" picking-mode="Ignore">
                                    <ui:Label class="car__name" text="ZEPHYR GT-X" picking-mode="Ignore" />
                                    <ui:Label class="car__state car__state--on" text="EQUIPPED" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Button class="btn car rarity-rare" name="car-1">
                                <ui:VisualElement class="car__preview" name="car-preview-1" picking-mode="Ignore">
                                    <ui:VisualElement class="car__slash" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:VisualElement class="car__bar" picking-mode="Ignore" />
                                <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                <ui:VisualElement class="car__info" picking-mode="Ignore">
                                    <ui:Label class="car__name" text="VANTA R9" picking-mode="Ignore" />
                                    <ui:Label class="car__state" text="OWNED" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Button class="btn car rarity-rare" name="car-2">
                                <ui:VisualElement class="car__preview" name="car-preview-2" picking-mode="Ignore">
                                    <ui:VisualElement class="car__slash" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:VisualElement class="car__bar" picking-mode="Ignore" />
                                <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                <ui:Label class="tag car__sig" text="DAX SIGNATURE" picking-mode="Ignore" />
                                <ui:VisualElement class="car__info" picking-mode="Ignore">
                                    <ui:Label class="car__name" text="HELIX 88" picking-mode="Ignore" />
                                    <ui:Label class="car__state" text="OWNED" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Button class="btn car rarity-common" name="car-3">
                                <ui:VisualElement class="car__preview" name="car-preview-3" picking-mode="Ignore">
                                    <ui:VisualElement class="car__slash" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:VisualElement class="car__bar" picking-mode="Ignore" />
                                <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                <ui:VisualElement class="car__info" picking-mode="Ignore">
                                    <ui:Label class="car__name" text="NOMAD LX" picking-mode="Ignore" />
                                    <ui:Label class="car__state" text="OWNED" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Button class="btn car rarity-legendary car--locked" name="car-4">
                                <ui:VisualElement class="car__preview" name="car-preview-4" picking-mode="Ignore">
                                    <ui:VisualElement class="car__slash" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:VisualElement class="car__veil" picking-mode="Ignore" />
                                <ui:VisualElement class="car__lock" picking-mode="Ignore">
                                    <ui:VisualElement class="lock" picking-mode="Ignore">
                                        <ui:VisualElement class="lock__shackle" picking-mode="Ignore" />
                                        <ui:VisualElement class="lock__body" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="car__bar" picking-mode="Ignore" />
                                <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                <ui:Label class="tag car__sig" text="MIRA SIGNATURE" picking-mode="Ignore" />
                                <ui:VisualElement class="car__info" picking-mode="Ignore">
                                    <ui:Label class="car__name" text="OBSIDIAN KING" picking-mode="Ignore" />
                                    <ui:VisualElement class="car__reqrow" picking-mode="Ignore">
                                        <ui:VisualElement class="lock lock--sm" picking-mode="Ignore">
                                            <ui:VisualElement class="lock__shackle" picking-mode="Ignore" />
                                            <ui:VisualElement class="lock__body" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                        <ui:Label class="car__req" text="UNLOCK MIRA OR 3,200" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Button class="btn car rarity-legendary car--locked" name="car-5">
                                <ui:VisualElement class="car__preview" name="car-preview-5" picking-mode="Ignore">
                                    <ui:VisualElement class="car__slash" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:VisualElement class="car__veil" picking-mode="Ignore" />
                                <ui:VisualElement class="car__lock" picking-mode="Ignore">
                                    <ui:VisualElement class="lock" picking-mode="Ignore">
                                        <ui:VisualElement class="lock__shackle" picking-mode="Ignore" />
                                        <ui:VisualElement class="lock__body" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="car__bar" picking-mode="Ignore" />
                                <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                <ui:Label class="tag car__sig" text="ZERO-7 SIGNATURE" picking-mode="Ignore" />
                                <ui:VisualElement class="car__info" picking-mode="Ignore">
                                    <ui:Label class="car__name" text="SPECTRE ONE" picking-mode="Ignore" />
                                    <ui:VisualElement class="car__reqrow" picking-mode="Ignore">
                                        <ui:VisualElement class="lock lock--sm" picking-mode="Ignore">
                                            <ui:VisualElement class="lock__shackle" picking-mode="Ignore" />
                                            <ui:VisualElement class="lock__body" picking-mode="Ignore" />
                                        </ui:VisualElement>
