                                </ui:VisualElement>
                                <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                <ui:VisualElement class="tile__info" picking-mode="Ignore">
                                    <ui:Label class="tile__name" text="HALO" picking-mode="Ignore" />
                                    <ui:Label class="tile__state" text="OWNED" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Button class="btn tile rarity-epic tile--tall tile--locked">
                                <ui:VisualElement class="tile__bar" picking-mode="Ignore" />
                                <ui:VisualElement class="tile__art" picking-mode="Ignore">
                                    <ui:VisualElement class="tile__glyph" picking-mode="Ignore">
                                        <ui:VisualElement class="glyph glyph--helmet" picking-mode="Ignore">
                                            <ui:VisualElement class="g g-a" picking-mode="Ignore" />
                                            <ui:VisualElement class="g g-b" picking-mode="Ignore" />
                                            <ui:VisualElement class="g g-c" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="tile__veil" picking-mode="Ignore" />
                                    <ui:VisualElement class="tile__lock" picking-mode="Ignore">
                                        <ui:VisualElement class="lock" picking-mode="Ignore">
                                            <ui:VisualElement class="lock__shackle" picking-mode="Ignore" />
                                            <ui:VisualElement class="lock__body" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                <ui:VisualElement class="tile__info" picking-mode="Ignore">
                                    <ui:Label class="tile__name" text="SKULL" picking-mode="Ignore" />
                                    <ui:VisualElement class="tile__reqrow" picking-mode="Ignore">
                                        <ui:VisualElement class="lock lock--sm" picking-mode="Ignore">
