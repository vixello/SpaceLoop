<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/Ui Toolkit/Common/Common.uss" />
    <ui:Style src="project://database/Assets/Ui Toolkit/Common/Customize.uss" />
    <ui:Style src="project://database/Assets/Ui Toolkit/Garage/VehicleCustomization.uss" />
    <ui:Template name="Scrims" src="project://database/Assets/Ui Toolkit/Common/Components/Scrims.uxml" />
    <ui:Template name="ScreenHeader" src="project://database/Assets/Ui Toolkit/Common/Components/ScreenHeader.uxml" />

    <!-- Separate customization view. Category buttons toggle which page in the bottom strip is visible. -->
    <ui:VisualElement class="screen" name="root" picking-mode="Position">
        <ui:VisualElement class="layer drag-zone" name="rotate-drag-zone" picking-mode="Position" />
        <ui:Instance class="layer" template="Scrims" picking-mode="Ignore" />
        <ui:VisualElement class="layer hud" name="hud" picking-mode="Ignore">
            <ui:Instance template="ScreenHeader" name="screen-header" picking-mode="Ignore">
                <ui:AttributeOverrides element-name="screen-eyebrow" text="ZEPHYR GT-X  /  8 PARTS UNLOCKED OF 42" />
                <ui:AttributeOverrides element-name="screen-title" text="CUSTOMIZE" />
            </ui:Instance>
            <ui:VisualElement class="cz-body" picking-mode="Ignore">
                <ui:VisualElement class="cz-rail accent-cyan" picking-mode="Ignore">
                    <ui:Button class="btn cat cat--active" name="cat-paint">
                        <ui:VisualElement class="sheen" picking-mode="Ignore" />
                        <ui:VisualElement class="edge" picking-mode="Ignore" />
                        <ui:VisualElement class="glyph glyph--paint" picking-mode="Ignore">
                            <ui:VisualElement class="g g-a" picking-mode="Ignore" />
                            <ui:VisualElement class="g g-b" picking-mode="Ignore" />
                            <ui:VisualElement class="g g-c" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label class="cat__label" text="PAINT" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button class="btn cat" name="cat-wrap">
                        <ui:VisualElement class="sheen" picking-mode="Ignore" />
                        <ui:VisualElement class="edge" picking-mode="Ignore" />
                        <ui:VisualElement class="glyph glyph--wrap" picking-mode="Ignore">
                            <ui:VisualElement class="g g-a" picking-mode="Ignore" />
                            <ui:VisualElement class="g g-b" picking-mode="Ignore" />
                            <ui:VisualElement class="g g-c" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label class="cat__label" text="WRAP" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button class="btn cat" name="cat-exhaust">
                        <ui:VisualElement class="sheen" picking-mode="Ignore" />
                        <ui:VisualElement class="edge" picking-mode="Ignore" />
                        <ui:VisualElement class="glyph glyph--exhaust" picking-mode="Ignore">
                            <ui:VisualElement class="g g-a" picking-mode="Ignore" />
                            <ui:VisualElement class="g g-b" picking-mode="Ignore" />
                            <ui:VisualElement class="g g-c" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label class="cat__label" text="EXHAUST" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button class="btn cat" name="cat-trail">
                        <ui:VisualElement class="sheen" picking-mode="Ignore" />
                        <ui:VisualElement class="edge" picking-mode="Ignore" />
                        <ui:VisualElement class="glyph glyph--trail" picking-mode="Ignore">
                            <ui:VisualElement class="g g-a" picking-mode="Ignore" />
                            <ui:VisualElement class="g g-b" picking-mode="Ignore" />
                            <ui:VisualElement class="g g-c" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label class="cat__label" text="TRAIL" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button class="btn cat" name="cat-glow">
                        <ui:VisualElement class="sheen" picking-mode="Ignore" />
                        <ui:VisualElement class="edge" picking-mode="Ignore" />
                        <ui:VisualElement class="glyph glyph--glow" picking-mode="Ignore">
                            <ui:VisualElement class="g g-a" picking-mode="Ignore" />
                            <ui:VisualElement class="g g-b" picking-mode="Ignore" />
                            <ui:VisualElement class="g g-c" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label class="cat__label" text="UNDERGLOW" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button class="btn cat" name="cat-aero">
                        <ui:VisualElement class="sheen" picking-mode="Ignore" />
                        <ui:VisualElement class="edge" picking-mode="Ignore" />
                        <ui:VisualElement class="glyph glyph--aero" picking-mode="Ignore">
                            <ui:VisualElement class="g g-a" picking-mode="Ignore" />
                            <ui:VisualElement class="g g-b" picking-mode="Ignore" />
                            <ui:VisualElement class="g g-c" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label class="cat__label" text="AERO" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button class="btn cat accent-amber" name="cat-perf">
                        <ui:VisualElement class="sheen" picking-mode="Ignore" />
                        <ui:VisualElement class="edge" picking-mode="Ignore" />
                        <ui:VisualElement class="glyph glyph--perf" picking-mode="Ignore">
                            <ui:VisualElement class="g g-a" picking-mode="Ignore" />
                            <ui:VisualElement class="g g-b" picking-mode="Ignore" />
                            <ui:VisualElement class="g g-c" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label class="cat__label" text="TUNING" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement class="cz-center" picking-mode="Ignore">
                    <ui:VisualElement class="chips cz-cams" picking-mode="Ignore">
                        <ui:Button class="btn chip">
                            <ui:Label class="chip__label" text="FRONT" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button class="btn chip chip--active">
                            <ui:Label class="chip__label" text="SIDE" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button class="btn chip">
                            <ui:Label class="chip__label" text="REAR" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button class="btn chip">
                            <ui:Label class="chip__label" text="DETAIL" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="spacer" picking-mode="Ignore" />
                    <ui:Label class="drag-hint" text="DRAG TO ORBIT" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="cz-detail rarity-epic accent-cyan" picking-mode="Ignore">
                    <ui:VisualElement class="cz-detail__bar" picking-mode="Ignore" />
                    <ui:Label class="eyebrow eyebrow--accent" text="PAINT" name="detail-category" picking-mode="Ignore" />
                    <ui:Label class="cz-detail__name" text="PLASMA VIOLET" name="detail-name" picking-mode="Ignore" />
                    <ui:VisualElement class="cz-detail__tags" picking-mode="Ignore">
                        <ui:Label class="tag" text="EPIC" picking-mode="Ignore" />
                        <ui:Label class="cz-detail__state" text="LOCKED" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label class="cz-detail__desc" text="DEEP VIOLET BASE WITH A SHIFTING PLASMA SHEEN THAT BRIGHTENS UNDER BOOST." picking-mode="Ignore" />
                    <ui:VisualElement class="unlock-box" picking-mode="Ignore">
                        <ui:VisualElement class="unlock-box__row" picking-mode="Ignore">
                            <ui:VisualElement class="lock" picking-mode="Ignore">
                                <ui:VisualElement class="lock__shackle" picking-mode="Ignore" />
                                <ui:VisualElement class="lock__body" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="unlock-box__text" picking-mode="Ignore">
                                <ui:Label class="unlock-box__title" text="HOW TO UNLOCK" picking-mode="Ignore" />
                                <ui:Label class="unlock-box__req" text="REACH PILOT LEVEL 18" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="unlock-box__bar" picking-mode="Ignore">
                            <ui:VisualElement class="unlock-box__fill" style="width: 78%;" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label class="unlock-box__prog" text="LEVEL 14 / 18" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label class="eyebrow cz-detail__optlabel" text="FINISH" picking-mode="Ignore" />
                    <ui:VisualElement class="chips" picking-mode="Position">
                        <ui:Button class="btn chip">
                            <ui:Label class="chip__label" text="GLOSS" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button class="btn chip">
                            <ui:Label class="chip__label" text="MATTE" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button class="btn chip chip--active">
                            <ui:Label class="chip__label" text="METALLIC" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button class="btn chip">
                            <ui:Label class="chip__label" text="HOLO" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="spacer" picking-mode="Ignore" />
                    <ui:VisualElement class="cz-detail__actions" picking-mode="Ignore">
                        <ui:Button class="btn btn-ghost cz-detail__shop hidden" name="btn-goto-shop">
                            <ui:VisualElement class="sheen" picking-mode="Ignore" />
                            <ui:Label class="btn-ghost__label" text="SHOP" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button class="btn btn-cta cz-detail__main hidden" name="btn-equip-item">
                            <ui:VisualElement class="sheen" picking-mode="Ignore" />
                            <ui:Label class="btn-cta__label" text="EQUIP" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button class="btn btn-cta btn-cta--disabled cz-detail__main" name="btn-locked-item">
                            <ui:Label class="btn-cta__label" text="LOCKED" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="cz-strip" picking-mode="Ignore">
                <ui:VisualElement class="cz-strip__head" picking-mode="Ignore">
                    <ui:Label class="cz-strip__title" text="PAINT" name="strip-title" picking-mode="Ignore" />
                    <ui:Label class="carousel-count" text="7 / 10 UNLOCKED" name="strip-count" picking-mode="Ignore" />
                    <ui:VisualElement class="spacer" picking-mode="Ignore" />
                    <ui:VisualElement class="chips" picking-mode="Ignore">
                        <ui:Button class="btn chip chip--active">
                            <ui:Label class="chip__label" text="ALL" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button class="btn chip">
                            <ui:Label class="chip__label" text="UNLOCKED" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button class="btn chip">
                            <ui:Label class="chip__label" text="LOCKED" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="cz-strip__pages" picking-mode="Ignore">
                    <ui:VisualElement class="page" name="page-paint" picking-mode="Ignore">
                        <ui:ScrollView class="cz-list" mode="Horizontal" touch-scroll-type="Elastic" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                            <ui:Button class="btn tile rarity-rare tile--equipped">
                                <ui:VisualElement class="tile__bar" picking-mode="Ignore" />
                                <ui:VisualElement class="tile__art" picking-mode="Ignore">
                                    <ui:VisualElement class="tile__swatch" style="background-color: rgb(20,40,120);" picking-mode="Ignore">
                                        <ui:VisualElement class="tile__shine" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="tile__badge" picking-mode="Ignore">
                                        <ui:VisualElement class="check" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                <ui:VisualElement class="tile__info" picking-mode="Ignore">
                                    <ui:Label class="tile__name" text="VOID BLUE" picking-mode="Ignore" />
                                    <ui:Label class="tile__state tile__state--on" text="EQUIPPED" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Button class="btn tile rarity-common">
                                <ui:VisualElement class="tile__bar" picking-mode="Ignore" />
                                <ui:VisualElement class="tile__art" picking-mode="Ignore">
                                    <ui:VisualElement class="tile__swatch" style="background-color: rgb(0,229,255);" picking-mode="Ignore">
                                        <ui:VisualElement class="tile__shine" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                <ui:VisualElement class="tile__info" picking-mode="Ignore">
                                    <ui:Label class="tile__name" text="NEON CYAN" picking-mode="Ignore" />
                                    <ui:Label class="tile__state" text="OWNED" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Button class="btn tile rarity-common">
                                <ui:VisualElement class="tile__bar" picking-mode="Ignore" />
                                <ui:VisualElement class="tile__art" picking-mode="Ignore">
                                    <ui:VisualElement class="tile__swatch" style="background-color: rgb(255,46,176);" picking-mode="Ignore">
                                        <ui:VisualElement class="tile__shine" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                <ui:VisualElement class="tile__info" picking-mode="Ignore">
                                    <ui:Label class="tile__name" text="HOT PINK" picking-mode="Ignore" />
                                    <ui:Label class="tile__state" text="OWNED" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Button class="btn tile rarity-rare">
                                <ui:VisualElement class="tile__bar" picking-mode="Ignore" />
                                <ui:VisualElement class="tile__art" picking-mode="Ignore">
                                    <ui:VisualElement class="tile__swatch" style="background-color: rgb(255,190,0);" picking-mode="Ignore">
                                        <ui:VisualElement class="tile__shine" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                <ui:VisualElement class="tile__info" picking-mode="Ignore">
                                    <ui:Label class="tile__name" text="SOLAR GOLD" picking-mode="Ignore" />
                                    <ui:Label class="tile__state" text="OWNED" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Button class="btn tile rarity-common">
                                <ui:VisualElement class="tile__bar" picking-mode="Ignore" />
                                <ui:VisualElement class="tile__art" picking-mode="Ignore">
                                    <ui:VisualElement class="tile__swatch" style="background-color: rgb(70,255,160);" picking-mode="Ignore">
                                        <ui:VisualElement class="tile__shine" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                <ui:VisualElement class="tile__info" picking-mode="Ignore">
                                    <ui:Label class="tile__name" text="TOXIC GREEN" picking-mode="Ignore" />
                                    <ui:Label class="tile__state" text="OWNED" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Button class="btn tile rarity-epic">
                                <ui:VisualElement class="tile__bar" picking-mode="Ignore" />
                                <ui:VisualElement class="tile__art" picking-mode="Ignore">
                                    <ui:VisualElement class="tile__swatch" style="background-color: rgb(200,210,225);" picking-mode="Ignore">
                                        <ui:VisualElement class="tile__shine" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                <ui:VisualElement class="tile__info" picking-mode="Ignore">
                                    <ui:Label class="tile__name" text="CHROME SILVER" picking-mode="Ignore" />
                                    <ui:Label class="tile__state" text="OWNED" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Button class="btn tile rarity-rare">
                                <ui:VisualElement class="tile__bar" picking-mode="Ignore" />
                                <ui:VisualElement class="tile__art" picking-mode="Ignore">
                                    <ui:VisualElement class="tile__swatch" style="background-color: rgb(14,18,30);" picking-mode="Ignore">
                                        <ui:VisualElement class="tile__shine" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                <ui:VisualElement class="tile__info" picking-mode="Ignore">
                                    <ui:Label class="tile__name" text="OBSIDIAN" picking-mode="Ignore" />
                                    <ui:Label class="tile__state" text="OWNED" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Button class="btn tile rarity-epic tile--locked tile--selected">
                                <ui:VisualElement class="tile__bar" picking-mode="Ignore" />
                                <ui:VisualElement class="tile__art" picking-mode="Ignore">
                                    <ui:VisualElement class="tile__swatch" style="background-color: rgb(150,80,255);" picking-mode="Ignore">
                                        <ui:VisualElement class="tile__shine" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="tile__veil" picking-mode="Ignore" />
                                    <ui:VisualElement class="tile__lock" picking-mode="Ignore">
                                        <ui:VisualElement class="lock" picking-mode="Ignore">
                                            <ui:VisualElement class="lock__shackle" picking-mode="Ignore" />
                                            <ui:VisualElement class="lock__body" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                <ui:VisualElement class="tile__info" picking-mode="Ignore">
                                    <ui:Label class="tile__name" text="PLASMA VIOLET" picking-mode="Ignore" />
                                    <ui:VisualElement class="tile__reqrow" picking-mode="Ignore">
                                        <ui:VisualElement class="lock lock--sm" picking-mode="Ignore">
                                            <ui:VisualElement class="lock__shackle" picking-mode="Ignore" />
                                            <ui:VisualElement class="lock__body" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                        <ui:Label class="tile__req" text="PILOT LVL 18" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Button class="btn tile rarity-epic tile--locked">
                                <ui:VisualElement class="tile__bar" picking-mode="Ignore" />
                                <ui:VisualElement class="tile__art" picking-mode="Ignore">
                                    <ui:VisualElement class="tile__swatch" style="background-color: rgb(255,60,80);" picking-mode="Ignore">
                                        <ui:VisualElement class="tile__shine" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="tile__veil" picking-mode="Ignore" />
                                    <ui:VisualElement class="tile__lock" picking-mode="Ignore">
                                        <ui:VisualElement class="lock" picking-mode="Ignore">
                                            <ui:VisualElement class="lock__shackle" picking-mode="Ignore" />
                                            <ui:VisualElement class="lock__body" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                <ui:VisualElement class="tile__info" picking-mode="Ignore">
                                    <ui:Label class="tile__name" text="CRIMSON FLARE" picking-mode="Ignore" />
                                    <ui:VisualElement class="tile__reqrow" picking-mode="Ignore">
                                        <ui:VisualElement class="lock lock--sm" picking-mode="Ignore">
                                            <ui:VisualElement class="lock__shackle" picking-mode="Ignore" />
                                            <ui:VisualElement class="lock__body" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                        <ui:Label class="tile__req" text="EVENT: NEON GP" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Button class="btn tile rarity-rare tile--locked">
                                <ui:VisualElement class="tile__bar" picking-mode="Ignore" />
                                <ui:VisualElement class="tile__art" picking-mode="Ignore">
                                    <ui:VisualElement class="tile__swatch" style="background-color: rgb(240,248,255);" picking-mode="Ignore">
                                        <ui:VisualElement class="tile__shine" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="tile__veil" picking-mode="Ignore" />
                                    <ui:VisualElement class="tile__lock" picking-mode="Ignore">
                                        <ui:VisualElement class="lock" picking-mode="Ignore">
                                            <ui:VisualElement class="lock__shackle" picking-mode="Ignore" />
                                            <ui:VisualElement class="lock__body" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                <ui:VisualElement class="tile__info" picking-mode="Ignore">
                                    <ui:Label class="tile__name" text="ICE WHITE" picking-mode="Ignore" />
                                    <ui:VisualElement class="tile__reqrow" picking-mode="Ignore">
                                        <ui:VisualElement class="lock lock--sm" picking-mode="Ignore">
                                            <ui:VisualElement class="lock__shackle" picking-mode="Ignore" />
                                            <ui:VisualElement class="lock__body" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                        <ui:Label class="tile__req" text="KAI MASTERY 5" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:Button>
                        </ui:ScrollView>
                    </ui:VisualElement>
                    <ui:VisualElement class="page page--hidden" name="page-wrap" picking-mode="Ignore">
                        <ui:ScrollView class="cz-list" mode="Horizontal" touch-scroll-type="Elastic" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                            <ui:Button class="btn tile rarity-common">
                                <ui:VisualElement class="tile__bar" picking-mode="Ignore" />
                                <ui:VisualElement class="tile__art" picking-mode="Ignore">
                                    <ui:VisualElement class="tile__none" picking-mode="Ignore">
                                        <ui:VisualElement class="tile__none-line" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                <ui:VisualElement class="tile__info" picking-mode="Ignore">
                                    <ui:Label class="tile__name" text="NONE" picking-mode="Ignore" />
                                    <ui:Label class="tile__state" text="OWNED" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Button class="btn tile rarity-rare tile--equipped">
                                <ui:VisualElement class="tile__bar" picking-mode="Ignore" />
                                <ui:VisualElement class="tile__art" picking-mode="Ignore">
                                    <ui:VisualElement class="tile__wrap" picking-mode="Ignore">
                                        <ui:VisualElement class="tw tw-a" style="background-color: rgb(40,48,64);" picking-mode="Ignore" />
                                        <ui:VisualElement class="tw tw-b" style="background-color: rgb(70,82,104);" picking-mode="Ignore" />
                                        <ui:VisualElement class="tw tw-c" style="background-color: rgb(40,48,64);" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="tile__badge" picking-mode="Ignore">
                                        <ui:VisualElement class="check" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                <ui:VisualElement class="tile__info" picking-mode="Ignore">
                                    <ui:Label class="tile__name" text="CARBON WEAVE" picking-mode="Ignore" />
                                    <ui:Label class="tile__state tile__state--on" text="EQUIPPED" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Button class="btn tile rarity-rare">
                                <ui:VisualElement class="tile__bar" picking-mode="Ignore" />
                                <ui:VisualElement class="tile__art" picking-mode="Ignore">
                                    <ui:VisualElement class="tile__wrap" picking-mode="Ignore">
                                        <ui:VisualElement class="tw tw-a" style="background-color: rgb(0,229,255);" picking-mode="Ignore" />
                                        <ui:VisualElement class="tw tw-b" style="background-color: rgb(0,120,160);" picking-mode="Ignore" />
                                        <ui:VisualElement class="tw tw-c" style="background-color: rgb(0,229,255);" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                <ui:VisualElement class="tile__info" picking-mode="Ignore">
                                    <ui:Label class="tile__name" text="CIRCUIT" picking-mode="Ignore" />
                                    <ui:Label class="tile__state" text="OWNED" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Button class="btn tile rarity-common">
                                <ui:VisualElement class="tile__bar" picking-mode="Ignore" />
                                <ui:VisualElement class="tile__art" picking-mode="Ignore">
