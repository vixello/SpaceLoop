                                    <ui:Label class="chip__label" text="CLAIMABLE" picking-mode="Ignore" />
                                    <ui:Label class="chip__badge" text="1" picking-mode="Ignore" />
                                </ui:Button>
                                <ui:Button class="btn chip">
                                    <ui:Label class="chip__label" text="IN PROGRESS" picking-mode="Ignore" />
                                </ui:Button>
