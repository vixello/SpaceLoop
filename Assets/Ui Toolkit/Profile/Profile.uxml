                                    </ui:VisualElement>
                                    <ui:VisualElement class="ach__text" picking-mode="Ignore">
                                        <ui:Label class="ach__name" text="SQUAD GOALS" picking-mode="Ignore" />
                                        <ui:Label class="ach__desc" text="WIN 10 RACES WITH FRIENDS" picking-mode="Ignore" />
                                        <ui:VisualElement class="ach__prog" picking-mode="Ignore">
                                            <ui:VisualElement class="pbar pbar--thin" picking-mode="Ignore">
                                                <ui:VisualElement class="pbar__fill" style="width: 30%;" picking-mode="Ignore" />
                                            </ui:VisualElement>
                                            <ui:Label class="ach__count" text="3 / 10" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="ach__side" picking-mode="Ignore">
                                        <ui:VisualElement class="price accent-amber" picking-mode="Ignore">
                                            <ui:VisualElement class="price__icon" picking-mode="Ignore" />
                                            <ui:Label class="price__value" text="8,000" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="ach rarity-legendary ach--progress" picking-mode="Position">
                                    <ui:VisualElement class="ach__icon" picking-mode="Ignore">
                                        <ui:VisualElement class="ach__core" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="ach__text" picking-mode="Ignore">
                                        <ui:Label class="ach__name" text="FULL SET" picking-mode="Ignore" />
                                        <ui:Label class="ach__desc" text="UNLOCK EVERY OUTFIT FOR ONE DRIVER" picking-mode="Ignore" />
                                        <ui:VisualElement class="ach__prog" picking-mode="Ignore">
                                            <ui:VisualElement class="pbar pbar--thin" picking-mode="Ignore">
                                                <ui:VisualElement class="pbar__fill" style="width: 42%;" picking-mode="Ignore" />
                                            </ui:VisualElement>
                                            <ui:Label class="ach__count" text="3 / 7" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="ach__side" picking-mode="Ignore">
                                        <ui:VisualElement class="price accent-magenta" picking-mode="Ignore">
                                            <ui:VisualElement class="price__icon" picking-mode="Ignore" />
                                            <ui:Label class="price__value" text="150" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="ach rarity-legendary ach--progress" picking-mode="Position">
                                    <ui:VisualElement class="ach__icon" picking-mode="Ignore">
                                        <ui:VisualElement class="ach__core" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="ach__text" picking-mode="Ignore">
                                        <ui:Label class="ach__name" text="LEGEND" picking-mode="Ignore" />
                                        <ui:Label class="ach__desc" text="REACH PILOT LEVEL 50" picking-mode="Ignore" />
                                        <ui:VisualElement class="ach__prog" picking-mode="Ignore">
                                            <ui:VisualElement class="pbar pbar--thin" picking-mode="Ignore">
                                                <ui:VisualElement class="pbar__fill" style="width: 54%;" picking-mode="Ignore" />
                                            </ui:VisualElement>
                                            <ui:Label class="ach__count" text="27 / 50" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="ach__side" picking-mode="Ignore">
                                        <ui:Label class="ach__title-reward" text="TITLE  LEGEND" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="ach rarity-legendary ach--locked" picking-mode="Position">
                                    <ui:VisualElement class="ach__icon" picking-mode="Ignore">
                                        <ui:VisualElement class="ach__core" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="ach__text" picking-mode="Ignore">
                                        <ui:Label class="ach__name" text="???" picking-mode="Ignore" />
                                        <ui:Label class="ach__desc" text="SECRET ACHIEVEMENT. KEEP RACING TO DISCOVER IT." picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="ach__side" picking-mode="Ignore">
                                        <ui:VisualElement class="lock" picking-mode="Ignore">
                                            <ui:VisualElement class="lock__shackle" picking-mode="Ignore" />
                                            <ui:VisualElement class="lock__body" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:ScrollView>
                        </ui:VisualElement>
                        <ui:VisualElement class="page page--hidden" name="page-career" picking-mode="Ignore">
                            <ui:ScrollView class="grid" touch-scroll-type="Elastic" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                                <ui:VisualElement class="section-head" picking-mode="Ignore">
                                    <ui:Label class="eyebrow eyebrow--accent" text="CAREER STATS" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:VisualElement class="crow" picking-mode="Ignore">
                                    <ui:Label class="crow__label" text="TOTAL DISTANCE" picking-mode="Ignore" />
                                    <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                    <ui:Label class="crow__value" text="18,420 KM" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:VisualElement class="crow" picking-mode="Ignore">
                                    <ui:Label class="crow__label" text="TOP SPEED" picking-mode="Ignore" />
                                    <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                    <ui:Label class="crow__value" text="412 KM/H" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:VisualElement class="crow" picking-mode="Ignore">
                                    <ui:Label class="crow__label" text="DRIFT SCORE" picking-mode="Ignore" />
                                    <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                    <ui:Label class="crow__value" text="2,480,500" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:VisualElement class="crow" picking-mode="Ignore">
                                    <ui:Label class="crow__label" text="PERFECT STARTS" picking-mode="Ignore" />
                                    <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                    <ui:Label class="crow__value" text="112" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:VisualElement class="crow" picking-mode="Ignore">
                                    <ui:Label class="crow__label" text="LONGEST WIN STREAK" picking-mode="Ignore" />
                                    <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                    <ui:Label class="crow__value" text="9" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:VisualElement class="crow" picking-mode="Ignore">
                                    <ui:Label class="crow__label" text="TIME RACING" picking-mode="Ignore" />
                                    <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                    <ui:Label class="crow__value" text="142 H 18 M" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:VisualElement class="crow" picking-mode="Ignore">
                                    <ui:Label class="crow__label" text="MULTIPLAYER RATING" picking-mode="Ignore" />
                                    <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                    <ui:Label class="crow__value" text="2,340 RP" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:VisualElement class="crow" picking-mode="Ignore">
                                    <ui:Label class="crow__label" text="BEST WEEKLY RANK" picking-mode="Ignore" />
                                    <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                    <ui:Label class="crow__value" text="#184" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:VisualElement class="section-head" picking-mode="Ignore">
                                    <ui:Label class="eyebrow eyebrow--accent" text="RECORDS" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:VisualElement class="kpis" picking-mode="Ignore">
                                    <ui:VisualElement class="kpi" picking-mode="Ignore">
                                        <ui:Label class="kpi__num" text="1:42.318" picking-mode="Ignore" />
                                        <ui:Label class="kpi__label" text="BEST LAP  /  NEON DISTRICT" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="kpi" picking-mode="Ignore">
                                        <ui:Label class="kpi__num" text="388 KM/H" picking-mode="Ignore" />
                                        <ui:Label class="kpi__label" text="BEST SPEED TRAP" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:ScrollView>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="modal-layer hidden" name="modal-logout" picking-mode="Position">
            <ui:VisualElement class="modal accent-red" picking-mode="Ignore">
                <ui:VisualElement class="modal__bar" picking-mode="Ignore" />
                <ui:Label class="eyebrow eyebrow--accent" text="ACCOUNT" picking-mode="Ignore" />
                <ui:Label class="modal__title" text="LOG OUT?" picking-mode="Ignore" />
                <ui:Label class="modal__text" text="YOU WILL RETURN TO THE LOGIN SCREEN. YOUR PROGRESS IS SAVED TO YOUR ACCOUNT AND WILL BE HERE WHEN YOU COME BACK." picking-mode="Ignore" />
                <ui:VisualElement class="modal__buttons" picking-mode="Ignore">
                    <ui:Button class="btn btn-ghost modal__btn accent-cyan" name="btn-logout-cancel">
                        <ui:VisualElement class="sheen" picking-mode="Ignore" />
                        <ui:Label class="btn-ghost__label" text="CANCEL" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button class="btn btn-cta modal__btn accent-red" name="btn-logout-confirm">
                        <ui:VisualElement class="sheen" picking-mode="Ignore" />
                        <ui:Label class="btn-cta__label" text="LOG OUT" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="modal-layer hidden" name="modal-switch" picking-mode="Position">
            <ui:VisualElement class="modal modal--wide accent-cyan" picking-mode="Ignore">
                <ui:VisualElement class="modal__bar" picking-mode="Ignore" />
                <ui:Label class="eyebrow eyebrow--accent" text="ACCOUNT" picking-mode="Ignore" />
                <ui:Label class="modal__title" text="SWITCH ACCOUNT" picking-mode="Ignore" />
                <ui:Label class="modal__text" text="PICK A SAVED ACCOUNT OR SIGN IN WITH A DIFFERENT ONE." picking-mode="Ignore" />
                <ui:VisualElement class="acct-list" picking-mode="Ignore">
                    <ui:Button class="btn acct acct--active">
                        <ui:VisualElement class="sheen" picking-mode="Ignore" />
                        <ui:VisualElement class="edge" picking-mode="Ignore" />
                        <ui:VisualElement class="acct__avatar" style="background-color: rgba(0,229,255,0.28);" picking-mode="Ignore" />
                        <ui:VisualElement class="acct__text" picking-mode="Ignore">
                            <ui:Label class="acct__name" text="NOVA_RUNNER" picking-mode="Ignore" />
                            <ui:Label class="acct__sub" text="LEVEL 27  /  GOOGLE PLAY" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label class="tag tag--accent acct__tag" text="ACTIVE" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button class="btn acct">
                        <ui:VisualElement class="sheen" picking-mode="Ignore" />
                        <ui:VisualElement class="edge" picking-mode="Ignore" />
                        <ui:VisualElement class="acct__avatar" style="background-color: rgba(255,46,176,0.28);" picking-mode="Ignore" />
                        <ui:VisualElement class="acct__text" picking-mode="Ignore">
                            <ui:Label class="acct__name" text="DRIFT_GHOST" picking-mode="Ignore" />
                            <ui:Label class="acct__sub" text="LEVEL 12  /  APPLE GAME CENTER" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="chevron" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button class="btn acct">
                        <ui:VisualElement class="sheen" picking-mode="Ignore" />
                        <ui:VisualElement class="edge" picking-mode="Ignore" />
                        <ui:VisualElement class="acct__avatar" style="background-color: rgba(255,190,0,0.28);" picking-mode="Ignore" />
                        <ui:VisualElement class="acct__text" picking-mode="Ignore">
                            <ui:Label class="acct__name" text="GUEST_4821" picking-mode="Ignore" />
                            <ui:Label class="acct__sub" text="LEVEL 3  /  GUEST" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="chevron" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button class="btn acct acct--add" name="btn-add-account">
                        <ui:VisualElement class="sheen" picking-mode="Ignore" />
                        <ui:VisualElement class="acct__plus" picking-mode="Ignore">
                            <ui:VisualElement class="plus-h" picking-mode="Ignore" />
                            <ui:VisualElement class="plus-v" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label class="acct__add-text" text="ADD ANOTHER ACCOUNT" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement class="modal__buttons" picking-mode="Ignore">
                    <ui:Button class="btn btn-ghost modal__btn accent-cyan" name="btn-switch-cancel">
                        <ui:VisualElement class="sheen" picking-mode="Ignore" />
                        <ui:Label class="btn-ghost__label" text="CLOSE" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
