                                        <ui:Label class="ach__desc" text="25 PERFECT LAUNCHES" picking-mode="Ignore" />
                                        <ui:VisualElement class="ach__prog" picking-mode="Ignore">
                                            <ui:VisualElement class="pbar pbar--thin" picking-mode="Ignore">
