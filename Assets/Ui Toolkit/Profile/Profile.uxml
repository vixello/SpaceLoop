                                    </ui:VisualElement>
                                    <ui:VisualElement class="tier tier--gold" picking-mode="Ignore">
                                        <ui:Label class="tier__num" text="6" picking-mode="Ignore" />
                                        <ui:Label class="tier__label" text="GOLD" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="tier tier--plat" picking-mode="Ignore">
                                        <ui:Label class="tier__num" text="2" picking-mode="Ignore" />
                                        <ui:Label class="tier__label" text="PLATINUM" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="chips" picking-mode="Ignore">
                                <ui:Button class="btn chip chip--active">
                                    <ui:Label class="chip__label" text="ALL" picking-mode="Ignore" />
