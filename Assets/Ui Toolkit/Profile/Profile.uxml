                                        <ui:Label class="tier__label" text="BRONZE" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="tier tier--silver" picking-mode="Ignore">
                                        <ui:Label class="tier__num" text="14" picking-mode="Ignore" />
