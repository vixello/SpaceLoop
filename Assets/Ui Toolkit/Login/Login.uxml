<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/Ui Toolkit/Common/Common.uss" />
    <ui:Style src="project://database/Assets/Ui Toolkit/Login/Login.uss" />
    <ui:Template name="Scrims" src="project://database/Assets/Ui Toolkit/Common/Components/Scrims.uxml" />

    <ui:VisualElement class="screen" name="root" picking-mode="Position">
        <!-- FULL SCREEN SPLASH BACKDROP -->
        <ui:VisualElement class="layer login-art" name="login-art" picking-mode="Ignore" />
        <ui:Instance class="layer" template="Scrims" picking-mode="Ignore" />

        <!-- SPEED LINES & DECORATIVE BACKDROP -->
        <ui:VisualElement class="lines" picking-mode="Ignore">
            <ui:VisualElement class="sline sline--a" picking-mode="Ignore" />
            <ui:VisualElement class="sline sline--b" picking-mode="Ignore" />
            <ui:VisualElement class="sline sline--c" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- TACHOMETER (RIGHT SIDE) -->
        <ui:VisualElement class="tach" picking-mode="Ignore">
            <ui:VisualElement class="tach__ring tach__ring--a" picking-mode="Ignore" />
            <ui:VisualElement class="tach__ring tach__ring--b" picking-mode="Ignore" />
            <ui:VisualElement class="needle" style="rotate: -52deg;" name="tach-needle" picking-mode="Ignore">
                <ui:VisualElement class="needle__bar" picking-mode="Ignore" />
                <ui:VisualElement class="needle__tip" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="tach__hub" picking-mode="Ignore">
                <ui:VisualElement class="tach__hub-core" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label class="tach__speed" text="000" name="tach-speed" picking-mode="Ignore" />
            <ui:Label class="tach__unit" text="KM/H" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- MAIN HUD LAYER -->
        <ui:VisualElement class="layer login-hud" name="hud" picking-mode="Ignore">
            <!-- TOP BAR / CODM STYLE SEASON INFO (BACKGROUND-LESS, FLOATING UNMODESTLY) -->
            <ui:VisualElement class="login-top" picking-mode="Ignore">
                <ui:VisualElement class="spacer" picking-mode="Ignore" />
                <ui:VisualElement class="season-banner" picking-mode="Ignore">
                    <ui:Label class="season-banner__eyebrow" text="CURRENT SEASON" picking-mode="Ignore" />
                    <ui:Label class="season-banner__title" text="SEASON 04  /  NEON DRIFT" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- MIDDLE CONTENT -->
            <ui:VisualElement class="login-main" picking-mode="Ignore">
                <ui:VisualElement class="login-left" picking-mode="Ignore">
                    <ui:VisualElement class="wordmark" picking-mode="Ignore">
                        <ui:Label class="wordmark__eyebrow" text="SCI-FI RACING" picking-mode="Ignore" />
                        <ui:VisualElement class="wl" picking-mode="Ignore">
                            <ui:Label class="wordmark__title wordmark__ghost wordmark__ghost--c" text="APEX" picking-mode="Ignore" />
                            <ui:Label class="wordmark__title wordmark__ghost wordmark__ghost--m" text="APEX" picking-mode="Ignore" />
                            <ui:Label class="wordmark__title" text="APEX" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="wl" picking-mode="Ignore">
                            <ui:Label class="wordmark__title wordmark__ghost wordmark__ghost--c wordmark__title--b" text="VELOCITY" picking-mode="Ignore" />
                            <ui:Label class="wordmark__title wordmark__ghost wordmark__ghost--m wordmark__title--b" text="VELOCITY" picking-mode="Ignore" />
                            <ui:Label class="wordmark__title wordmark__title--b" text="VELOCITY" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="spacer" picking-mode="Ignore" />

                    <!-- RETURNING PLAYER PAGE -->
                    <ui:VisualElement class="page page--hidden" picking-mode="Ignore">
                        <ui:VisualElement class="lp accent-cyan" name="page-returning" picking-mode="Ignore">
                            <ui:Label class="eyebrow eyebrow--accent" text="WELCOME BACK, PILOT" picking-mode="Ignore" />
                            <ui:VisualElement class="ret" picking-mode="Ignore">
                                <ui:VisualElement class="ret__av" picking-mode="Ignore">
                                    <ui:VisualElement class="ret__lvl" picking-mode="Ignore">
                                        <ui:Label class="ret__lvl-text" text="27" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="ret__text" picking-mode="Ignore">
                                    <ui:Label class="ret__name" text="NOVA_RUNNER" picking-mode="Ignore" />
                                    <ui:Label class="ret__sub" text="PLATINUM II  /  SIGNED IN WITH GOOGLE" picking-mode="Ignore" />
                                    <ui:VisualElement class="ret__bar" picking-mode="Ignore">
                                        <ui:VisualElement class="ret__fill" style="width: 62%;" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:Button class="btn btn-cta ret__go" name="btn-continue">
                                <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                <ui:Label class="btn-cta__label" text="IGNITE" picking-mode="Ignore" />
                                <ui:Label class="ret__go-sub" text="CONTINUE AS NOVA_RUNNER" picking-mode="Ignore" />
                            </ui:Button>
                            <ui:VisualElement class="ret__more" picking-mode="Ignore">
                                <ui:Button class="btn link" name="btn-other-account">
                                    <ui:Label class="link__text" text="USE ANOTHER ACCOUNT" picking-mode="Ignore" />
                                </ui:Button>
                                <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                <ui:Button class="btn link" name="btn-sign-out">
                                    <ui:Label class="link__text" text="SIGN OUT" picking-mode="Ignore" />
                                </ui:Button>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- CLEAN LOGIN PAGE (MULTIPLE AUTH PROVIDERS EXTENSIBLE) -->
                    <ui:VisualElement class="page" picking-mode="Ignore">
                        <ui:VisualElement class="lp accent-cyan" name="page-login" picking-mode="Ignore">
                            <ui:Label class="eyebrow eyebrow--accent" text="WELCOME, PILOT" picking-mode="Ignore" />
                            <ui:Label class="lp__title" text="SIGN IN TO RACE" picking-mode="Ignore" />
                            <ui:Label class="lp__text" text="SELECT YOUR PREFERRED SIGN-IN METHOD TO ACCESS YOUR GARAGE AND DRIVERS." picking-mode="Ignore" />

                            <!-- MAIN GOOGLE BUTTON -->
                            <ui:Button class="btn google" name="btn-google-signin">
                                <ui:VisualElement class="sheen sheen--dark" picking-mode="Ignore" />
                                <ui:VisualElement class="google__logo" picking-mode="Ignore">
                                    <ui:VisualElement class="google__q google__q--b" picking-mode="Ignore" />
                                    <ui:VisualElement class="google__q google__q--r" picking-mode="Ignore" />
                                    <ui:VisualElement class="google__q google__q--y" picking-mode="Ignore" />
                                    <ui:VisualElement class="google__q google__q--g" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:Label class="google__text" text="Sign in with Google" picking-mode="Ignore" />
                            </ui:Button>

                            <!-- OTHER AUTH OPTIONS (FOR EASY FUTURE EXPANSION) -->
                            <ui:VisualElement class="auth-options" picking-mode="Ignore">
                                <ui:Button class="btn auth-opt" name="btn-auth-guest">
                                    <ui:Label class="auth-opt__text" text="GUEST" picking-mode="Ignore" />
                                </ui:Button>
                                <ui:Button class="btn auth-opt" name="btn-auth-email">
                                    <ui:Label class="auth-opt__text" text="EMAIL" picking-mode="Ignore" />
                                </ui:Button>
                                <ui:Button class="btn auth-opt" name="btn-auth-more">
                                    <ui:Label class="auth-opt__text" text="MORE..." picking-mode="Ignore" />
                                </ui:Button>
                            </ui:VisualElement>

                            <ui:VisualElement class="legal" picking-mode="Ignore">
                                <ui:Label class="legal__text" text="BY CONTINUING YOU AGREE TO THE" picking-mode="Ignore" />
                                <ui:Button class="btn link" name="btn-terms">
                                    <ui:Label class="link__text" text="TERMS" picking-mode="Ignore" />
                                </ui:Button>
                                <ui:Label class="legal__text" text="AND" picking-mode="Ignore" />
                                <ui:Button class="btn link" name="btn-privacy">
                                    <ui:Label class="link__text" text="PRIVACY POLICY" picking-mode="Ignore" />
                                </ui:Button>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- FIRST-TIME REGISTRATION PAGE -->
                    <ui:VisualElement class="page page--hidden" picking-mode="Ignore">
                        <ui:VisualElement class="rp accent-cyan" name="page-register" picking-mode="Ignore">
                            <ui:VisualElement class="rp__top" picking-mode="Ignore">
                                <ui:VisualElement class="steps" picking-mode="Ignore">
                                    <ui:VisualElement class="step step--on" picking-mode="Ignore">
                                        <ui:Label class="step__n" text="1" picking-mode="Ignore" />
                                        <ui:Label class="step__label" text="PILOT" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="step__sep" picking-mode="Ignore" />
                                    <ui:VisualElement class="step" picking-mode="Ignore">
                                        <ui:Label class="step__n" text="2" picking-mode="Ignore" />
                                        <ui:Label class="step__label" text="STARTER" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                <ui:Label class="eyebrow" text="FIRST TIME SETUP" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="rp__cols" picking-mode="Ignore">
                                <ui:VisualElement class="rp__left" picking-mode="Ignore">
                                    <ui:VisualElement class="acct-chip" picking-mode="Ignore">
                                        <ui:VisualElement class="acct-chip__av" picking-mode="Ignore" />
                                        <ui:VisualElement class="acct-chip__text" picking-mode="Ignore">
                                            <ui:Label class="acct-chip__name" text="Nova Runner" picking-mode="Ignore" />
                                            <ui:Label class="acct-chip__mail" text="nova.runner@gmail.com" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                        <ui:Label class="tag tag--accent" text="GOOGLE" picking-mode="Ignore" />
                                        <ui:Button class="btn link" name="btn-switch-google">
                                            <ui:Label class="link__text" text="NOT YOU?" picking-mode="Ignore" />
                                        </ui:Button>
                                    </ui:VisualElement>
                                    <ui:Label class="eyebrow section-label" text="CHOOSE YOUR PILOT NAME" picking-mode="Ignore" />
                                    <ui:TextField class="name-field" name="pilot-name" max-length="16" value="NOVA_RUNNER" />
                                    <ui:VisualElement class="name-status" picking-mode="Ignore">
                                        <ui:VisualElement class="check" picking-mode="Ignore" />
                                        <ui:Label class="name-status__text" text="AVAILABLE" picking-mode="Ignore" />
                                        <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                        <ui:Label class="name-status__count" text="10 / 16" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:Label class="hint" text="3 TO 16 CHARACTERS. LETTERS, NUMBERS AND UNDERSCORES. YOU CAN CHANGE IT LATER." picking-mode="Ignore" />
                                    <ui:Label class="eyebrow section-label section-label--gap" text="REGION" picking-mode="Ignore" />
                                    <ui:VisualElement class="chips" picking-mode="Ignore">
                                        <ui:Button class="btn chip chip--active">
                                            <ui:Label class="chip__label" text="EUROPE" picking-mode="Ignore" />
                                        </ui:Button>
                                        <ui:Button class="btn chip">
                                            <ui:Label class="chip__label" text="N. AMERICA" picking-mode="Ignore" />
                                        </ui:Button>
                                        <ui:Button class="btn chip">
                                            <ui:Label class="chip__label" text="ASIA" picking-mode="Ignore" />
                                        </ui:Button>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="rp__right" picking-mode="Ignore">
                                    <ui:Label class="eyebrow section-label" text="CHOOSE YOUR STARTER DRIVER" picking-mode="Ignore" />
                                    <ui:VisualElement class="starters" picking-mode="Ignore">
                                        <ui:Button class="btn st accent-cyan st--on">
                                            <ui:VisualElement class="st__art" style="background-color: rgba(0,229,255,0.22);" picking-mode="Ignore">
                                                <ui:VisualElement class="car__slash" picking-mode="Ignore" />
                                            </ui:VisualElement>
                                            <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                            <ui:VisualElement class="st__body" picking-mode="Ignore">
                                                <ui:Label class="st__role" text="VANGUARD" picking-mode="Ignore" />
                                                <ui:Label class="st__name" text="KAI NOVA" picking-mode="Ignore" />
                                                <ui:VisualElement class="st__veh" picking-mode="Ignore">
                                                    <ui:VisualElement class="st__veh-dot" picking-mode="Ignore" />
                                                    <ui:Label class="st__veh-text" text="ZEPHYR GT-X" picking-mode="Ignore" />
                                                </ui:VisualElement>
                                                <ui:VisualElement class="st__sel" picking-mode="Ignore">
                                                    <ui:VisualElement class="check" picking-mode="Ignore" />
                                                    <ui:Label class="st__sel-text" text="SELECTED" picking-mode="Ignore" />
                                                </ui:VisualElement>
                                            </ui:VisualElement>
                                        </ui:Button>
                                        <ui:Button class="btn st accent-cyan">
                                            <ui:VisualElement class="st__art" style="background-color: rgba(255,190,0,0.22);" picking-mode="Ignore">
                                                <ui:VisualElement class="car__slash" picking-mode="Ignore" />
                                            </ui:VisualElement>
                                            <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                            <ui:VisualElement class="st__body" picking-mode="Ignore">
                                                <ui:Label class="st__role" text="BRUISER" picking-mode="Ignore" />
                                                <ui:Label class="st__name" text="DAX OROZCO" picking-mode="Ignore" />
                                                <ui:VisualElement class="st__veh" picking-mode="Ignore">
                                                    <ui:VisualElement class="st__veh-dot" picking-mode="Ignore" />
                                                    <ui:Label class="st__veh-text" text="HELIX 88" picking-mode="Ignore" />
                                                </ui:VisualElement>
                                                <ui:Label class="st__pick" text="SELECT" picking-mode="Ignore" />
                                            </ui:VisualElement>
                                        </ui:Button>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="rp__foot" picking-mode="Ignore">
                                <ui:Button class="btn cb cb--on" name="cb-terms">
                                    <ui:VisualElement class="cb__box" picking-mode="Ignore">
                                        <ui:VisualElement class="check" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:Label class="cb__text" text="I AM 13 OR OLDER AND AGREE TO THE TERMS AND PRIVACY POLICY" picking-mode="Ignore" />
                                </ui:Button>
                                <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                <ui:Button class="btn btn-cta start" name="btn-start-engine">
                                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                    <ui:Label class="btn-cta__label" text="START ENGINE" picking-mode="Ignore" />
                                </ui:Button>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- BOOT / DOWNLOAD PROGRESS & OPTIONAL MINIGAME TRIGGER -->
            <ui:VisualElement class="boot" picking-mode="Ignore">
                <ui:VisualElement class="boot__top" picking-mode="Ignore">
                    <ui:Label class="boot__tip-tag" text="TIP" picking-mode="Ignore" />
                    <ui:Label class="boot__tip" text="DRIFT THROUGH CORNERS TO CHARGE YOUR BOOST METER." picking-mode="Ignore" />
                    <ui:VisualElement class="spacer" picking-mode="Ignore" />

                    <!-- OPTIONAL GALACTIC SHOOTER MINIGAME TRIGGER -->
                    <ui:Button class="btn btn-minigame" name="btn-minigame">
                        <ui:VisualElement class="minigame__icon" picking-mode="Ignore" />
                        <ui:Label class="minigame__text" text="PLAY 2D SHOOTER WHILE WAITING" picking-mode="Ignore" />
                    </ui:Button>

                    <ui:Label class="boot__pct" text="DOWNLOADING ASSETS  82%" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="boot__bar" picking-mode="Ignore">
                    <ui:VisualElement class="boot__fill" style="width: 82%;" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- FOOTER -->
            <ui:VisualElement class="login-foot" picking-mode="Ignore">
                <ui:Label class="foot__version" text="V 0.9.4  /  BUILD 1287" picking-mode="Ignore" />
                <ui:VisualElement class="foot__status" picking-mode="Ignore">
                    <ui:VisualElement class="foot__dot" picking-mode="Ignore" />
                    <ui:Label class="foot__status-text" text="SERVERS ONLINE" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="spacer" picking-mode="Ignore" />
                <ui:Button class="btn foot__btn" name="btn-language">
                    <ui:Label class="foot__btn-text" text="ENGLISH" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button class="btn foot__btn" name="btn-support">
                    <ui:Label class="foot__btn-text" text="SUPPORT" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- OVERLAYS -->
        <ui:VisualElement class="modal-layer hidden" name="overlay-signing" picking-mode="Position">
            <ui:VisualElement class="dlg accent-cyan" picking-mode="Ignore">
                <ui:VisualElement class="spin" picking-mode="Ignore">
                    <ui:VisualElement class="spin__arc" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label class="eyebrow eyebrow--accent" text="SIGN-IN" picking-mode="Ignore" />
                <ui:Label class="dlg__title" text="CONNECTING" picking-mode="Ignore" />
                <ui:Label class="dlg__text" text="AUTHENTICATING YOUR ACCOUNT. PLEASE WAIT..." picking-mode="Ignore" />
                <ui:Button class="btn btn-ghost dlg__btn accent-cyan" name="btn-signin-cancel">
                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                    <ui:Label class="btn-ghost__label" text="CANCEL" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="modal-layer hidden" name="overlay-error" picking-mode="Position">
            <ui:VisualElement class="dlg accent-red" picking-mode="Ignore">
                <ui:VisualElement class="dlg__bar" picking-mode="Ignore" />
                <ui:Label class="eyebrow eyebrow--accent" text="ERROR" picking-mode="Ignore" />
                <ui:Label class="dlg__title" text="SIGN-IN FAILED" picking-mode="Ignore" />
                <ui:Label class="dlg__text" text="COULD NOT AUTHENTICATE ACCOUNT. CHECK YOUR CONNECTION AND TRY AGAIN." name="error-text" picking-mode="Ignore" />
                <ui:Label class="dlg__code" text="CODE AUTH-12501" name="error-code" picking-mode="Ignore" />
                <ui:VisualElement class="dlg__row" picking-mode="Ignore">
                    <ui:Button class="btn btn-ghost dlg__btn accent-cyan" name="btn-error-close">
                        <ui:VisualElement class="sheen" picking-mode="Ignore" />
                        <ui:Label class="btn-ghost__label" text="CLOSE" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button class="btn btn-cta dlg__btn accent-red" name="btn-error-retry">
                        <ui:VisualElement class="sheen" picking-mode="Ignore" />
                        <ui:Label class="btn-cta__label" text="TRY AGAIN" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>