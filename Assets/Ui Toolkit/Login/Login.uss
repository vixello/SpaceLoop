/* =====================================================================
   LOGIN / BOOTSTRAP USS (requires Common.uss)
   ===================================================================== */

/* Fullscreen Backdrop Splash Screen */
.login-art {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgb(3, 6, 13);
    -unity-background-scale-mode: scale-and-crop;
}

.login-hud {
    flex-direction: column;
    padding: 24px 48px 20px 48px;
}

.login-top {
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
    height: 60px;
}

/* Call of Duty Mobile Style Season Banner (No Background, Floating) */
.season-banner {
    flex-direction: column;
    align-items: flex-end;
}

.season-banner__eyebrow {
    font-size: 11px;
    letter-spacing: 4px;
    color: var(--accent);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.season-banner__title {
    font-size: 24px;
    letter-spacing: 5px;
    color: var(--c-text);
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-right;
}

.login-main {
    flex-direction: row;
    flex-grow: 1;
}

.login-left {
    width: 50%;
    min-width: 620px;
    max-width: 900px;
}

/* ---------------------------------------------------------------------
   1. BACKDROP & DECORATIVE SPEED LINES
   --------------------------------------------------------------------- */
.lines { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.sline { position: absolute; height: 2px; rotate: -8deg; }
.sline--a { left: 52%; top: 12%; width: 22%; background-color: rgba(0, 229, 255, 0.45); }
.sline--b { left: 60%; top: 18%; width: 30%; background-color: rgba(255, 46, 176, 0.35); }
.sline--c { left: 70%; top: 9%; width: 18%; background-color: rgba(255, 255, 255, 0.25); }

/* Tachometer Backdrop (Right Side) */
.tach { position: absolute; right: -120px; bottom: -280px; width: 720px; height: 720px; opacity: 0.85; }
.tach__ring { position: absolute; border-radius: 360px; border-width: 2px; border-color: var(--c-hair); }
.tach__ring--a { left: 0; top: 0; width: 720px; height: 720px; }
.tach__ring--b { left: 60px; top: 60px; width: 600px; height: 600px; border-color: rgba(150, 200, 255, 0.08); }

.needle { position: absolute; left: 356px; top: 60px; width: 8px; height: 300px; transform-origin: 50% 100%; transition-property: rotate; transition-duration: 0.9s; }
.needle__bar { position: absolute; left: 1px; top: 24px; width: 6px; height: 276px; background-color: rgb(255, 46, 176); }
.needle__tip { position: absolute; left: 0; top: 0; width: 8px; height: 40px; background-color: rgb(255, 160, 210); }

.tach__hub { position: absolute; left: 305px; top: 305px; width: 110px; height: 110px; border-radius: 55px; align-items: center; justify-content: center; background-color: rgb(8, 13, 26); border-width: 4px; border-color: var(--accent); }
.tach__hub-core { width: 30px; height: 30px; border-radius: 15px; background-color: var(--accent); }
.tach__speed { position: absolute; left: 260px; top: 436px; width: 200px; font-size: 54px; letter-spacing: 4px; color: var(--c-text); -unity-font-style: bold-and-italic; -unity-text-align: middle-center; }
.tach__unit { position: absolute; left: 260px; top: 496px; width: 200px; font-size: 12px; letter-spacing: 8px; color: var(--c-text-3); -unity-font-style: bold; -unity-text-align: middle-center; }

/* ---------------------------------------------------------------------
   2. WORDMARK (Glitch Title)
   --------------------------------------------------------------------- */
.wordmark { margin-bottom: 8px; }
.wordmark__eyebrow { margin-left: 6px; font-size: 14px; letter-spacing: 12px; color: var(--accent); -unity-font-style: bold; }

.wl { height: 110px; }

.wordmark__title { font-size: 112px; letter-spacing: 14px; color: var(--c-text); white-space: nowrap; -unity-font-style: bold-and-italic; -unity-text-align: middle-left; }
.wordmark__title--b { color: rgb(0, 229, 255); }
.wordmark__ghost { position: absolute; left: 0; top: 0; opacity: 0.7; }
.wordmark__ghost--c { color: rgb(0, 229, 255); translate: -5px 0; }
.wordmark__ghost--m { color: rgb(255, 46, 176); translate: 5px 0; }

/* ---------------------------------------------------------------------
   3. LOGIN PANEL & EXTENSIBLE AUTHENTICATION
   --------------------------------------------------------------------- */
.lp {
    width: 540px;
    padding: 24px 30px 20px 32px;
    background-color: rgba(8, 13, 26, 0.85);
    border-top-width: 3px;
    border-left-width: 5px;
    border-color: var(--accent);
}

.lp__title { margin-top: 2px; font-size: 44px; letter-spacing: 6px; color: var(--c-text); -unity-font-style: bold-and-italic; }
.lp__text { margin: 6px 0 18px 0; font-size: 12px; letter-spacing: 2px; color: var(--c-text-2); white-space: normal; -unity-font-style: bold; }

/* Google Button */
.google {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 72px;
    border-radius: 36px;
    border-width: 1px;
    border-color: rgb(116, 119, 117);
    background-color: rgb(255, 255, 255);
}

.google:hover { background-color: rgb(232, 240, 254); scale: 1.02 1.02; }
.sheen--dark { background-color: rgba(26, 115, 232, 0.10); }

.google__logo { width: 30px; height: 30px; margin-right: 18px; flex-direction: row; flex-wrap: wrap; }
.google__q { width: 15px; height: 15px; }
.google__q--b { background-color: rgb(66, 133, 244); border-top-left-radius: 15px; }
.google__q--r { background-color: rgb(234, 67, 53); border-top-right-radius: 15px; }
.google__q--y { background-color: rgb(251, 188, 5); border-bottom-left-radius: 15px; }
.google__q--g { background-color: rgb(52, 168, 83); border-bottom-right-radius: 15px; }
.google__text { font-size: 22px; letter-spacing: 1px; color: rgb(31, 31, 31); -unity-font-style: bold; }

/* Modular Future Auth Providers */
.auth-options {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 14px;
}

.auth-opt {
    flex-grow: 1;
    height: 44px;
    margin-right: 8px;
    align-items: center;
    justify-content: center;
    background-color: var(--c-fill-soft);
    border-width: 1px;
    border-color: var(--c-hair);
}

.auth-opt:last-child { margin-right: 0; }
.auth-opt:hover { background-color: var(--c-fill-mid); border-color: var(--accent); }

.auth-opt__text {
    font-size: 11px;
    letter-spacing: 3px;
    color: var(--c-text-2);
    -unity-font-style: bold;
}

.auth-opt:hover .auth-opt__text { color: var(--accent); }

/* Legal Links */
.legal { flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 16px; padding-top: 12px; border-top-width: 1px; border-color: var(--c-hair); }
.legal__text { margin-right: 8px; font-size: 10px; letter-spacing: 2px; color: var(--c-text-3); -unity-font-style: bold; }
.link { margin-right: 8px; }
.link__text { font-size: 10px; letter-spacing: 2px; color: var(--accent); -unity-font-style: bold; }
.link:hover .link__text { color: var(--accent-hi); }

/* Returning Player UI */
.ret { flex-direction: row; align-items: center; margin: 8px 0 16px 0; padding: 12px; background-color: var(--c-fill-soft); border-left-width: 3px; border-color: var(--accent); }
.ret__av { width: 84px; height: 84px; margin-right: 18px; background-color: var(--accent-mid); }
.ret__lvl { position: absolute; right: 0; bottom: 0; min-width: 32px; height: 26px; align-items: center; justify-content: center; background-color: var(--accent); }
.ret__lvl-text { font-size: 16px; color: var(--c-ink); -unity-font-style: bold; }
.ret__text { flex-grow: 1; }
.ret__name { font-size: 30px; letter-spacing: 4px; color: var(--c-text); -unity-font-style: bold-and-italic; }
.ret__sub { font-size: 10px; letter-spacing: 2px; color: var(--c-text-2); -unity-font-style: bold; }
.ret__bar { height: 4px; margin-top: 8px; background-color: var(--c-fill-mid); }
.ret__fill { height: 100%; background-color: var(--accent); }
.ret__go { width: 100%; height: 84px; flex-direction: column; }
.ret__go .btn-cta__label { font-size: 36px; letter-spacing: 12px; }
.ret__go-sub { font-size: 10px; letter-spacing: 4px; color: rgba(3, 6, 13, 0.7); -unity-font-style: bold; }
.ret__more { flex-direction: row; margin-top: 14px; }

/* ---------------------------------------------------------------------
   4. REGISTER PANEL
   --------------------------------------------------------------------- */
.rp { padding: 18px 24px; background-color: rgba(8, 13, 26, 0.9); border-top-width: 3px; border-left-width: 5px; border-color: var(--accent); }
.rp__top { flex-direction: row; align-items: center; margin-bottom: 12px; }
.steps { flex-direction: row; align-items: center; }
.step { flex-direction: row; align-items: center; opacity: 0.5; }
.step--on { opacity: 1; }
.step__n { width: 26px; height: 26px; margin-right: 8px; font-size: 14px; color: var(--c-text); background-color: var(--c-fill-mid); -unity-font-style: bold; -unity-text-align: middle-center; }
.step--on .step__n { color: var(--c-ink); background-color: var(--accent); }
.step__label { font-size: 12px; letter-spacing: 4px; color: var(--c-text); -unity-font-style: bold; }
.step__sep { width: 30px; height: 2px; margin: 0 14px; background-color: var(--c-hair-strong); }
.rp__cols { flex-direction: row; }
.rp__left { width: 48%; margin-right: 20px; }
.rp__right { flex-grow: 1; }

.acct-chip { flex-direction: row; align-items: center; height: 64px; padding-right: 12px; background-color: var(--c-fill-soft); border-left-width: 3px; border-color: var(--accent); }
.acct-chip__av { width: 64px; height: 100%; margin-right: 12px; background-color: var(--accent-mid); }
.acct-chip__text { flex-grow: 1; flex-shrink: 1; }
.acct-chip__name { font-size: 18px; letter-spacing: 2px; color: var(--c-text); -unity-font-style: bold-and-italic; }
.acct-chip__mail { font-size: 9px; letter-spacing: 1px; color: var(--c-text-3); }

.section-label { margin: 12px 0 8px 0; }
.section-label--gap { margin-top: 16px; }
.name-field .unity-base-text-field__input { height: 60px; padding: 0 16px; color: var(--c-text); font-size: 26px; letter-spacing: 4px; background-color: var(--c-fill-soft); border-width: 0; border-bottom-width: 3px; border-color: var(--accent); -unity-font-style: bold-and-italic; }
.name-status { flex-direction: row; align-items: center; margin-top: 8px; }
.name-status__text { font-size: 11px; letter-spacing: 3px; color: var(--c-good); -unity-font-style: bold; }
.name-status__count { font-size: 11px; letter-spacing: 2px; color: var(--c-text-3); }
.hint { margin-top: 6px; font-size: 10px; letter-spacing: 2px; color: var(--c-text-3); white-space: normal; }

.starters { flex-direction: row; }
.st { flex-grow: 1; flex-basis: 0; height: 250px; margin-right: 8px; background-color: var(--c-fill-soft); border-bottom-width: 3px; border-color: var(--c-hair-strong); justify-content: flex-end; }
.st:last-child { margin-right: 0; }
.st--on { background-color: var(--accent-soft); border-color: var(--accent); }
.st__art { position: absolute; left: 0; top: 0; right: 0; height: 60%; overflow: hidden; }
.car__slash { position: absolute; right: 22%; top: -50%; width: 24px; height: 220%; rotate: 24deg; background-color: var(--c-fill-soft); }
.st__body { padding: 8px 10px; background-color: rgba(8, 13, 26, 0.86); }
.st__role { font-size: 9px; letter-spacing: 3px; color: var(--accent); -unity-font-style: bold; }
.st__name { font-size: 16px; letter-spacing: 2px; color: var(--c-text); -unity-font-style: bold-and-italic; }
.st__veh { flex-direction: row; align-items: center; margin: 2px 0 4px 0; }
.st__veh-dot { width: 5px; height: 5px; margin-right: 6px; rotate: 45deg; background-color: var(--c-text-3); }
.st__veh-text { font-size: 9px; letter-spacing: 1px; color: var(--c-text-2); }
.st__pick { font-size: 10px; letter-spacing: 3px; color: var(--c-text-3); }
.st__sel { flex-direction: row; align-items: center; }
.st__sel-text { font-size: 10px; letter-spacing: 3px; color: var(--accent); -unity-font-style: bold; }

.rp__foot { flex-direction: row; align-items: center; margin-top: 16px; padding-top: 12px; border-top-width: 1px; border-color: var(--c-hair); }
.cb { flex-direction: row; align-items: center; }
.cb__box { width: 24px; height: 24px; margin-right: 10px; align-items: center; justify-content: center; border-width: 2px; border-color: var(--c-text-3); }
.cb--on .cb__box { background-color: var(--accent); border-color: var(--accent); }
.cb__text { font-size: 10px; letter-spacing: 2px; color: var(--c-text-2); white-space: normal; }
.start { min-width: 300px; height: 72px; margin-left: 16px; }
.start .btn-cta__label { font-size: 26px; letter-spacing: 8px; }

/* ---------------------------------------------------------------------
   5. BOOT PROGRESS & MINIGAME BUTTON
   --------------------------------------------------------------------- */
.boot { flex-shrink: 0; margin-bottom: 12px; }
.boot__top { flex-direction: row; align-items: center; margin-bottom: 8px; }
.boot__tip-tag { margin-right: 12px; padding: 2px 8px; font-size: 10px; letter-spacing: 3px; color: var(--c-ink); background-color: var(--accent); -unity-font-style: bold; }
.boot__tip { font-size: 11px; letter-spacing: 2px; color: var(--c-text-2); -unity-font-style: bold; }
.boot__pct { font-size: 11px; letter-spacing: 3px; color: var(--accent); -unity-font-style: bold; }
.boot__bar { height: 4px; background-color: var(--c-fill-mid); }
.boot__fill { height: 100%; background-color: var(--accent); }

/* 2D Shooter Minigame Trigger Button */
.btn-minigame {
    flex-direction: row;
    align-items: center;
    height: 32px;
    margin-right: 18px;
    padding: 0 12px;
    background-color: var(--c-fill-soft);
    border-width: 1px;
    border-color: var(--accent);
}

.btn-minigame:hover {
    background-color: var(--accent-soft);
    scale: 1.05 1.05;
}

.minigame__icon {
    width: 10px;
    height: 10px;
    margin-right: 8px;
    rotate: 45deg;
    background-color: var(--accent);
}

.minigame__text {
    font-size: 10px;
    letter-spacing: 2px;
    color: var(--c-text);
    -unity-font-style: bold;
}

.btn-minigame:hover .minigame__text { color: var(--accent-hi); }

/* Footer */
.login-foot { flex-direction: row; align-items: center; flex-shrink: 0; padding-top: 10px; border-top-width: 1px; border-color: var(--c-hair); }
.foot__version { font-size: 10px; letter-spacing: 3px; color: var(--c-text-3); -unity-font-style: bold; }
.foot__status { flex-direction: row; align-items: center; margin-left: 20px; }
.foot__dot { width: 6px; height: 6px; margin-right: 8px; border-radius: 3px; background-color: var(--c-good); }
.foot__status-text { font-size: 10px; letter-spacing: 3px; color: var(--c-good); -unity-font-style: bold; }
.foot__btn { height: 36px; margin-left: 8px; padding: 0 16px; justify-content: center; background-color: var(--c-fill-soft); }
.foot__btn:hover { background-color: var(--accent-soft); }
.foot__btn-text { font-size: 10px; letter-spacing: 3px; color: var(--c-text-2); -unity-font-style: bold; }

/* ---------------------------------------------------------------------
   6. OVERLAYS
   --------------------------------------------------------------------- */
.modal-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(2, 5, 12, 0.84); }
.dlg { width: 560px; padding: 32px 36px; align-items: center; background-color: rgb(10, 16, 30); border-top-width: 3px; border-color: var(--accent); }
.dlg__bar { position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background-color: var(--accent); }
.dlg__title { margin-top: 2px; font-size: 40px; letter-spacing: 6px; color: var(--c-text); -unity-font-style: bold-and-italic; }
.dlg__text { margin-top: 6px; font-size: 12px; letter-spacing: 2px; color: var(--c-text-2); white-space: normal; -unity-text-align: upper-center; }
.dlg__code { margin-top: 10px; font-size: 10px; letter-spacing: 3px; color: var(--c-text-3); }
.dlg__btn { min-width: 200px; height: 60px; margin: 20px 6px 0 6px; }
.dlg__row { flex-direction: row; }
.spin { width: 90px; height: 90px; margin-bottom: 16px; border-radius: 45px; border-width: 5px; border-color: var(--c-fill-mid); }
.spin__arc { position: absolute; left: -5px; top: -5px; right: -5px; bottom: -5px; border-radius: 45px; border-width: 5px; border-color: rgba(0, 0, 0, 0); border-top-color: var(--accent); border-right-color: var(--accent); }