<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="Scrims" src="project://database/Assets/Ui Toolkit/Common/Components/Scrims.uxml"/>
    <ui:Template name="Currencies" src="project://database/Assets/Ui Toolkit/Common/Components/Currencies.uxml"/>
    <Style src="project://database/Assets/Ui Toolkit/Common/Common.uss"/>
    <Style src="project://database/Assets/Ui Toolkit/MainMenu/MainMenu.uss"/>
    <ui:VisualElement name="root" class="screen">
        <ui:VisualElement name="rotate-drag-zone" class="layer drag-zone" />
        <ui:Instance template="Scrims" picking-mode="Ignore" class="layer" />
        <ui:VisualElement picking-mode="Ignore" class="mm-cine">
            <ui:VisualElement picking-mode="Ignore" class="mm-shaft mm-shaft--a" />
            <ui:VisualElement picking-mode="Ignore" class="mm-shaft mm-shaft--b" />
            <ui:VisualElement picking-mode="Ignore" class="mm-vig mm-vig--b1" />
            <ui:VisualElement picking-mode="Ignore" class="mm-vig mm-vig--b2" />
            <ui:VisualElement picking-mode="Ignore" class="mm-vig mm-vig--b3" />
            <ui:VisualElement picking-mode="Ignore" class="mm-vig mm-vig--b4" />
            <ui:VisualElement picking-mode="Ignore" class="mm-vig mm-vig--b5" />
            <ui:VisualElement picking-mode="Ignore" class="mm-vig mm-vig--t1" />
            <ui:VisualElement picking-mode="Ignore" class="mm-vig mm-vig--t2" />
            <ui:VisualElement picking-mode="Ignore" class="mm-vig mm-vig--t3" />
            <ui:VisualElement picking-mode="Ignore" class="mm-vig mm-vig--r1" />
            <ui:VisualElement picking-mode="Ignore" class="mm-vig mm-vig--r2" />
            <ui:VisualElement picking-mode="Ignore" class="mm-vig mm-vig--r3" />
            <ui:VisualElement picking-mode="Ignore" class="mm-vig mm-vig--r4" />
            <ui:VisualElement picking-mode="Ignore" class="mm-vig mm-vig--r5" />
        </ui:VisualElement>
        <ui:VisualElement name="dd-catcher" class="layer dd-catcher dd--hidden" />
        <ui:VisualElement name="hud" picking-mode="Ignore" class="layer hud">
            <ui:VisualElement picking-mode="Ignore" class="top-bar">
<ui:Button name="btn-profile" class="btn profile accent-cyan">
    <ui:VisualElement picking-mode="Ignore" class="sheen" />
    <ui:VisualElement picking-mode="Ignore" class="avatar">
        <ui:VisualElement name="avatar-image" picking-mode="Ignore" class="avatar__img" />
        <ui:VisualElement picking-mode="Ignore" class="avatar__lvl">
            <ui:Label name="player-level" text="27" picking-mode="Ignore" class="avatar__lvl-text" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement picking-mode="Ignore" class="profile__info">
        <ui:VisualElement picking-mode="Ignore" class="profile__row">
            <ui:Label name="player-name" text="NOVA_RUNNER" picking-mode="Ignore" class="profile__name" />
            <ui:Label text="PLATINUM II" picking-mode="Ignore" class="profile__title" />
        </ui:VisualElement>
        <ui:VisualElement picking-mode="Ignore" class="profile__xp">
            <ui:VisualElement name="xp-fill" picking-mode="Ignore" class="profile__xp-fill" style="width: 62%;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:Button>
                <ui:VisualElement picking-mode="Ignore" class="top-right">
                    <ui:Instance template="Currencies" picking-mode="Ignore" />
                    <ui:Button name="btn-mail" class="btn mailbtn accent-amber">
                        <ui:VisualElement picking-mode="Ignore" class="mailbtn__env">
                            <ui:VisualElement picking-mode="Ignore" class="mailbtn__flap" />
                        </ui:VisualElement>
                        <ui:Label name="mail-badge" text="3" picking-mode="Ignore" class="mailbtn__badge" />
                    </ui:Button>
                    <ui:Button name="btn-settings" class="btn settings accent-cyan">
                        <ui:VisualElement picking-mode="Ignore" class="settings__bar settings__bar--a" />
                        <ui:VisualElement picking-mode="Ignore" class="settings__bar settings__bar--b" />
                        <ui:VisualElement picking-mode="Ignore" class="settings__bar settings__bar--c" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement picking-mode="Ignore" class="main-row">
                <ui:VisualElement name="col-center" picking-mode="Ignore" class="col-center">
                    <ui:VisualElement picking-mode="Ignore" class="stage__spacer" />
                    <ui:Label text="DRAG TO ROTATE SCENE" picking-mode="Ignore" class="drag-hint" />
                    <ui:VisualElement picking-mode="Ignore" class="stage">
                        <ui:VisualElement picking-mode="Ignore" class="subtle-dock">
                            <ui:Button name="btn-driver" class="btn subtle-pill accent-magenta">
                                <ui:Label text="PILOT:" picking-mode="Ignore" class="subtle-pill__label" />
                                <ui:Label name="driver-name" text="KAI NOVA" picking-mode="Ignore" class="subtle-pill__val" />
                            </ui:Button>
                            <ui:Button name="btn-vehicle" class="btn subtle-pill accent-cyan">
                                <ui:Label text="RIG:" picking-mode="Ignore" class="subtle-pill__label" />
                                <ui:Label name="vehicle-name-card" text="ZEPHYR GT-X" picking-mode="Ignore" class="subtle-pill__val" />
                            </ui:Button>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="col-right" picking-mode="Ignore" class="col-right">
                    <ui:VisualElement picking-mode="Ignore" class="promo">
                        <ui:Button name="btn-event" class="btn event accent-magenta">
                            <ui:VisualElement picking-mode="Ignore" class="event__art" />
                            <ui:VisualElement picking-mode="Ignore" class="event__slash event__slash--a" />
                            <ui:VisualElement picking-mode="Ignore" class="event__slash event__slash--b" />
                            <ui:VisualElement picking-mode="Ignore" class="event__shade" />
                            <ui:VisualElement picking-mode="Ignore" class="event__fade event__fade--1" />
                            <ui:VisualElement picking-mode="Ignore" class="event__fade event__fade--2" />
                            <ui:VisualElement picking-mode="Ignore" class="sheen" />
                            <ui:VisualElement picking-mode="Ignore" class="edge" />
                            <ui:VisualElement picking-mode="Ignore" class="event__body">
                                <ui:VisualElement picking-mode="Ignore" class="event__top">
                                    <ui:VisualElement picking-mode="Ignore" class="live">
                                        <ui:VisualElement picking-mode="Ignore" class="live__dot" />
                                        <ui:Label text="LIVE EVENT" picking-mode="Ignore" class="live__text" />
                                    </ui:VisualElement>
                                    <ui:Label name="event-timer" text="02D 14H 33M" picking-mode="Ignore" class="event__timer" />
                                </ui:VisualElement>
                                <ui:Label name="event-title" text="NEON GRAND PRIX" picking-mode="Ignore" class="event__title" />
                                <ui:Label text="WIN 5 RACES TO UNLOCK THE PHANTOM WRAP" picking-mode="Ignore" class="event__desc" />
                                <ui:VisualElement picking-mode="Ignore" class="event__track">
                                    <ui:VisualElement picking-mode="Ignore" class="event__bar">
                                        <ui:VisualElement picking-mode="Ignore" class="event__bar-fill" style="width: 58%;" />
                                    </ui:VisualElement>
                                    <ui:Label text="7 / 12" picking-mode="Ignore" class="event__count" />
                                    <ui:VisualElement picking-mode="Ignore" class="chevron" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:Button>
                        <ui:Button name="btn-missions" class="btn missions accent-amber">
                            <ui:VisualElement picking-mode="Ignore" class="sheen" />
                            <ui:VisualElement picking-mode="Ignore" class="edge" />
                            <ui:VisualElement picking-mode="Ignore" class="missions__icon">
                                <ui:VisualElement picking-mode="Ignore" class="missions__line missions__line--a" />
                                <ui:VisualElement picking-mode="Ignore" class="missions__line missions__line--b" />
                                <ui:VisualElement picking-mode="Ignore" class="missions__line missions__line--c" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="missions__text">
                                <ui:Label text="MISSIONS" picking-mode="Ignore" class="missions__title" />
                                <ui:Label text="DAILY 3/5   WEEKLY 1/4" picking-mode="Ignore" class="missions__sub" />
                            </ui:VisualElement>
                            <ui:Label name="missions-badge" text="2 READY" picking-mode="Ignore" class="missions__badge" />
                            <ui:VisualElement picking-mode="Ignore" class="chevron" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="spacer" />
                    <ui:VisualElement picking-mode="Ignore" class="nav">
                        <ui:Button name="btn-solo" class="btn nav-play accent-cyan">
                            <ui:VisualElement picking-mode="Ignore" class="nav-play__slash nav-play__slash--a" />
                            <ui:VisualElement picking-mode="Ignore" class="nav-play__slash nav-play__slash--b" />
                            <ui:VisualElement picking-mode="Ignore" class="sheen" />
                            <ui:VisualElement picking-mode="Ignore" class="nav-play__text">
                                <ui:Label text="01  /  CAMPAIGN" picking-mode="Ignore" class="nav-play__eyebrow" />
                                <ui:Label text="SOLO RACING" picking-mode="Ignore" class="nav-play__title" />
                                <ui:Label text="CHAPTER 7  /  NEON DISTRICT" picking-mode="Ignore" class="nav-play__sub" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="nav-play__arrow" />
                        </ui:Button>
                        <ui:Button name="btn-multiplayer" class="btn nav-card accent-magenta">
                            <ui:VisualElement picking-mode="Ignore" class="sheen" />
                            <ui:VisualElement picking-mode="Ignore" class="edge" />
                            <ui:VisualElement picking-mode="Ignore" class="nav-card__text">
                                <ui:Label text="02  /  RANKED" picking-mode="Ignore" class="eyebrow eyebrow--accent" />
                                <ui:Label text="MULTIPLAYER" picking-mode="Ignore" class="nav-card__title" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="nav-card__online">
                                <ui:Label text="12,480" picking-mode="Ignore" class="nav-card__online-num" />
                                <ui:Label text="ONLINE" picking-mode="Ignore" class="nav-card__online-lbl" />
                            </ui:VisualElement>
                        </ui:Button>
                        <ui:VisualElement picking-mode="Ignore" class="nav-row">
                            <ui:Button name="btn-garage" class="btn nav-tile accent-cyan">
                                <ui:VisualElement picking-mode="Ignore" class="sheen" />
                                <ui:VisualElement picking-mode="Ignore" class="edge" />
                                <ui:Label text="03" picking-mode="Ignore" class="eyebrow eyebrow--accent" />
                                <ui:Label text="GARAGE" picking-mode="Ignore" class="nav-tile__title" />
                            </ui:Button>
                            <ui:Button name="btn-shop" class="btn nav-tile accent-amber">
                                <ui:VisualElement picking-mode="Ignore" class="sheen" />
                                <ui:VisualElement picking-mode="Ignore" class="edge" />
                                <ui:Label text="04" picking-mode="Ignore" class="eyebrow eyebrow--accent" />
                                <ui:Label text="SHOP" picking-mode="Ignore" class="nav-tile__title" />
                                <ui:Label text="SALE" picking-mode="Ignore" class="tag tag--sale nav-tile__badge" />
                            </ui:Button>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="settings-dropdown" picking-mode="Ignore" class="dd dd--hidden accent-cyan">
                <ui:Button name="btn-dd-settings" class="btn dd__item accent-cyan">
                    <ui:VisualElement picking-mode="Ignore" class="sheen" />
                    <ui:VisualElement picking-mode="Ignore" class="edge" />
                    <ui:Label text="SETTINGS" picking-mode="Ignore" class="dd__label" />
                    <ui:VisualElement picking-mode="Ignore" class="chevron" />
                </ui:Button>
                <ui:Button name="btn-dd-support" class="btn dd__item accent-amber">
                    <ui:VisualElement picking-mode="Ignore" class="sheen" />
                    <ui:VisualElement picking-mode="Ignore" class="edge" />
                    <ui:Label text="SUPPORT" picking-mode="Ignore" class="dd__label" />
                    <ui:VisualElement picking-mode="Ignore" class="chevron" />
                </ui:Button>
                <ui:Button name="btn-dd-faq" class="btn dd__item accent-magenta">
                    <ui:VisualElement picking-mode="Ignore" class="sheen" />
                    <ui:VisualElement picking-mode="Ignore" class="edge" />
                    <ui:Label text="FAQ" picking-mode="Ignore" class="dd__label" />
                    <ui:VisualElement picking-mode="Ignore" class="chevron" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>