/* =====================================================================
   MAIN MENU  (requires Common.uss)  /  CINEMATIC LAYOUT
   ===================================================================== */

/* ---------------------------------------------------------------------
   1. LAYOUT
   --------------------------------------------------------------------- */
.top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    flex-shrink: 0;
}

.top-right {
    flex-direction: row;
    align-items: center;
}

.main-row {
    flex-direction: row;
    flex-grow: 1;
    margin-top: 20px;
}

.col-center {
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: flex-end;
    align-items: center;
    margin: 0 36px 0 0;
}

.col-right {
    width: 34%;
    min-width: 520px;
    max-width: 650px;
    flex-shrink: 0;
}

.promo { flex-shrink: 0; }
.nav { flex-shrink: 0; }

/* ---------------------------------------------------------------------
   1b. CINEMATIC GRADING
   --------------------------------------------------------------------- */
.mm-cine { position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden; }
.mm-vig { position: absolute; background-color: rgba(3, 6, 13, 0.10); }
.mm-vig--b1 { left: 0; right: 0; bottom: 0; height: 58%; }
.mm-vig--b2 { left: 0; right: 0; bottom: 0; height: 44%; }
.mm-vig--b3 { left: 0; right: 0; bottom: 0; height: 32%; }
.mm-vig--b4 { left: 0; right: 0; bottom: 0; height: 21%; }
.mm-vig--b5 { left: 0; right: 0; bottom: 0; height: 11%; }
.mm-vig--t1 { left: 0; right: 0; top: 0; height: 24%; }
.mm-vig--t2 { left: 0; right: 0; top: 0; height: 15%; }
.mm-vig--t3 { left: 0; right: 0; top: 0; height: 7%; }
.mm-vig--r1 { top: 0; bottom: 0; right: 0; width: 46%; }
.mm-vig--r2 { top: 0; bottom: 0; right: 0; width: 37%; }
.mm-vig--r3 { top: 0; bottom: 0; right: 0; width: 28%; }
.mm-vig--r4 { top: 0; bottom: 0; right: 0; width: 19%; }
.mm-vig--r5 { top: 0; bottom: 0; right: 0; width: 10%; }

.mm-shaft { position: absolute; top: -60%; height: 240%; rotate: 24deg; }
.mm-shaft--a { right: 34%; width: 220px; background-color: rgba(255, 255, 255, 0.02); }
.mm-shaft--b { right: 31%; width: 6px;   background-color: rgba(0, 229, 255, 0.10); }

/* ---------------------------------------------------------------------
   2. PROFILE + SETTINGS (Playful Arcade Badge Redesign)
   --------------------------------------------------------------------- */
.profile {
    flex-direction: row;
    align-items: center;
    padding: 14px 40px 14px 14px;
    background-color: var(--c-surface);
    border-left-width: 5px;
    border-color: var(--accent);
    transform-origin: 0% 50%;
    transition-property: background-color, scale, border-color;
    transition-duration: 0.2s;
}

.profile:focus { border-color: var(--accent); }
.profile:hover { background-color: var(--c-surface-hi); scale: 1.04 1.04; }

.avatar {
    width: 84px;
    height: 84px;
    background-color: var(--accent-soft);
    border-radius: 8px;
    border-width: 2px;
    border-color: var(--accent);
}

.avatar__img {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.avatar__lvl {
    position: absolute;
    top: -10px;
    right: -10px;
    min-width: 38px;
    height: 30px;
    padding: 0 6px;
    background-color: var(--accent);
    justify-content: center;
    rotate: 10deg;
    border-radius: 4px;
}

.avatar__lvl-text {
    font-size: 19px;
    color: var(--c-ink);
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-center;
}

.profile__info {
    min-width: 220px;
    margin-left: 22px;
}

.profile__name {
    font-size: 28px;
    letter-spacing: 5px;
    color: var(--c-text);
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

.profile__title {
    font-size: 13px;
    letter-spacing: 6px;
    color: var(--accent);
    -unity-font-style: bold;
    margin-top: 3px;
    -unity-text-align: middle-left;
}

.profile__xp {
    height: 5px;
    margin-top: 10px;
    background-color: var(--c-fill-mid);
    border-radius: 2px;
}

.profile__xp-fill {
    height: 100%;
    background-color: var(--accent);
}

.settings {
    width: 56px;
    height: 56px;
    margin-left: 12px;
    align-items: center;
    justify-content: center;
    background-color: var(--c-surface);
}

.settings:hover { background-color: var(--accent); scale: 1.1 1.1; }

.settings__bar {
    height: 3px;
    margin: 3px 0 3px 0;
    background-color: var(--accent);
    transition-property: width, background-color;
    transition-duration: 0.18s;
}

.settings__bar--a { width: 24px; }
.settings__bar--b { width: 16px; }
.settings__bar--c { width: 24px; }
.settings:hover .settings__bar { background-color: var(--c-ink); width: 26px; }

/* ---------------------------------------------------------------------
   2b. MAIL BUTTON + SETTINGS DROPDOWN
   --------------------------------------------------------------------- */
.mailbtn {
    width: 56px;
    height: 56px;
    margin-left: 12px;
    align-items: center;
    justify-content: center;
    background-color: var(--c-surface);
}

.mailbtn:hover { background-color: var(--accent); scale: 1.1 1.1; }

.mailbtn__env {
    width: 28px;
    height: 20px;
    border-width: 3px;
    border-color: var(--accent);
    overflow: hidden;
    transition-property: border-color;
    transition-duration: 0.18s;
}

.mailbtn__flap {
    position: absolute;
    left: 3px;
    top: -9px;
    width: 14px;
    height: 14px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-color: var(--accent);
    rotate: 45deg;
    transition-property: border-color;
    transition-duration: 0.18s;
}

.mailbtn:hover .mailbtn__env,
.mailbtn:hover .mailbtn__flap { border-color: var(--c-ink); }

.mailbtn__badge {
    position: absolute;
    top: -6px;
    right: -6px;
    min-width: 22px;
    height: 22px;
    padding: 0 5px;
    font-size: 12px;
    color: var(--c-ink);
    background-color: rgb(255, 82, 96);
    border-radius: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.mailbtn__badge--hidden { display: none; }

/* Full-screen click-away layer (under the HUD) */
.dd-catcher { background-color: rgba(0, 0, 0, 0); }

.dd {
    position: absolute;
    top: 112px;
    right: 40px;
    width: 340px;
    padding: 8px;
    background-color: rgb(12, 20, 38);
    border-top-width: 3px;
    border-color: var(--accent);
    transform-origin: 100% 0%;
}

.dd--hidden { display: none; }

.dd__item {
    flex-direction: row;
    align-items: center;
    height: 72px;
    margin-bottom: 6px;
    padding: 0 20px 0 24px;
    background-color: var(--c-surface);
}

.dd__item:last-child { margin-bottom: 0; }
.dd__item .edge { width: 0; }
.dd__item:hover { background-color: var(--c-surface-hi); translate: -6px 0; }
.dd__item:hover .edge { width: 5px; }

.dd__label {
    flex-grow: 1;
    font-size: 22px;
    letter-spacing: 5px;
    color: var(--c-text);
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

/* ---------------------------------------------------------------------
   3. EVENT BANNER
   --------------------------------------------------------------------- */
.event {
    height: 236px;
    background-color: var(--c-surface);
    transform-origin: 100% 50%;
}

.event:hover { background-color: var(--c-surface-hi); scale: 1.025 1.025; }

.event__art {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--accent-soft);
    -unity-background-scale-mode: scale-and-crop;
    transition-property: background-color;
    transition-duration: 0.25s;
}

.event:hover .event__art { background-color: var(--accent-mid); }

.event__slash {
    position: absolute;
    top: -60%;
    height: 240%;
    rotate: 24deg;
    transition-property: translate;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

.event__slash--a { right: 14%; width: 70px; background-color: var(--accent-soft); }
.event__slash--b { right: 5%;  width: 14px; background-color: var(--accent-mid); }
.event:hover .event__slash { translate: -26px 0; }

.event__shade {
    position: absolute;
    left: -30%;
    top: -50%;
    width: 78%;
    height: 200%;
    rotate: 24deg;
    background-color: rgba(3, 6, 13, 0.62);
}

.event__fade { position: absolute; left: 0; right: 0; bottom: 0; background-color: rgba(3, 6, 13, 0.16); }
.event__fade--1 { height: 55%; }
.event__fade--2 { height: 28%; }

.event__body {
    flex-grow: 1;
    padding: 18px 24px 18px 28px;
}

.event__top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.live {
    flex-direction: row;
    align-items: center;
    padding: 4px 12px 4px 10px;
    background-color: var(--accent);
}

.live__dot {
    width: 8px;
    height: 8px;
    margin-right: 8px;
    border-radius: 4px;
    background-color: var(--c-ink);
}

.live__text {
    font-size: 12px;
    letter-spacing: 4px;
    color: var(--c-ink);
    -unity-font-style: bold;
}

.event__timer {
    font-size: 18px;
    letter-spacing: 3px;
    color: var(--c-text);
    -unity-font-style: bold;
}

.event__title {
    margin-top: 14px;
    font-size: 46px;
    letter-spacing: 6px;
    color: var(--c-text);
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

.event__desc {
    font-size: 13px;
    letter-spacing: 3px;
    color: var(--c-text-2);
    -unity-text-align: middle-left;
}

.event__track {
    flex-direction: row;
    align-items: center;
    margin-top: auto;
}

.event__bar {
    flex-grow: 1;
    height: 6px;
    background-color: var(--c-fill-mid);
}

.event__bar-fill {
    height: 100%;
    background-color: var(--accent);
}

.event__count {
    margin: 0 20px 0 14px;
    font-size: 16px;
    letter-spacing: 2px;
    color: var(--c-text);
    -unity-font-style: bold;
}

/* ---------------------------------------------------------------------
   4. MISSIONS
   --------------------------------------------------------------------- */
.missions {
    flex-direction: row;
    align-items: center;
    height: 84px;
    margin-top: 10px;
    padding: 0 24px 0 28px;
    background-color: var(--c-surface);
    transform-origin: 100% 50%;
}

.missions:hover { background-color: var(--c-surface-hi); scale: 1.025 1.025; }

.missions__icon { width: 34px; margin-right: 22px; }

.missions__line {
    height: 4px;
    margin: 4px 0 4px 0;
    background-color: var(--accent);
}

.missions__line--a { width: 34px; }
.missions__line--b { width: 24px; }
.missions__line--c { width: 29px; }

.missions__text { flex-grow: 1; }

.missions__title {
    font-size: 24px;
    letter-spacing: 6px;
    color: var(--c-text);
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

.missions__sub {
    font-size: 13px;
    letter-spacing: 3px;
    color: var(--c-text-2);
    -unity-text-align: middle-left;
}

.missions__badge {
    margin-right: 20px;
    padding: 4px 12px 4px 12px;
    font-size: 12px;
    letter-spacing: 3px;
    color: var(--c-ink);
    background-color: var(--accent);
    -unity-font-style: bold;
}

/* ---------------------------------------------------------------------
   5. STAGE DOCK (Centered Touch Selection, Rotators Removed)
   --------------------------------------------------------------------- */
.stage {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 700px;
    height: 52px;
}

.stage__spacer {
    flex-grow: 1;
}

.subtle-dock {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    margin: 0;
}

.subtle-pill {
    background-color: rgba(13, 18, 30, 0.75);
    border-width: 0;
    border-bottom-width: 2px;
    border-color: var(--accent);
    padding: 8px 24px;
    margin: 0 8px;
    flex-direction: row;
    align-items: center;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.2s;
}

.subtle-pill:hover {
    background-color: var(--c-surface-hi);
    scale: 1.04 1.04;
}

.subtle-pill__label {
    font-size: 11px;
    letter-spacing: 4px;
    color: var(--c-text-3);
    -unity-font-style: bold;
    margin-right: 10px;
}

.subtle-pill__val {
    font-size: 14px;
    letter-spacing: 3px;
    color: var(--c-text);
    -unity-font-style: bold-and-italic;
}

.subtle-pill:hover .subtle-pill__val {
    color: var(--accent);
}

.drag-hint {
    font-size: 11px;
    letter-spacing: 5px;
    color: var(--c-text-3);
    margin-top: 8px;
    -unity-font-style: bold;
}

/* ---------------------------------------------------------------------
   7. NAVIGATION
   --------------------------------------------------------------------- */
.nav-play {
    flex-direction: row;
    align-items: center;
    height: 172px;
    margin-bottom: 12px;
    padding: 0 34px 0 38px;
    background-color: var(--accent);
    transform-origin: 100% 50%;
}

.nav-play:hover { background-color: var(--accent-hi); scale: 1.05 1.05; translate: -10px 0; }
.nav-play .sheen { background-color: rgba(255, 255, 255, 0.3); }

.nav-play__slash {
    position: absolute;
    top: -60%;
    height: 240%;
    rotate: 24deg;
    background-color: rgba(3, 6, 13, 0.14);
    transition-property: translate;
    transition-duration: 0.3s;
}

.nav-play__slash--a { right: 20%; width: 64px; }
.nav-play__slash--b { right: 11%; width: 12px; background-color: rgba(3, 6, 13, 0.30); }
.nav-play:hover .nav-play__slash { translate: -34px 0; }

.nav-play__text { flex-grow: 1; }

.nav-play__eyebrow {
    font-size: 14px;
    letter-spacing: 6px;
    color: rgba(3, 6, 13, 0.7);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.nav-play__title {
    font-size: 48px;
    letter-spacing: 6px;
    color: var(--c-ink);
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.nav-play__sub {
    font-size: 14px;
    letter-spacing: 4px;
    color: rgba(3, 6, 13, 0.7);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.nav-play__arrow {
    width: 30px;
    height: 30px;
    border-right-width: 6px;
    border-top-width: 6px;
    border-color: var(--c-ink);
    rotate: 45deg;
    transition-property: translate;
    transition-duration: 0.22s;
}

.nav-play:hover .nav-play__arrow { translate: 10px 0; }

.nav-card {
    flex-direction: row;
    align-items: center;
    height: 118px;
    margin: 0 0 12px 28px;
    padding: 0 28px 0 32px;
    background-color: var(--c-surface);
    transform-origin: 100% 50%;
}

.nav-card:hover { background-color: var(--c-surface-hi); scale: 1.05 1.05; translate: -10px 0; }
.nav-card__text { flex-grow: 1; }

.nav-card__title {
    font-size: 38px;
    letter-spacing: 6px;
    color: var(--c-text);
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

.nav-card__online { align-items: flex-end; }
.nav-card__online-num { font-size: 24px; letter-spacing: 2px; color: var(--accent); -unity-font-style: bold; }
.nav-card__online-lbl { font-size: 11px; letter-spacing: 4px; color: var(--c-text-3); -unity-font-style: bold; }

.nav-row {
    flex-direction: row;
    margin-left: 56px;
}

.nav-tile {
    flex-grow: 1;
    flex-basis: 0;
    height: 112px;
    margin-right: 12px;
    padding: 0 20px 0 26px;
    justify-content: center;
    background-color: var(--c-surface);
    transform-origin: 100% 50%;
}

.nav-tile:last-child { margin-right: 0; }
.nav-tile:hover { background-color: var(--c-surface-hi); scale: 1.07 1.07; translate: 0 -4px; }
.nav-tile__title { font-size: 32px; letter-spacing: 6px; color: var(--c-text); -unity-font-style: bold-and-italic; -unity-text-align: middle-left; }
.nav-tile__badge { position: absolute; top: 10px; right: 10px; }