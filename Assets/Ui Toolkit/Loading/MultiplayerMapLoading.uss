/* =====================================================================
   LOADING SCREEN USS
   ===================================================================== */

/* Dynamic Fullscreen Background Art */
.loading-art {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--c-surface);
    -unity-background-scale-mode: scale-and-crop;
    transition-property: background-image;
    transition-duration: 0.5s;
}

.loading-hud {
    padding: 60px 80px;
    justify-content: space-between;
}

/* Header Text */
.loading-header {
    max-width: 800px;
}

.loading-title {
    font-size: 72px;
    letter-spacing: 10px;
    color: var(--c-text);
    -unity-font-style: bold-and-italic;
    white-space: nowrap;
}

.loading-subtitle {
    font-size: 16px;
    letter-spacing: 4px;
    color: rgb(255, 190, 0);
    -unity-font-style: bold;
}

/* Bottom Progress Deck */
.loading-deck {
    width: 100%;
    max-width: 960px;
}

/* Tip Box Container */

.tip-box {
    padding: 18px 24px;
    margin-bottom: 24px;
    background-color: var(--c-surface);
    border-left-width: 5px;
    border-color: var(--accent);
}

/* Bumped header label for better hierarchy */
.tip-box .eyebrow {
    font-size: 13px;
    letter-spacing: 3px;
    margin-bottom: 6px;
}

/* Increased font size from 15px -> 18px & relaxed line height/spacing */
.tip-box__text {
    font-size: 18px;
    letter-spacing: 1.5px;
    color: var(--c-text);
    white-space: normal;
    -unity-font-style: bold;
}
/* Progress Row Layout */
.progress-row {
    flex-direction: row;
    align-items: center;
}

/* Spinner Element */
.spinner-ring {
    width: 48px;
    height: 48px;
    margin-right: 20px;
    border-radius: 24px;
    border-width: 4px;
    border-color: var(--c-fill-mid);
}

.spinner-arc {
    position: absolute;
    left: -4px; top: -4px; right: -4px; bottom: -4px;
    border-radius: 24px;
    border-width: 4px;
    border-color: rgba(0, 0, 0, 0);
    border-top-color: var(--accent);
    rotate: 45deg;
}

/* Progress Bar Meta & Fill */
.loading-pbar-container {
    flex-grow: 1;
}

.loading-pbar__meta {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 8px;
}

.loading-status {
    font-size: 13px;
    letter-spacing: 3px;
    color: var(--c-text-2);
    -unity-font-style: bold;
}

.loading-percent {
    font-size: 16px;
    letter-spacing: 2px;
    color: var(--accent);
    -unity-font-style: bold-and-italic;
}

.pbar--thick {
    height: 12px;
    background-color: var(--c-fill-mid);
}

/* Continue CTA Button */
.continue-btn {
    width: 100%;
    height: 80px;
    margin-top: 16px;
    justify-content: center;
    align-items: center;
}

.continue-btn .btn-cta__label {
    font-size: 26px;
    letter-spacing: 6px;
}

/* =====================================================================
   MULTIPLAYER STARTING GRID (racers' driver + vehicle choices)
   Two staggered columns like a real starting grid: odd positions on the
   left, even positions on the right and one step back.
   ===================================================================== */
.racers {
    position: absolute;
    right: 80px;
    top: 60px;
    width: 860px;
}

.racers__head { flex-direction: row; align-items: center; margin-bottom: 12px; }

.racers__loaded {
    font-size: 13px;
    letter-spacing: 4px;
    color: var(--c-text-2);
    -unity-font-style: bold;
    text-shadow: 0px 2px 6px rgba(0, 0, 0, 0.9);
}

.racers__cols { flex-direction: row; }
.racers__col { width: 420px; margin-right: 20px; }
.racers__col--b { margin-top: 54px; margin-right: 0; }

.racer {
    flex-direction: row;
    align-items: center;
    height: 118px;
    margin-bottom: 10px;
    padding: 0 16px 0 0;
    background-color: rgba(6, 10, 20, 0.78);
    border-left-width: 3px;
    border-color: var(--c-hair-strong);
}

.racer--me { background-color: rgba(0, 229, 255, 0.16); border-color: var(--accent); }

.racer__pos {
    width: 46px;
    font-size: 20px;
    letter-spacing: 1px;
    color: var(--c-text-2);
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-center;
}

.racer--me .racer__pos { color: var(--accent); }

/* Driver portrait with the vehicle thumbnail overlapping its corner */
.racer__art { width: 98px; height: 98px; margin-right: 16px; flex-shrink: 0; }

/* IMAGE SLOT: driver portrait */
.racer__portrait {
    position: absolute;
    left: 0;
    top: 0;
    width: 88px;
    height: 88px;
    overflow: hidden;
    -unity-background-scale-mode: scale-and-crop;
}

/* IMAGE SLOT: vehicle preview */
.racer__car {
    position: absolute;
    right: -14px;
    bottom: -4px;
    width: 76px;
    height: 44px;
    overflow: hidden;
    border-width: 2px;
    border-color: var(--c-text);
    -unity-background-scale-mode: scale-and-crop;
}

.racer__text { flex-grow: 1; flex-shrink: 1; margin-left: 8px; }
.racer__who { flex-direction: row; align-items: center; }

.racer__pilot {
    font-size: 17px;
    letter-spacing: 3px;
    color: var(--c-text);
    white-space: nowrap;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

.racer__you { margin-left: 8px; }

.racer__driver {
    font-size: 11px;
    letter-spacing: 4px;
    color: var(--accent);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.racer__veh { flex-direction: row; align-items: center; margin-top: 2px; }
.racer__veh-dot { width: 6px; height: 6px; margin-right: 8px; rotate: 45deg; background-color: var(--c-text-3); }

.racer__veh-text {
    font-size: 11px;
    letter-spacing: 3px;
    color: var(--c-text-2);
    white-space: nowrap;
    -unity-font-style: bold;
}

.racer__side { width: 92px; flex-shrink: 0; align-items: flex-end; }

.racer__rank {
    margin-bottom: 8px;
    font-size: 11px;
    letter-spacing: 3px;
    color: rgb(255, 190, 0);
    -unity-font-style: bold;
}

.racer__ok { flex-direction: row; align-items: center; }
.racer__ok .check { margin: 0 8px 2px 0; border-color: var(--c-good); }
.racer__ok-text { font-size: 10px; letter-spacing: 3px; color: var(--c-good); -unity-font-style: bold; }

.racer__load { width: 100%; align-items: flex-end; }
.racer__bar { width: 100%; height: 5px; background-color: var(--c-fill-mid); }
.racer__fill { height: 100%; background-color: var(--accent); }
.racer__pct { margin-top: 4px; font-size: 10px; letter-spacing: 2px; color: var(--c-text-2); -unity-font-style: bold; }

.car__slash { position: absolute; right: 22%; top: -50%; width: 20px; height: 220%; rotate: 24deg; background-color: var(--c-fill-soft); }
