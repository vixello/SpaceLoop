<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="Scrims" src="project://database/Assets/Ui%20Toolkit/Common/Components/Scrims.uxml?fileID=9197481963319205126&amp;guid=b8d0443616d7dbb44b0593bbb8f9b959&amp;type=3#Scrims" />
    <ui:Template name="ScreenHeader" src="project://database/Assets/Ui%20Toolkit/Common/Components/ScreenHeader.uxml?fileID=9197481963319205126&amp;guid=1894d762554522c48b2121541c7adca5&amp;type=3#ScreenHeader" />
    <Style src="project://database/Assets/Ui%20Toolkit/Common/Common.uss?fileID=7433441132597879392&amp;guid=f1e0c419fffe5c54ea31b5bd59f0c918&amp;type=3#Common" />
    <Style src="project://database/Assets/Ui%20Toolkit/Mail/Mail.uss?fileID=7433441132597879392&amp;guid=265ad8717cbbced469117cca3aa4932e&amp;type=3#Mail" />
    <ui:VisualElement name="root" class="screen">
        <ui:VisualElement name="rotate-drag-zone" class="layer drag-zone" />
        <ui:Instance template="Scrims" picking-mode="Ignore" class="layer" />
        <ui:VisualElement name="hud" picking-mode="Ignore" class="layer hud">
            <ui:Instance template="ScreenHeader" name="screen-header" picking-mode="Ignore">
                <AttributeOverrides element-name="screen-eyebrow" text="INBOX  /  REWARDS  /  NEWS" />
                <AttributeOverrides element-name="screen-title" text="MAIL" />
            </ui:Instance>
            <ui:VisualElement picking-mode="Ignore" class="body mail-body">
                <ui:VisualElement picking-mode="Ignore" class="minbox">
                    <ui:VisualElement picking-mode="Ignore" class="minbox__head">
                        <ui:VisualElement picking-mode="Ignore" class="mlist__title">
                            <ui:Label text="INBOX" picking-mode="Ignore" class="eyebrow eyebrow--accent" />
                            <ui:Label text="42 / 100" name="mail-count" picking-mode="Ignore" class="mlist__count" />
                        </ui:VisualElement>
                        <ui:VisualElement picking-mode="Ignore" class="spacer" />
                        <ui:VisualElement picking-mode="Ignore" class="mfilters">
                            <ui:Button name="filter-all" class="btn chip chip--active">
                                <ui:Label text="ALL" picking-mode="Ignore" class="chip__label" />
                            </ui:Button>
                            <ui:Button name="filter-rewards" class="btn chip">
                                <ui:Label text="REWARDS" picking-mode="Ignore" class="chip__label" />
                            </ui:Button>
                            <ui:Button name="filter-news" class="btn chip">
                                <ui:Label text="NEWS" picking-mode="Ignore" class="chip__label" />
                            </ui:Button>
                            <ui:Button name="filter-system" class="btn chip">
                                <ui:Label text="SYSTEM" picking-mode="Ignore" class="chip__label" />
                            </ui:Button>
                        </ui:VisualElement>
                        <ui:VisualElement picking-mode="Ignore" class="spacer" />
                        <ui:Label name="mail-count" text="3 UNREAD" picking-mode="Ignore" class="minbox__count" />
                    </ui:VisualElement>
                    
                    <!-- Selection Controls Bar (Visible in Checkbox Mode) -->
                    <ui:VisualElement name="selection-bar" class="mlist__selection-bar mlist__selection-bar--hidden">
                        <ui:Label name="selected-count" text="0 SELECTED" class="mlist__selected-count" />
                        <ui:VisualElement class="spacer" />
                        <ui:VisualElement class="mlist__selection-buttons">
                            <ui:Button name="btn-select-all" class="btn chip chip--small">
                                <ui:Label text="SELECT ALL" picking-mode="Ignore" class="chip__label" />
                            </ui:Button>
                            <ui:Button name="btn-deselect-all" class="btn chip chip--small">
                                <ui:Label text="DESELECT ALL" picking-mode="Ignore" class="chip__label" />
                            </ui:Button>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:ScrollView name="mail-list" touch-scroll-type="Elastic" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" class="mlist">
                        <ui:Button name="mail-0" class="btn mrow mrow--on mrow--unread accent-amber">
                            <ui:VisualElement picking-mode="Ignore" class="sheen" />
                            <ui:VisualElement picking-mode="Ignore" class="edge" />
                            <ui:VisualElement name="mail-checkbox" picking-mode="Ignore" class="mrow__checkbox" style="display: none;">
                                <ui:VisualElement picking-mode="Ignore" class="mrow__checkbox-inner" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="mrow__dot" />
                            <ui:VisualElement picking-mode="Ignore" class="mrow__text">
                                <ui:Label text="NEON GRAND PRIX" picking-mode="Ignore" class="mrow__from" />
                                <ui:Label text="YOUR WEEKLY REWARDS ARE READY" picking-mode="Ignore" class="mrow__subject" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="mrow__side">
                                <ui:Label text="TODAY" picking-mode="Ignore" class="mrow__date" />
                                <ui:Label text="REWARD" picking-mode="Ignore" class="tag tag--accent mrow__tag" />
                            </ui:VisualElement>
                        </ui:Button>
                        <ui:Button name="mail-1" class="btn mrow mrow--unread accent-cyan">
                            <ui:VisualElement picking-mode="Ignore" class="sheen" />
                            <ui:VisualElement picking-mode="Ignore" class="edge" />
                            <ui:VisualElement name="mail-checkbox" picking-mode="Ignore" class="mrow__checkbox" style="display: none;">
                                <ui:VisualElement picking-mode="Ignore" class="mrow__checkbox-inner" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="mrow__dot" />
                            <ui:VisualElement picking-mode="Ignore" class="mrow__text">
                                <ui:Label text="APEX VELOCITY TEAM" picking-mode="Ignore" class="mrow__from" />
                                <ui:Label text="PATCH 0.9.4 IS LIVE" picking-mode="Ignore" class="mrow__subject" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="mrow__side">
                                <ui:Label text="YESTERDAY" picking-mode="Ignore" class="mrow__date" />
                                <ui:Label text="NEWS" picking-mode="Ignore" class="tag mrow__tag" />
                            </ui:VisualElement>
                        </ui:Button>
                        <ui:Button name="mail-2" class="btn mrow mrow--unread accent-magenta">
                            <ui:VisualElement picking-mode="Ignore" class="sheen" />
                            <ui:VisualElement picking-mode="Ignore" class="edge" />
                            <ui:VisualElement name="mail-checkbox" picking-mode="Ignore" class="mrow__checkbox" style="display: none;">
                                <ui:VisualElement picking-mode="Ignore" class="mrow__checkbox-inner" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="mrow__dot" />
                            <ui:VisualElement picking-mode="Ignore" class="mrow__text">
                                <ui:Label text="SUPPORT" picking-mode="Ignore" class="mrow__from" />
                                <ui:Label text="RE: BUG REPORT #20418" picking-mode="Ignore" class="mrow__subject" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="mrow__side">
                                <ui:Label text="12 OCT" picking-mode="Ignore" class="mrow__date" />
                            </ui:VisualElement>
                        </ui:Button>
                        <ui:Button name="mail-3" class="btn mrow accent-amber">
                            <ui:VisualElement picking-mode="Ignore" class="sheen" />
                            <ui:VisualElement picking-mode="Ignore" class="edge" />
                            <ui:VisualElement name="mail-checkbox" picking-mode="Ignore" class="mrow__checkbox" style="display: none;">
                                <ui:VisualElement picking-mode="Ignore" class="mrow__checkbox-inner" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="mrow__dot" />
                            <ui:VisualElement picking-mode="Ignore" class="mrow__text">
                                <ui:Label text="WELCOME PACK" picking-mode="Ignore" class="mrow__from" />
                                <ui:Label text="THANKS FOR JOINING, PILOT" picking-mode="Ignore" class="mrow__subject" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="mrow__side">
                                <ui:Label text="03 MAR" picking-mode="Ignore" class="mrow__date" />
                                <ui:Label text="CLAIMED" picking-mode="Ignore" class="tag tag--accent mrow__tag" />
                            </ui:VisualElement>
                        </ui:Button>
                    </ui:ScrollView>
                    <ui:VisualElement picking-mode="Ignore" class="minbox__foot">
                        <ui:VisualElement name="delete-mode-row" picking-mode="Ignore" class="minbox__foot-row minbox__foot-row--hidden">
                            <ui:Button name="btn-delete-selected" class="btn btn-ghost minbox__btn accent-magenta">
                                <ui:VisualElement picking-mode="Ignore" class="sheen" />
                                <ui:Label text="DELETE SELECTED (0)" picking-mode="Ignore" class="btn-ghost__label" />
                            </ui:Button>
                        </ui:VisualElement>
                        <ui:VisualElement picking-mode="Ignore" class="minbox__foot-actions">
                            <ui:Button name="btn-claim-all" class="btn btn-cta mlist__claim accent-amber">
                                <ui:VisualElement picking-mode="Ignore" class="sheen" />
                                <ui:VisualElement picking-mode="Ignore" class="mlist__claim-content">
                                    <ui:Label text="CLAIM ALL" picking-mode="Ignore" class="btn-cta__label" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Button name="btn-mark-read" class="btn btn-ghost minbox__btn accent-cyan">
                                <ui:VisualElement picking-mode="Ignore" class="sheen" />
                                <ui:Label text="MARK AS READ" picking-mode="Ignore" class="btn-ghost__label" />
                            </ui:Button>
                            <ui:Button name="btn-delete-read" class="btn btn-ghost minbox__btn accent-magenta">
                                <ui:VisualElement picking-mode="Ignore" class="sheen" />
                                <ui:Label text="DELETE READ" picking-mode="Ignore" class="btn-ghost__label" />
                            </ui:Button>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="mail-reader" picking-mode="Ignore" class="mread accent-amber">
                    <ui:VisualElement picking-mode="Ignore" class="mread__top">
                        <ui:Label name="mail-from" text="NEON GRAND PRIX" picking-mode="Ignore" class="eyebrow eyebrow--accent" />
                        <ui:VisualElement picking-mode="Ignore" class="spacer" />
                        <ui:Label name="mail-date" text="TODAY  /  09:12" picking-mode="Ignore" class="mread__date" />
                        <ui:Button name="btn-delete-mail-0" class="btn mrow__delete accent-magenta">
                            <ui:VisualElement picking-mode="Ignore" class="mbin">
                                <ui:VisualElement picking-mode="Ignore" class="mbin__lid" />
                                <ui:VisualElement picking-mode="Ignore" class="mbin__body" />
                            </ui:VisualElement>
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:Label name="mail-title" text="YOUR WEEKLY REWARDS ARE READY" picking-mode="Ignore" class="mread__title" />
                    <ui:ScrollView touch-scroll-type="Elastic" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" class="mread__scroll">
                        <ui:Label name="mail-body-text" text="GREAT RACING THIS WEEK. HERE IS A THANK YOU FOR YOUR RESULTS IN THE NEON GRAND PRIX. CLAIM IT BEFORE IT EXPIRES." picking-mode="Ignore" class="mread__body" />
                    </ui:ScrollView>
                    <ui:VisualElement name="mail-rewards" picking-mode="Ignore" class="mread__rewards">
                        <ui:Label text="ATTACHED REWARDS" picking-mode="Ignore" class="prev__note-text" />
                        <ui:VisualElement picking-mode="Ignore" class="mread__prices">
                            <ui:VisualElement picking-mode="Ignore" class="price accent-amber">
                                <ui:VisualElement picking-mode="Ignore" class="price__icon" />
                                <ui:Label text="5,000" picking-mode="Ignore" class="price__value" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="price accent-magenta">
                                <ui:VisualElement picking-mode="Ignore" class="price__icon" />
                                <ui:Label text="50" picking-mode="Ignore" class="price__value" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="mail-expiry" text="EXPIRES IN 6D 12H" picking-mode="Ignore" class="mread__expiry" />
                    <ui:Button name="btn-claim" class="btn btn-cta mread__claim accent-amber">
                        <ui:VisualElement picking-mode="Ignore" class="sheen" />
                        <ui:Label text="CLAIM REWARDS" picking-mode="Ignore" class="btn-cta__label" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement name="mail-empty" picking-mode="Ignore" class="mempty mempty--hidden">
                    <ui:Label text="NO MAIL" picking-mode="Ignore" class="mempty__title" />
                    <ui:Label text="NEW MESSAGES AND REWARDS WILL SHOW UP HERE." picking-mode="Ignore" class="mempty__text" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>