<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/Ui Toolkit/Common/Common.uss" />
    <ui:Style src="project://database/Assets/Ui Toolkit/Missions/MissionCenter.uss" />
    <ui:Template name="Scrims" src="project://database/Assets/Ui Toolkit/Common/Components/Scrims.uxml" />
    <ui:Template name="ScreenHeader" src="project://database/Assets/Ui Toolkit/Common/Components/ScreenHeader.uxml" />

    <!-- Missions: channel rail on the left, bento cards whose background fills like liquid as progress grows, and a vertical chest track. Channels toggle the three pages. Events live in their own screen. -->
    <ui:VisualElement class="screen" name="root" picking-mode="Position">
        <ui:VisualElement class="layer drag-zone" name="rotate-drag-zone" picking-mode="Position" />
        <ui:Instance class="layer" template="Scrims" picking-mode="Ignore" />
        <ui:VisualElement class="layer hud" name="hud" picking-mode="Ignore">
            <ui:Instance template="ScreenHeader" name="screen-header" picking-mode="Ignore">
                <ui:AttributeOverrides element-name="screen-eyebrow" text="DAILY  /  WEEKLY  /  BOUNTIES" />
                <ui:AttributeOverrides element-name="screen-title" text="MISSIONS" />
            </ui:Instance>
            <ui:VisualElement class="body" picking-mode="Ignore">
                <ui:VisualElement class="mrail" picking-mode="Ignore">
                    <ui:Label class="eyebrow rail-label" text="CHANNELS" picking-mode="Ignore" />
                    <ui:Button class="btn chan accent-cyan chan--on" name="chan-daily">
                        <ui:VisualElement class="sheen" picking-mode="Ignore" />
                        <ui:VisualElement class="edge" picking-mode="Ignore" />
                        <ui:VisualElement class="chan__ico" picking-mode="Ignore">
                            <ui:VisualElement class="glyph glyph--perf" picking-mode="Ignore">
                                <ui:VisualElement class="g g-a" picking-mode="Ignore" />
                                <ui:VisualElement class="g g-b" picking-mode="Ignore" />
                                <ui:VisualElement class="g g-c" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="chan__text" picking-mode="Ignore">
                            <ui:Label class="chan__name" text="DAILY" picking-mode="Ignore" />
                            <ui:Label class="chan__sub" text="3 / 5 DONE" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="chan__right" picking-mode="Ignore">
                            <ui:Label class="chan__timer" text="06:12:44" picking-mode="Ignore" />
                            <ui:Label class="tag tag--accent" text="2 READY" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="chan__bar" picking-mode="Ignore">
                            <ui:VisualElement class="chan__fill" style="width: 60%;" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button class="btn chan accent-amber" name="chan-weekly">
                        <ui:VisualElement class="sheen" picking-mode="Ignore" />
                        <ui:VisualElement class="edge" picking-mode="Ignore" />
                        <ui:VisualElement class="chan__ico" picking-mode="Ignore">
                            <ui:VisualElement class="glyph glyph--trail" picking-mode="Ignore">
                                <ui:VisualElement class="g g-a" picking-mode="Ignore" />
                                <ui:VisualElement class="g g-b" picking-mode="Ignore" />
                                <ui:VisualElement class="g g-c" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="chan__text" picking-mode="Ignore">
                            <ui:Label class="chan__name" text="WEEKLY" picking-mode="Ignore" />
                            <ui:Label class="chan__sub" text="2 / 6 DONE" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="chan__right" picking-mode="Ignore">
                            <ui:Label class="chan__timer" text="4D 06H" picking-mode="Ignore" />
                            <ui:Label class="tag tag--accent" text="1 READY" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="chan__bar" picking-mode="Ignore">
                            <ui:VisualElement class="chan__fill" style="width: 33%;" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button class="btn chan accent-magenta" name="chan-bounty">
                        <ui:VisualElement class="sheen" picking-mode="Ignore" />
                        <ui:VisualElement class="edge" picking-mode="Ignore" />
                        <ui:VisualElement class="chan__ico" picking-mode="Ignore">
                            <ui:VisualElement class="glyph glyph--badge" picking-mode="Ignore">
                                <ui:VisualElement class="g g-a" picking-mode="Ignore" />
                                <ui:VisualElement class="g g-b" picking-mode="Ignore" />
                                <ui:VisualElement class="g g-c" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="chan__text" picking-mode="Ignore">
                            <ui:Label class="chan__name" text="BOUNTIES" picking-mode="Ignore" />
                            <ui:Label class="chan__sub" text="1 / 3 CAUGHT" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="chan__right" picking-mode="Ignore">
                            <ui:Label class="chan__timer" text="NEW IN 14H" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="chan__bar" picking-mode="Ignore">
                            <ui:VisualElement class="chan__fill" style="width: 33%;" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:VisualElement class="spacer" picking-mode="Ignore" />
                    <ui:VisualElement class="sm accent-amber" picking-mode="Ignore">
                        <ui:VisualElement class="sm__head" picking-mode="Ignore">
                            <ui:Label class="eyebrow eyebrow--accent" text="LOGIN STREAK" picking-mode="Ignore" />
                            <ui:VisualElement class="spacer" picking-mode="Ignore" />
                            <ui:Label class="sm__num" text="5 DAYS" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="sm__days" picking-mode="Ignore">
                            <ui:VisualElement class="sm__d sm__d--done" picking-mode="Ignore">
                                <ui:Label class="sm__dn" text="1" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="sm__d sm__d--done" picking-mode="Ignore">
                                <ui:Label class="sm__dn" text="2" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="sm__d sm__d--done" picking-mode="Ignore">
                                <ui:Label class="sm__dn" text="3" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="sm__d sm__d--done" picking-mode="Ignore">
                                <ui:Label class="sm__dn" text="4" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="sm__d sm__d--today" picking-mode="Ignore">
                                <ui:Label class="sm__dn" text="5" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="sm__d sm__d--future" picking-mode="Ignore">
                                <ui:Label class="sm__dn" text="6" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="sm__d sm__d--prize" picking-mode="Ignore">
                                <ui:Label class="sm__dn" text="7" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="sm__today" picking-mode="Ignore">
                            <ui:Label class="sm__today-label" text="TODAY" picking-mode="Ignore" />
                            <ui:VisualElement class="price accent-amber" picking-mode="Ignore">
                                <ui:VisualElement class="price__icon" picking-mode="Ignore" />
                                <ui:Label class="price__value" text="2,500" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label class="sm__note" text="A MISSED DAY PAUSES THE STREAK. IT NEVER RESETS." picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="mpages" picking-mode="Ignore">
                    <ui:VisualElement class="page mpage" name="page-daily" picking-mode="Ignore">
                        <ui:VisualElement class="bento" picking-mode="Ignore">
                            <ui:Button class="btn mc mc--feature mc--claim rarity-epic">
                                <ui:VisualElement class="mc__fill" style="height: 100%;" picking-mode="Ignore">
                                    <ui:VisualElement class="mc__edge" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:VisualElement class="mc__slash" picking-mode="Ignore" />
                                <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                <ui:VisualElement class="mc__top" picking-mode="Ignore">
                                    <ui:Label class="tag" text="MISSION OF THE DAY" picking-mode="Ignore" />
                                    <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:VisualElement class="mc__mid" picking-mode="Ignore">
                                    <ui:Label class="mc__big" text="3" picking-mode="Ignore" />
                                    <ui:Label class="mc__of" text="/ 3" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:Label class="mc__title" text="PERFECT LAUNCH" picking-mode="Ignore" />
                                <ui:Label class="mc__desc" text="DO 3 PERFECT STARTS" picking-mode="Ignore" />
                                <ui:VisualElement class="mc__rewards" picking-mode="Ignore">
                                    <ui:VisualElement class="price accent-amber" picking-mode="Ignore">
                                        <ui:VisualElement class="price__icon" picking-mode="Ignore" />
                                        <ui:Label class="price__value" text="3,000" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="ap" picking-mode="Ignore">
                                        <ui:Label class="ap__num" text="+20" picking-mode="Ignore" />
                                        <ui:Label class="ap__label" text="AP" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="mc__claim" picking-mode="Ignore">
                                    <ui:Label class="mc__claim-text" text="TAP TO CLAIM" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:VisualElement class="bento__grid" picking-mode="Ignore">
                                <ui:Button class="btn mc mc--small mc--progress rarity-rare">
                                    <ui:VisualElement class="mc__fill" style="height: 62%;" picking-mode="Ignore">
                                        <ui:VisualElement class="mc__edge" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="mc__slash" picking-mode="Ignore" />
                                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                    <ui:VisualElement class="mc__top" picking-mode="Ignore">
                                        <ui:Label class="tag" text="RARE" picking-mode="Ignore" />
                                        <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                        <ui:Button class="btn mc__reroll">
                                            <ui:VisualElement class="reroll-a" picking-mode="Ignore" />
                                            <ui:VisualElement class="reroll-b" picking-mode="Ignore" />
                                            <ui:Label class="mc__reroll-text" text="REROLL" picking-mode="Ignore" />
                                        </ui:Button>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="mc__mid" picking-mode="Ignore">
                                        <ui:Label class="mc__big" text="1,240" picking-mode="Ignore" />
                                        <ui:Label class="mc__of" text="/ 2,000" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:Label class="mc__title" text="DRIFT MASTER" picking-mode="Ignore" />
                                    <ui:Label class="mc__desc" text="DRIFT 2,000 M IN ONE RACE" picking-mode="Ignore" />
                                    <ui:VisualElement class="mc__rewards" picking-mode="Ignore">
                                        <ui:VisualElement class="price accent-amber" picking-mode="Ignore">
                                            <ui:VisualElement class="price__icon" picking-mode="Ignore" />
                                            <ui:Label class="price__value" text="2,500" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                        <ui:VisualElement class="ap" picking-mode="Ignore">
                                            <ui:Label class="ap__num" text="+15" picking-mode="Ignore" />
                                            <ui:Label class="ap__label" text="AP" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:Button>
                                <ui:Button class="btn mc mc--small mc--progress rarity-epic">
                                    <ui:VisualElement class="mc__fill" style="height: 33%;" picking-mode="Ignore">
                                        <ui:VisualElement class="mc__edge" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="mc__slash" picking-mode="Ignore" />
                                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                    <ui:VisualElement class="mc__top" picking-mode="Ignore">
                                        <ui:Label class="tag" text="EPIC" picking-mode="Ignore" />
                                        <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                        <ui:Button class="btn mc__reroll">
                                            <ui:VisualElement class="reroll-a" picking-mode="Ignore" />
                                            <ui:VisualElement class="reroll-b" picking-mode="Ignore" />
                                            <ui:Label class="mc__reroll-text" text="REROLL" picking-mode="Ignore" />
                                        </ui:Button>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="mc__mid" picking-mode="Ignore">
                                        <ui:Label class="mc__big" text="1" picking-mode="Ignore" />
                                        <ui:Label class="mc__of" text="/ 3" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:Label class="mc__title" text="PODIUM HUNTER" picking-mode="Ignore" />
                                    <ui:Label class="mc__desc" text="FINISH ON THE PODIUM 3 TIMES" picking-mode="Ignore" />
                                    <ui:VisualElement class="mc__rewards" picking-mode="Ignore">
                                        <ui:VisualElement class="price accent-magenta" picking-mode="Ignore">
                                            <ui:VisualElement class="price__icon" picking-mode="Ignore" />
                                            <ui:Label class="price__value" text="10" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                        <ui:VisualElement class="ap" picking-mode="Ignore">
                                            <ui:Label class="ap__num" text="+20" picking-mode="Ignore" />
                                            <ui:Label class="ap__label" text="AP" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:Button>
                                <ui:Button class="btn mc mc--small mc--progress rarity-common">
                                    <ui:VisualElement class="mc__fill" style="height: 72%;" picking-mode="Ignore">
                                        <ui:VisualElement class="mc__edge" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="mc__slash" picking-mode="Ignore" />
                                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                    <ui:VisualElement class="mc__top" picking-mode="Ignore">
                                        <ui:Label class="tag" text="COMMON" picking-mode="Ignore" />
                                        <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                        <ui:Button class="btn mc__reroll">
                                            <ui:VisualElement class="reroll-a" picking-mode="Ignore" />
                                            <ui:VisualElement class="reroll-b" picking-mode="Ignore" />
                                            <ui:Label class="mc__reroll-text" text="REROLL" picking-mode="Ignore" />
                                        </ui:Button>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="mc__mid" picking-mode="Ignore">
                                        <ui:Label class="mc__big" text="18" picking-mode="Ignore" />
                                        <ui:Label class="mc__of" text="/ 25" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:Label class="mc__title" text="BOOST ADDICT" picking-mode="Ignore" />
                                    <ui:Label class="mc__desc" text="USE BOOST 25 TIMES" picking-mode="Ignore" />
                                    <ui:VisualElement class="mc__rewards" picking-mode="Ignore">
                                        <ui:VisualElement class="price accent-amber" picking-mode="Ignore">
                                            <ui:VisualElement class="price__icon" picking-mode="Ignore" />
                                            <ui:Label class="price__value" text="1,500" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                        <ui:VisualElement class="ap" picking-mode="Ignore">
                                            <ui:Label class="ap__num" text="+10" picking-mode="Ignore" />
                                            <ui:Label class="ap__label" text="AP" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:Button>
                                <ui:Button class="btn mc mc--small mc--done rarity-rare">
                                    <ui:VisualElement class="mc__fill" style="height: 100%;" picking-mode="Ignore">
                                        <ui:VisualElement class="mc__edge" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="mc__slash" picking-mode="Ignore" />
                                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                    <ui:VisualElement class="mc__top" picking-mode="Ignore">
                                        <ui:Label class="tag" text="RARE" picking-mode="Ignore" />
                                        <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                        <ui:VisualElement class="mc__done" picking-mode="Ignore">
                                            <ui:VisualElement class="check" picking-mode="Ignore" />
                                            <ui:Label class="mc__done-text" text="CLAIMED" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="mc__mid" picking-mode="Ignore">
                                        <ui:Label class="mc__big" text="100%" picking-mode="Ignore" />
                                        <ui:Label class="mc__of" text="" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:Label class="mc__title" text="TEAM PLAYER" picking-mode="Ignore" />
                                    <ui:Label class="mc__desc" text="RACE WITH A FRIEND IN A ROOM" picking-mode="Ignore" />
                                    <ui:VisualElement class="mc__rewards" picking-mode="Ignore">
                                        <ui:VisualElement class="price accent-amber" picking-mode="Ignore">
                                            <ui:VisualElement class="price__icon" picking-mode="Ignore" />
                                            <ui:Label class="price__value" text="2,000" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                        <ui:VisualElement class="ap" picking-mode="Ignore">
                                            <ui:Label class="ap__num" text="+15" picking-mode="Ignore" />
                                            <ui:Label class="ap__label" text="AP" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:Button>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="vchest accent-amber" picking-mode="Ignore">
                            <ui:Label class="eyebrow eyebrow--accent" text="DAILY ACTIVITY" picking-mode="Ignore" />
                            <ui:VisualElement class="vchest__num" picking-mode="Ignore">
                                <ui:Label class="vchest__big" text="60" picking-mode="Ignore" />
                                <ui:Label class="vchest__of" text="/ 100" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="vchest__track" picking-mode="Ignore">
                                <ui:VisualElement class="vchest__bar" picking-mode="Ignore">
                                    <ui:VisualElement class="vchest__fill" style="height: 60%;" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:Button class="btn vcrate vcrate--claimed" style="bottom: 20%;">
                                    <ui:VisualElement class="vcrate__box" picking-mode="Ignore">
                                        <ui:VisualElement class="vcrate__core" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="vcrate__text" picking-mode="Ignore">
                                        <ui:Label class="vcrate__ap" text="20 AP" picking-mode="Ignore" />
                                        <ui:Label class="vcrate__state" text="CLAIMED" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:Button>
                                <ui:Button class="btn vcrate vcrate--claimed" style="bottom: 40%;">
                                    <ui:VisualElement class="vcrate__box" picking-mode="Ignore">
                                        <ui:VisualElement class="vcrate__core" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="vcrate__text" picking-mode="Ignore">
                                        <ui:Label class="vcrate__ap" text="40 AP" picking-mode="Ignore" />
                                        <ui:Label class="vcrate__state" text="CLAIMED" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:Button>
                                <ui:Button class="btn vcrate vcrate--ready" style="bottom: 60%;">
                                    <ui:VisualElement class="vcrate__box" picking-mode="Ignore">
                                        <ui:VisualElement class="vcrate__core" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="vcrate__text" picking-mode="Ignore">
                                        <ui:Label class="vcrate__ap" text="60 AP" picking-mode="Ignore" />
                                        <ui:Label class="vcrate__state" text="CLAIM" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:Button>
                                <ui:Button class="btn vcrate vcrate--locked" style="bottom: 80%;">
                                    <ui:VisualElement class="vcrate__box" picking-mode="Ignore">
                                        <ui:VisualElement class="vcrate__core" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="vcrate__text" picking-mode="Ignore">
                                        <ui:Label class="vcrate__ap" text="80 AP" picking-mode="Ignore" />
                                        <ui:Label class="vcrate__state" text="LOCKED" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:Button>
                                <ui:Button class="btn vcrate vcrate--locked" style="bottom: 100%;">
                                    <ui:VisualElement class="vcrate__box" picking-mode="Ignore">
                                        <ui:VisualElement class="vcrate__core" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="vcrate__text" picking-mode="Ignore">
                                        <ui:Label class="vcrate__ap" text="100 AP" picking-mode="Ignore" />
                                        <ui:Label class="vcrate__state" text="LOCKED" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:Button>
                            </ui:VisualElement>
                            <ui:Label class="vchest__reset" text="RESETS 06:12:44" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="page mpage page--hidden" name="page-weekly" picking-mode="Ignore">
                        <ui:VisualElement class="bento" picking-mode="Ignore">
                            <ui:Button class="btn mc mc--feature mc--progress rarity-legendary">
                                <ui:VisualElement class="mc__fill" style="height: 66%;" picking-mode="Ignore">
                                    <ui:VisualElement class="mc__edge" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:VisualElement class="mc__slash" picking-mode="Ignore" />
                                <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                <ui:VisualElement class="mc__top" picking-mode="Ignore">
                                    <ui:Label class="tag" text="WEEKLY BOSS" picking-mode="Ignore" />
                                    <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:VisualElement class="mc__mid" picking-mode="Ignore">
                                    <ui:Label class="mc__big" text="2" picking-mode="Ignore" />
                                    <ui:Label class="mc__of" text="/ 3" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:Label class="mc__title" text="GRID LEGEND" picking-mode="Ignore" />
                                <ui:Label class="mc__desc" text="THREE CHALLENGES, ONE LEGENDARY PART" picking-mode="Ignore" />
                                <ui:VisualElement class="mc__steps" picking-mode="Ignore">
                                    <ui:VisualElement class="obj obj--done" picking-mode="Ignore">
                                        <ui:VisualElement class="obj__box" picking-mode="Ignore">
                                            <ui:VisualElement class="check" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                        <ui:Label class="obj__text" text="WIN ON EVERY OPEN PLANET" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="obj obj--done" picking-mode="Ignore">
                                        <ui:VisualElement class="obj__box" picking-mode="Ignore">
                                            <ui:VisualElement class="check" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                        <ui:Label class="obj__text" text="TOP 5 TIME ON ANY TRACK" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="obj" picking-mode="Ignore">
                                        <ui:VisualElement class="obj__box" picking-mode="Ignore" />
                                        <ui:Label class="obj__text" text="WIN 5 ONLINE RACES  2 / 5" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="mc__rewards" picking-mode="Ignore">
                                    <ui:VisualElement class="price accent-magenta" picking-mode="Ignore">
                                        <ui:VisualElement class="price__icon" picking-mode="Ignore" />
                                        <ui:Label class="price__value" text="100" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="ap" picking-mode="Ignore">
                                        <ui:Label class="ap__num" text="+100" picking-mode="Ignore" />
                                        <ui:Label class="ap__label" text="AP" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:VisualElement class="bento__grid bento__grid--3" picking-mode="Ignore">
                                <ui:Button class="btn mc mc--small mc--progress rarity-rare">
                                    <ui:VisualElement class="mc__fill" style="height: 62%;" picking-mode="Ignore">
                                        <ui:VisualElement class="mc__edge" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="mc__slash" picking-mode="Ignore" />
                                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
