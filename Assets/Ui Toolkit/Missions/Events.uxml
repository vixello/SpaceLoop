<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/Ui Toolkit/Common/Common.uss" />
    <ui:Style src="project://database/Assets/Ui Toolkit/Missions/Events.uss" />
    <ui:Template name="Scrims" src="project://database/Assets/Ui Toolkit/Common/Components/Scrims.uxml" />
    <ui:Template name="ScreenHeader" src="project://database/Assets/Ui Toolkit/Common/Components/ScreenHeader.uxml" />

    <!-- Events (redo). Fixed schedule on top, then one scrolling page: hero splash, horizontal reward path, community goal. Per-event pictures: ev-bg-art (full screen backdrop) and ev-hero-art (hero splash), set from C# on selection. -->
    <ui:VisualElement class="screen" name="root" picking-mode="Position">
        <ui:VisualElement class="ev-bg ev-bg--intro accent-magenta" name="ev-bg" picking-mode="Ignore">
            <ui:VisualElement class="ev-bg__art" name="ev-bg-art" picking-mode="Ignore" />
            <ui:VisualElement class="ev-bg__dim" picking-mode="Ignore" />
            <ui:VisualElement class="ev-bg__shaft ev-bg__shaft--a" picking-mode="Ignore" />
            <ui:VisualElement class="ev-bg__shaft ev-bg__shaft--b" picking-mode="Ignore" />
            <ui:VisualElement class="ev-bg__shaft ev-bg__shaft--c" picking-mode="Ignore" />
            <ui:VisualElement class="ev-vig ev-vig--b1" picking-mode="Ignore" />
            <ui:VisualElement class="ev-vig ev-vig--b2" picking-mode="Ignore" />
            <ui:VisualElement class="ev-vig ev-vig--b3" picking-mode="Ignore" />
            <ui:VisualElement class="ev-vig ev-vig--b4" picking-mode="Ignore" />
            <ui:VisualElement class="ev-vig ev-vig--b5" picking-mode="Ignore" />
            <ui:VisualElement class="ev-vig ev-vig--t1" picking-mode="Ignore" />
            <ui:VisualElement class="ev-vig ev-vig--t2" picking-mode="Ignore" />
            <ui:VisualElement class="ev-vig ev-vig--t3" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="layer drag-zone" name="rotate-drag-zone" picking-mode="Position" />
        <ui:Instance class="layer" template="Scrims" picking-mode="Ignore" />
        <ui:VisualElement class="layer hud" name="hud" picking-mode="Ignore">
            <ui:Instance template="ScreenHeader" name="screen-header" picking-mode="Ignore">
                <ui:AttributeOverrides element-name="screen-eyebrow" text="LIVE  /  UPCOMING  /  SEASONAL" />
                <ui:AttributeOverrides element-name="screen-title" text="EVENTS" />
            </ui:Instance>

            <!-- SCHEDULE (fixed) -->
            <ui:VisualElement class="sched" picking-mode="Ignore">
                <ui:VisualElement class="sched__days" picking-mode="Ignore"><ui:Label class="sched__day" text="MON" picking-mode="Ignore" /><ui:Label class="sched__day" text="TUE" picking-mode="Ignore" /><ui:Label class="sched__day" text="WED" picking-mode="Ignore" /><ui:Label class="sched__day sched__day--today" text="THU" picking-mode="Ignore" /><ui:Label class="sched__day" text="FRI" picking-mode="Ignore" /><ui:Label class="sched__day" text="SAT" picking-mode="Ignore" /><ui:Label class="sched__day" text="SUN" picking-mode="Ignore" /></ui:VisualElement>
                <ui:VisualElement class="sched__lanes" picking-mode="Ignore">
                    <ui:VisualElement class="sched__line" style="left: 14.29%;" picking-mode="Ignore" />
                    <ui:VisualElement class="sched__line" style="left: 28.57%;" picking-mode="Ignore" />
                    <ui:VisualElement class="sched__line" style="left: 42.86%;" picking-mode="Ignore" />
                    <ui:VisualElement class="sched__line" style="left: 57.14%;" picking-mode="Ignore" />
                    <ui:VisualElement class="sched__line" style="left: 71.43%;" picking-mode="Ignore" />
                    <ui:VisualElement class="sched__line" style="left: 85.71%;" picking-mode="Ignore" />
                    <ui:VisualElement class="sched__today" style="left: 50.00%;" picking-mode="Ignore" />
                    <ui:VisualElement class="lane" picking-mode="Ignore">
                        <ui:Button class="btn sbar accent-magenta sbar--live sbar--sel" style="left: 0.40%; width: 99.20%;" name="evt-neon-grand-prix">
                            <ui:VisualElement class="sheen" picking-mode="Ignore" />
                            <ui:Label class="sbar__name" text="NEON GRAND PRIX" picking-mode="Ignore" />
                            <ui:Label class="sbar__time" text="LIVE  /  ENDS SUN" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="lane" picking-mode="Ignore">
                        <ui:Button class="btn sbar accent-cyan sbar--live" style="left: 28.97%; width: 27.77%;" name="evt-ghost-rush">
                            <ui:VisualElement class="sheen" picking-mode="Ignore" />
                            <ui:Label class="sbar__name" text="GHOST RUSH" picking-mode="Ignore" />
                            <ui:Label class="sbar__time" text="ENDS FRI" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="lane" picking-mode="Ignore">
                        <ui:Button class="btn sbar accent-amber sbar--soon" style="left: 57.54%; width: 42.06%;" name="evt-weekend-overdrive">
                            <ui:VisualElement class="sheen" picking-mode="Ignore" />
                            <ui:Label class="sbar__name" text="WEEKEND OVERDRIVE" picking-mode="Ignore" />
                            <ui:Label class="sbar__time" text="STARTS IN 1D" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="lane" picking-mode="Ignore">
                        <ui:Button class="btn sbar accent-violet sbar--locked" style="left: 71.83%; width: 27.77%;" name="evt-season-05-teaser">
                            <ui:VisualElement class="sheen" picking-mode="Ignore" />
                            <ui:Label class="sbar__name" text="SEASON 05 TEASER" picking-mode="Ignore" />
                            <ui:Label class="sbar__time" text="SECRET" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- PAGE (scrolls) -->
            <ui:ScrollView name="ev-scroll" class="ev-scroll" mode="Vertical" touch-scroll-type="Elastic" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">

                <!-- 1. HERO SPLASH -->
                <ui:VisualElement class="ev-hero accent-magenta" name="ev-hero" picking-mode="Ignore">
                    <ui:VisualElement class="ev-hero__art" name="ev-hero-art" picking-mode="Ignore" />
                    <ui:VisualElement class="ev-hero__shade" picking-mode="Ignore" />
                    <ui:VisualElement class="ev-hero__edge2" picking-mode="Ignore" />
                    <ui:VisualElement class="ev-hero__edge" picking-mode="Ignore" />
                    <ui:VisualElement class="ev-hero__fade ev-hero__fade--1" picking-mode="Ignore" /><ui:VisualElement class="ev-hero__fade ev-hero__fade--2" picking-mode="Ignore" /><ui:VisualElement class="ev-hero__fade ev-hero__fade--3" picking-mode="Ignore" />
                    <ui:VisualElement class="ev-hero__content" picking-mode="Ignore">
                        <ui:VisualElement class="ev-hero__main" picking-mode="Ignore">
                            <ui:VisualElement class="ev-hero__top" picking-mode="Ignore">
                                <ui:VisualElement class="live" picking-mode="Ignore"><ui:VisualElement class="live__dot" picking-mode="Ignore" /><ui:Label class="live__text" text="LIVE EVENT" picking-mode="Ignore" /></ui:VisualElement>
                                <ui:Label class="tag tag--accent" text="LIMITED TIME" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:Label class="ev__title" name="ev-title" text="NEON GRAND PRIX" picking-mode="Ignore" />
                            <ui:Label class="ev__desc" name="ev-desc" text="RACE ANYWHERE, EARN NEON POINTS AND CLIMB THE REWARD PATH." picking-mode="Ignore" />
                            <ui:VisualElement class="ev__pts" picking-mode="Ignore">
                                <ui:Label class="eyebrow eyebrow--accent" text="NEON POINTS" picking-mode="Ignore" />
                                <ui:Label class="ev__pts-num" text="1,840" picking-mode="Ignore" />
                                <ui:Label class="ev__pts-of" text="/ 2,400  TO TIER 10" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="pbar ev__bar" picking-mode="Ignore"><ui:VisualElement class="pbar__fill" style="width: 77%;" picking-mode="Ignore" /></ui:VisualElement>
                            <ui:VisualElement class="spacer" picking-mode="Ignore" />
                            <ui:VisualElement class="ev__actions" picking-mode="Position">
                                <ui:Button class="btn btn-cta ev__buy accent-magenta" name="btn-premium">
                                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                    <ui:Label class="btn-cta__label" text="UNLOCK PREMIUM" picking-mode="Ignore" />
                                    <ui:VisualElement class="price accent-magenta" picking-mode="Ignore"><ui:VisualElement class="price__icon" picking-mode="Ignore" /><ui:Label class="price__value" text="1,200" picking-mode="Ignore" /></ui:VisualElement>
                                </ui:Button>
                                <ui:Button class="btn btn-ghost accent-magenta" name="btn-rules"><ui:VisualElement class="sheen" picking-mode="Ignore" /><ui:Label class="btn-ghost__label" text="EVENT RULES" picking-mode="Ignore" /></ui:Button>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="ev-hero__side" picking-mode="Ignore">
                            <ui:VisualElement class="glass" picking-mode="Ignore">
                                <ui:Label class="eyebrow" text="ENDS IN" picking-mode="Ignore" />
                                <ui:VisualElement class="timer" picking-mode="Ignore"><ui:VisualElement class="timer__cell" picking-mode="Ignore"><ui:Label class="timer__num" text="02" picking-mode="Ignore" /><ui:Label class="timer__unit" text="D" picking-mode="Ignore" /></ui:VisualElement><ui:VisualElement class="timer__cell" picking-mode="Ignore"><ui:Label class="timer__num" text="14" picking-mode="Ignore" /><ui:Label class="timer__unit" text="H" picking-mode="Ignore" /></ui:VisualElement><ui:VisualElement class="timer__cell" picking-mode="Ignore"><ui:Label class="timer__num" text="33" picking-mode="Ignore" /><ui:Label class="timer__unit" text="M" picking-mode="Ignore" /></ui:VisualElement></ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="glass" picking-mode="Ignore">
                                <ui:Label class="eyebrow eyebrow--accent" text="HOW TO EARN" picking-mode="Ignore" />
                                <ui:VisualElement class="earn" picking-mode="Ignore"><ui:VisualElement class="earn__dot" picking-mode="Ignore" /><ui:Label class="earn__text" text="WIN A RACE" picking-mode="Ignore" /><ui:VisualElement class="spacer" picking-mode="Ignore" /><ui:Label class="earn__pts" text="+100" picking-mode="Ignore" /></ui:VisualElement><ui:VisualElement class="earn" picking-mode="Ignore"><ui:VisualElement class="earn__dot" picking-mode="Ignore" /><ui:Label class="earn__text" text="FINISH A STORY CHAPTER" picking-mode="Ignore" /><ui:VisualElement class="spacer" picking-mode="Ignore" /><ui:Label class="earn__pts" text="+150" picking-mode="Ignore" /></ui:VisualElement><ui:VisualElement class="earn" picking-mode="Ignore"><ui:VisualElement class="earn__dot" picking-mode="Ignore" /><ui:Label class="earn__text" text="COMPLETE A DAILY MISSION" picking-mode="Ignore" /><ui:VisualElement class="spacer" picking-mode="Ignore" /><ui:Label class="earn__pts" text="+50" picking-mode="Ignore" /></ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- 2. REWARD PATH -->
                <ui:VisualElement class="ev-sec accent-magenta" name="ev-path" picking-mode="Ignore">
                    <ui:VisualElement class="ev-sec__head" picking-mode="Position">
                        <ui:VisualElement picking-mode="Ignore">
                            <ui:Label class="eyebrow eyebrow--accent" text="REWARD PATH  /  TIER 9 OF 40" picking-mode="Ignore" />
                            <ui:Label class="ev-sec__title" text="CLIMB THE PATH" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="spacer" picking-mode="Ignore" />
                        <ui:Label class="mnote" text="PREMIUM LANE LOCKED" picking-mode="Ignore" />
                        <ui:Button class="btn btn-ghost accent-magenta" name="btn-rp-current"><ui:VisualElement class="sheen" picking-mode="Ignore" /><ui:Label class="btn-ghost__label" text="CURRENT TIER" picking-mode="Ignore" /></ui:Button>
                        <ui:Button class="btn btn-cta accent-magenta" name="btn-claim-all"><ui:VisualElement class="sheen" picking-mode="Ignore" /><ui:Label class="btn-cta__label" text="CLAIM 1 READY" picking-mode="Ignore" /></ui:Button>
                        <ui:Button class="btn ev-arrow accent-magenta" name="btn-rp-left"><ui:VisualElement class="chevron chevron--left" picking-mode="Ignore" /></ui:Button>
                        <ui:Button class="btn ev-arrow accent-magenta" name="btn-rp-right"><ui:VisualElement class="chevron" picking-mode="Ignore" /></ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="rp" picking-mode="Ignore">
                        <ui:VisualElement class="rp__lanes" picking-mode="Ignore">
                            <ui:VisualElement class="rp__lane rp__lane--p" picking-mode="Ignore"><ui:Label class="lane-tag lane-tag--p" text="PREMIUM" picking-mode="Ignore" /><ui:Label class="lane-sub" text="PASS REQUIRED" picking-mode="Ignore" /></ui:VisualElement>
                            <ui:VisualElement class="rp__lane rp__lane--t" picking-mode="Ignore"><ui:Label class="lane-sub" text="TIER" picking-mode="Ignore" /></ui:VisualElement>
                            <ui:VisualElement class="rp__lane rp__lane--f" picking-mode="Ignore"><ui:Label class="lane-tag lane-tag--f" text="FREE" picking-mode="Ignore" /><ui:Label class="lane-sub" text="EVERYONE" picking-mode="Ignore" /></ui:VisualElement>
                        </ui:VisualElement>
                        <ui:ScrollView name="rp-scroll" class="rp__scroll" mode="Horizontal" touch-scroll-type="Elastic" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                                <ui:VisualElement class="tier tier--done" name="tier-01" picking-mode="Ignore">
                                    <ui:VisualElement class="tier__prem" picking-mode="Position"><ui:Button class="btn rw rw--prem rw--locked"><ui:VisualElement class="rw__ico rw__ico--wrap" picking-mode="Ignore" /><ui:Label class="rw__label" text="WRAP" picking-mode="Ignore" /><ui:VisualElement class="sheen" picking-mode="Ignore" /><ui:VisualElement class="rw__lock" picking-mode="Ignore"><ui:VisualElement class="lock lock--sm" picking-mode="Ignore"><ui:VisualElement class="lock__shackle" picking-mode="Ignore" /><ui:VisualElement class="lock__body" picking-mode="Ignore" /></ui:VisualElement></ui:VisualElement></ui:Button></ui:VisualElement>
                                    <ui:VisualElement class="tier__track" picking-mode="Ignore">
                                        <ui:VisualElement class="tier__line" picking-mode="Ignore"><ui:VisualElement class="tier__fill" style="width: 100%;" picking-mode="Ignore" /></ui:VisualElement>
                                        <ui:VisualElement class="tn tn--done" picking-mode="Ignore"><ui:VisualElement class="tn__shape" picking-mode="Ignore" /><ui:Label class="tn__num" text="01" picking-mode="Ignore" /></ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="tier__free" picking-mode="Position"><ui:Button class="btn rw rw--free rw--claimed"><ui:VisualElement class="rw__ico rw__ico--cr" picking-mode="Ignore" /><ui:Label class="rw__label" text="2,000" picking-mode="Ignore" /><ui:VisualElement class="sheen" picking-mode="Ignore" /><ui:VisualElement class="rw__check" picking-mode="Ignore"><ui:VisualElement class="check" picking-mode="Ignore" /></ui:VisualElement></ui:Button></ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="tier tier--done" name="tier-02" picking-mode="Ignore">
                                    <ui:VisualElement class="tier__prem" picking-mode="Position"><ui:Button class="btn rw rw--prem rw--locked"><ui:VisualElement class="rw__ico rw__ico--core" picking-mode="Ignore" /><ui:Label class="rw__label" text="50" picking-mode="Ignore" /><ui:VisualElement class="sheen" picking-mode="Ignore" /><ui:VisualElement class="rw__lock" picking-mode="Ignore"><ui:VisualElement class="lock lock--sm" picking-mode="Ignore"><ui:VisualElement class="lock__shackle" picking-mode="Ignore" /><ui:VisualElement class="lock__body" picking-mode="Ignore" /></ui:VisualElement></ui:VisualElement></ui:Button></ui:VisualElement>
                                    <ui:VisualElement class="tier__track" picking-mode="Ignore">
                                        <ui:VisualElement class="tier__line" picking-mode="Ignore"><ui:VisualElement class="tier__fill" style="width: 100%;" picking-mode="Ignore" /></ui:VisualElement>
                                        <ui:VisualElement class="tn tn--done" picking-mode="Ignore"><ui:VisualElement class="tn__shape" picking-mode="Ignore" /><ui:Label class="tn__num" text="02" picking-mode="Ignore" /></ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="tier__free" picking-mode="Position"><ui:Button class="btn rw rw--free rw--claimed"><ui:VisualElement class="rw__ico rw__ico--avatar" picking-mode="Ignore" /><ui:Label class="rw__label" text="AVATAR" picking-mode="Ignore" /><ui:VisualElement class="sheen" picking-mode="Ignore" /><ui:VisualElement class="rw__check" picking-mode="Ignore"><ui:VisualElement class="check" picking-mode="Ignore" /></ui:VisualElement></ui:Button></ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="tier tier--done" name="tier-03" picking-mode="Ignore">
                                    <ui:VisualElement class="tier__prem" picking-mode="Position"><ui:Button class="btn rw rw--prem rw--locked"><ui:VisualElement class="rw__ico rw__ico--trail" picking-mode="Ignore" /><ui:Label class="rw__label" text="TRAIL" picking-mode="Ignore" /><ui:VisualElement class="sheen" picking-mode="Ignore" /><ui:VisualElement class="rw__lock" picking-mode="Ignore"><ui:VisualElement class="lock lock--sm" picking-mode="Ignore"><ui:VisualElement class="lock__shackle" picking-mode="Ignore" /><ui:VisualElement class="lock__body" picking-mode="Ignore" /></ui:VisualElement></ui:VisualElement></ui:Button></ui:VisualElement>
                                    <ui:VisualElement class="tier__track" picking-mode="Ignore">
                                        <ui:VisualElement class="tier__line" picking-mode="Ignore"><ui:VisualElement class="tier__fill" style="width: 100%;" picking-mode="Ignore" /></ui:VisualElement>
                                        <ui:VisualElement class="tn tn--done" picking-mode="Ignore"><ui:VisualElement class="tn__shape" picking-mode="Ignore" /><ui:Label class="tn__num" text="03" picking-mode="Ignore" /></ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="tier__free" picking-mode="Position"><ui:Button class="btn rw rw--free rw--claimed"><ui:VisualElement class="rw__ico rw__ico--cr" picking-mode="Ignore" /><ui:Label class="rw__label" text="3,000" picking-mode="Ignore" /><ui:VisualElement class="sheen" picking-mode="Ignore" /><ui:VisualElement class="rw__check" picking-mode="Ignore"><ui:VisualElement class="check" picking-mode="Ignore" /></ui:VisualElement></ui:Button></ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="tier tier--done" name="tier-04" picking-mode="Ignore">
                                    <ui:VisualElement class="tier__prem" picking-mode="Position"><ui:Button class="btn rw rw--prem rw--locked"><ui:VisualElement class="rw__ico rw__ico--core" picking-mode="Ignore" /><ui:Label class="rw__label" text="75" picking-mode="Ignore" /><ui:VisualElement class="sheen" picking-mode="Ignore" /><ui:VisualElement class="rw__lock" picking-mode="Ignore"><ui:VisualElement class="lock lock--sm" picking-mode="Ignore"><ui:VisualElement class="lock__shackle" picking-mode="Ignore" /><ui:VisualElement class="lock__body" picking-mode="Ignore" /></ui:VisualElement></ui:VisualElement></ui:Button></ui:VisualElement>
                                    <ui:VisualElement class="tier__track" picking-mode="Ignore">
                                        <ui:VisualElement class="tier__line" picking-mode="Ignore"><ui:VisualElement class="tier__fill" style="width: 100%;" picking-mode="Ignore" /></ui:VisualElement>
                                        <ui:VisualElement class="tn tn--done" picking-mode="Ignore"><ui:VisualElement class="tn__shape" picking-mode="Ignore" /><ui:Label class="tn__num" text="04" picking-mode="Ignore" /></ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="tier__free" picking-mode="Position"><ui:Button class="btn rw rw--free rw--claimed"><ui:VisualElement class="rw__ico rw__ico--core" picking-mode="Ignore" /><ui:Label class="rw__label" text="10" picking-mode="Ignore" /><ui:VisualElement class="sheen" picking-mode="Ignore" /><ui:VisualElement class="rw__check" picking-mode="Ignore"><ui:VisualElement class="check" picking-mode="Ignore" /></ui:VisualElement></ui:Button></ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="tier tier--done" name="tier-05" picking-mode="Ignore">
                                    <ui:VisualElement class="tier__prem" picking-mode="Position"><ui:Button class="btn rw rw--prem rw--locked"><ui:VisualElement class="rw__ico rw__ico--outfit" picking-mode="Ignore" /><ui:Label class="rw__label" text="OUTFIT" picking-mode="Ignore" /><ui:VisualElement class="sheen" picking-mode="Ignore" /><ui:VisualElement class="rw__lock" picking-mode="Ignore"><ui:VisualElement class="lock lock--sm" picking-mode="Ignore"><ui:VisualElement class="lock__shackle" picking-mode="Ignore" /><ui:VisualElement class="lock__body" picking-mode="Ignore" /></ui:VisualElement></ui:VisualElement></ui:Button></ui:VisualElement>
                                    <ui:VisualElement class="tier__track" picking-mode="Ignore">
                                        <ui:VisualElement class="tier__line" picking-mode="Ignore"><ui:VisualElement class="tier__fill" style="width: 100%;" picking-mode="Ignore" /></ui:VisualElement>
                                        <ui:VisualElement class="tn tn--done" picking-mode="Ignore"><ui:VisualElement class="tn__shape" picking-mode="Ignore" /><ui:Label class="tn__num" text="05" picking-mode="Ignore" /></ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="tier__free" picking-mode="Position"><ui:Button class="btn rw rw--free rw--claimed"><ui:VisualElement class="rw__ico rw__ico--cr" picking-mode="Ignore" /><ui:Label class="rw__label" text="4,000" picking-mode="Ignore" /><ui:VisualElement class="sheen" picking-mode="Ignore" /><ui:VisualElement class="rw__check" picking-mode="Ignore"><ui:VisualElement class="check" picking-mode="Ignore" /></ui:VisualElement></ui:Button></ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="tier tier--done" name="tier-06" picking-mode="Ignore">
                                    <ui:VisualElement class="tier__prem" picking-mode="Position"><ui:Button class="btn rw rw--prem rw--locked"><ui:VisualElement class="rw__ico rw__ico--core" picking-mode="Ignore" /><ui:Label class="rw__label" text="100" picking-mode="Ignore" /><ui:VisualElement class="sheen" picking-mode="Ignore" /><ui:VisualElement class="rw__lock" picking-mode="Ignore"><ui:VisualElement class="lock lock--sm" picking-mode="Ignore"><ui:VisualElement class="lock__shackle" picking-mode="Ignore" /><ui:VisualElement class="lock__body" picking-mode="Ignore" /></ui:VisualElement></ui:VisualElement></ui:Button></ui:VisualElement>
                                    <ui:VisualElement class="tier__track" picking-mode="Ignore">
                                        <ui:VisualElement class="tier__line" picking-mode="Ignore"><ui:VisualElement class="tier__fill" style="width: 100%;" picking-mode="Ignore" /></ui:VisualElement>
                                        <ui:VisualElement class="tn tn--done" picking-mode="Ignore"><ui:VisualElement class="tn__shape" picking-mode="Ignore" /><ui:Label class="tn__num" text="06" picking-mode="Ignore" /></ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="tier__free" picking-mode="Position"><ui:Button class="btn rw rw--free rw--claimed"><ui:VisualElement class="rw__ico rw__ico--title" picking-mode="Ignore" /><ui:Label class="rw__label" text="TITLE" picking-mode="Ignore" /><ui:VisualElement class="sheen" picking-mode="Ignore" /><ui:VisualElement class="rw__check" picking-mode="Ignore"><ui:VisualElement class="check" picking-mode="Ignore" /></ui:VisualElement></ui:Button></ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="tier tier--done" name="tier-07" picking-mode="Ignore">
                                    <ui:VisualElement class="tier__prem" picking-mode="Position"><ui:Button class="btn rw rw--prem rw--locked"><ui:VisualElement class="rw__ico rw__ico--exhaust" picking-mode="Ignore" /><ui:Label class="rw__label" text="EXHAUST" picking-mode="Ignore" /><ui:VisualElement class="sheen" picking-mode="Ignore" /><ui:VisualElement class="rw__lock" picking-mode="Ignore"><ui:VisualElement class="lock lock--sm" picking-mode="Ignore"><ui:VisualElement class="lock__shackle" picking-mode="Ignore" /><ui:VisualElement class="lock__body" picking-mode="Ignore" /></ui:VisualElement></ui:VisualElement></ui:Button></ui:VisualElement>
                                    <ui:VisualElement class="tier__track" picking-mode="Ignore">
                                        <ui:VisualElement class="tier__line" picking-mode="Ignore"><ui:VisualElement class="tier__fill" style="width: 100%;" picking-mode="Ignore" /></ui:VisualElement>
                                        <ui:VisualElement class="tn tn--done" picking-mode="Ignore"><ui:VisualElement class="tn__shape" picking-mode="Ignore" /><ui:Label class="tn__num" text="07" picking-mode="Ignore" /></ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="tier__free" picking-mode="Position"><ui:Button class="btn rw rw--free rw--claimed"><ui:VisualElement class="rw__ico rw__ico--cr" picking-mode="Ignore" /><ui:Label class="rw__label" text="5,000" picking-mode="Ignore" /><ui:VisualElement class="sheen" picking-mode="Ignore" /><ui:VisualElement class="rw__check" picking-mode="Ignore"><ui:VisualElement class="check" picking-mode="Ignore" /></ui:VisualElement></ui:Button></ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="tier tier--done" name="tier-08" picking-mode="Ignore">
