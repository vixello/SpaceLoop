/* =====================================================================
   DRIVER SELECT (first time)  (requires Common.uss)
   Designed for a 3D camera that pans along a lineup of the five drivers
   and their starting vehicles:
   - the center of the screen is always clear
   - driver info floats on the left, vehicle info on the right, as text
     with shadows (no panels)
   - a selector line at the bottom focuses a driver; swiping anywhere
     (#camera-drag-zone) pans the camera
   - world tags (.wtag) are placed over each driver from C# using
     style.left / style.top (world to screen)
   Per-driver colour: swap accent-cyan / amber / green / magenta / violet
   on the root element when the selection changes.
   Fade the info blocks by adding .info--out, swapping the text, then
   removing it again.
   ===================================================================== */

.front { padding: 0; }

/* Lighter vignette so the 3D scene stays bright */
.scrim-l, .scrim-r { display: none; }
.scrim-t .s { background-color: rgba(2, 5, 12, 0.06); }
.scrim-b .s { background-color: rgba(2, 5, 12, 0.14); }

/* ---------------------------------------------------------------------
   1. TOP
   --------------------------------------------------------------------- */
.ptop { position: absolute; left: 64px; right: 64px; top: 40px; flex-direction: row; justify-content: space-between; align-items: flex-start; }

.ptop__title {
    font-size: 60px;
    letter-spacing: 10px;
    color: var(--c-text);
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
    text-shadow: 0px 3px 12px rgba(0, 0, 0, 0.9);
}

.ptop__right { align-items: flex-end; }
.ptop__right > .ptop__count { }

.ptop__count { font-size: 76px; letter-spacing: 4px; color: var(--accent); -unity-font-style: bold-and-italic; -unity-text-align: lower-right; text-shadow: 0px 3px 12px rgba(0, 0, 0, 0.9); }
.ptop__of { margin-top: -22px; font-size: 18px; letter-spacing: 6px; color: var(--c-text-2); -unity-font-style: bold; text-shadow: 0px 2px 8px rgba(0, 0, 0, 0.9); }
.dots { flex-direction: row; margin-top: 10px; }
.dotp { width: 30px; height: 5px; margin-left: 6px; background-color: rgba(255, 255, 255, 0.25); }
.dotp--on { background-color: var(--accent); }

/* ---------------------------------------------------------------------
   2. DRIVER INFO (left, floating text)
   --------------------------------------------------------------------- */
.left-col { position: absolute; left: 64px; top: 190px; width: 560px; }
.dinfo { transition-property: opacity, translate; transition-duration: 0.3s; transition-timing-function: ease-out; }
.info--out { opacity: 0; translate: -30px 0; }
.dinfo__top { flex-direction: row; align-items: flex-end; }
.dinfo__top .eyebrow { margin-bottom: 14px; text-shadow: 0px 2px 8px rgba(0, 0, 0, 0.9); }

.dinfo__num { margin-left: 18px; font-size: 22px; letter-spacing: 4px; color: var(--c-text-3); -unity-font-style: bold-and-italic; }

.dinfo__name {
    font-size: 104px;
    letter-spacing: 10px;
    color: var(--c-text);
    white-space: nowrap;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
    text-shadow: 0px 4px 16px rgba(0, 0, 0, 0.9);
}

.dinfo__tag {
    margin-top: 4px;
    max-width: 520px;
    font-size: 14px;
    letter-spacing: 3px;
    color: var(--c-text);
    white-space: normal;
    -unity-font-style: bold;
    -unity-text-align: upper-left;
    text-shadow: 0px 2px 8px rgba(0, 0, 0, 0.95);
}

.dinfo__chips { flex-direction: row; flex-wrap: wrap; margin: 14px 0 18px 0; }
.dinfo__chips .tag { margin: 0 8px 8px 0; }

.abil { margin-bottom: 14px; padding-left: 16px; border-left-width: 3px; border-color: var(--accent); }
.abil__label { font-size: 10px; letter-spacing: 6px; color: var(--accent); -unity-font-style: bold; -unity-text-align: middle-left; text-shadow: 0px 2px 6px rgba(0, 0, 0, 0.95); }
.abil__name { font-size: 26px; letter-spacing: 5px; color: var(--c-text); -unity-font-style: bold-and-italic; -unity-text-align: middle-left; text-shadow: 0px 2px 8px rgba(0, 0, 0, 0.95); }
.abil__text { max-width: 460px; font-size: 12px; letter-spacing: 2px; color: var(--c-text); white-space: normal; -unity-font-style: bold; -unity-text-align: upper-left; text-shadow: 0px 2px 6px rgba(0, 0, 0, 0.95); }

.story { padding-left: 16px; border-left-width: 3px; border-color: var(--c-hair-strong); }
.story__row { flex-direction: row; align-items: center; margin-top: 2px; }
.story__dot { width: 8px; height: 8px; margin-right: 12px; rotate: 45deg; background-color: var(--accent); }
.story__name { font-size: 20px; letter-spacing: 5px; color: var(--c-text); -unity-font-style: bold-and-italic; text-shadow: 0px 2px 8px rgba(0, 0, 0, 0.95); }
.story__len { margin-left: 16px; font-size: 11px; letter-spacing: 4px; color: var(--c-text-2); -unity-font-style: bold; text-shadow: 0px 2px 6px rgba(0, 0, 0, 0.95); }

/* ---------------------------------------------------------------------
   3. VEHICLE INFO (right, floating text)
   --------------------------------------------------------------------- */
.right-col { position: absolute; right: 64px; top: 230px; width: 440px; }
.vinfo { transition-property: opacity, translate; transition-duration: 0.3s; transition-timing-function: ease-out; }
.vinfo.info--out { translate: 30px 0; }
.vinfo__top { flex-direction: row; align-items: center; }
.vinfo__top .eyebrow { text-shadow: 0px 2px 8px rgba(0, 0, 0, 0.9); }

.vinfo__name {
    font-size: 60px;
    letter-spacing: 7px;
    color: var(--c-text);
    white-space: nowrap;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-right;
    text-shadow: 0px 4px 14px rgba(0, 0, 0, 0.9);
}

.vinfo__type { margin-bottom: 14px; font-size: 13px; letter-spacing: 8px; color: var(--accent); -unity-font-style: bold; -unity-text-align: middle-right; text-shadow: 0px 2px 8px rgba(0, 0, 0, 0.9); }

.stat { margin-bottom: 14px; }
.stat__head { flex-direction: row; align-items: center; }
.stat__label { font-size: 12px; letter-spacing: 5px; color: var(--c-text); -unity-font-style: bold; text-shadow: 0px 2px 6px rgba(0, 0, 0, 0.95); }
.stat__value { min-width: 40px; font-size: 20px; color: var(--c-text); -unity-font-style: bold; -unity-text-align: middle-right; text-shadow: 0px 2px 6px rgba(0, 0, 0, 0.95); }
.stat__delta { font-size: 14px; color: var(--c-good); -unity-font-style: bold; }
.stat__track { height: 8px; margin-top: 6px; background-color: rgba(255, 255, 255, 0.18); }
.stat__fill { position: absolute; left: 0; top: 0; bottom: 0; background-color: var(--accent); }
.stat__delta-fill { position: absolute; top: 0; bottom: 0; background-color: var(--c-good); }
.stat__tick { position: absolute; top: 0; bottom: 0; width: 2px; background-color: rgba(7, 11, 22, 0.9); }

.vinfo__note { margin-top: 6px; }
.vinfo__note-text { font-size: 11px; letter-spacing: 3px; color: var(--c-text-2); white-space: normal; -unity-font-style: bold; -unity-text-align: upper-right; text-shadow: 0px 2px 6px rgba(0, 0, 0, 0.95); }

/* ---------------------------------------------------------------------
   4. BOTTOM: FOCUS, SELECTOR LINE, SELECT BUTTON
   --------------------------------------------------------------------- */
.bottom { position: absolute; left: 64px; right: 64px; bottom: 34px; flex-direction: row; align-items: flex-end; }
.bottom__left { width: 340px; }
.bottom__center { flex-grow: 1; align-items: center; }
.bottom__right { width: 440px; align-items: flex-end; }

.focus__label { margin-bottom: 8px; text-shadow: 0px 2px 6px rgba(0, 0, 0, 0.95); }
.focus__row { flex-direction: row; }

.fchip { height: 46px; margin-right: 6px; padding: 0 16px 0 16px; justify-content: center; background-color: rgba(6, 10, 20, 0.55); border-bottom-width: 3px; border-color: var(--c-hair-strong); }
.fchip:focus { border-color: var(--c-hair-strong); }
.fchip:hover { background-color: var(--accent-soft); border-color: var(--accent); scale: 1.06 1.06; }
.fchip--on, .fchip--on:focus { background-color: var(--accent-mid); border-color: var(--accent); }
.fchip__text { font-size: 12px; letter-spacing: 4px; color: var(--c-text); -unity-font-style: bold; }

/* Selector: thin line with five portrait nodes */
.selector { flex-direction: row; align-items: center; }

.arrow { width: 56px; height: 56px; margin: 0 14px 40px 14px; align-items: center; justify-content: center; background-color: rgba(6, 10, 20, 0.55); border-radius: 28px; }
.arrow:hover { background-color: var(--accent); scale: 1.12 1.12; }
.arrow:hover .chevron { border-color: var(--c-ink); }

.selector__track { flex-direction: row; align-items: flex-end; }
.selector__line { position: absolute; left: 0; right: 0; top: 44px; height: 2px; background-color: rgba(255, 255, 255, 0.22); }

.node { width: 112px; height: 132px; margin: 0 4px 0 4px; align-items: center; overflow: visible; background-color: rgba(0, 0, 0, 0); }
.node:hover { scale: 1.08 1.08; background-color: rgba(0, 0, 0, 0); }

.node__ring {
    width: 76px;
    height: 76px;
    margin-top: 8px;
    border-radius: 38px;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.4);
    background-color: rgb(8, 13, 26);
    overflow: hidden;
    transition-property: scale, border-color;
    transition-duration: 0.2s;
}

/* IMAGE SLOT: driver portrait */
.node__img { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: scale-and-crop; }
.node__name { margin-top: 12px; font-size: 11px; letter-spacing: 3px; color: var(--c-text-2); white-space: nowrap; -unity-font-style: bold-and-italic; text-shadow: 0px 2px 6px rgba(0, 0, 0, 0.95); }

.node--sel .node__ring { scale: 1.3 1.3; border-color: var(--accent); border-width: 4px; }
.node--sel .node__name { color: var(--accent); }
.node--sel { margin-top: 0; }

.swipe-hint { margin-top: 6px; font-size: 10px; letter-spacing: 6px; color: var(--c-text-2); -unity-font-style: bold; text-shadow: 0px 2px 6px rgba(0, 0, 0, 0.95); }

.pickcta { width: 100%; align-items: flex-end; }
.pickcta__note { margin-bottom: 8px; font-size: 10px; letter-spacing: 4px; color: var(--c-text-2); -unity-font-style: bold; text-shadow: 0px 2px 6px rgba(0, 0, 0, 0.95); }
.pick-btn { width: 100%; height: 92px; }
.pick-btn .btn-cta__label { font-size: 26px; letter-spacing: 7px; }

/* ---------------------------------------------------------------------
   5. WORLD TAGS (positioned from C#)
   --------------------------------------------------------------------- */
.wtags { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.wtag { position: absolute; align-items: center; transition-property: opacity, scale; transition-duration: 0.2s; }
.wtag--hidden { opacity: 0; }
.wtag__dot { width: 12px; height: 12px; margin-bottom: 6px; rotate: 45deg; border-width: 2px; border-color: var(--c-text); background-color: rgba(3, 6, 13, 0.6); }
.wtag__name { font-size: 16px; letter-spacing: 5px; color: var(--c-text); white-space: nowrap; -unity-font-style: bold-and-italic; text-shadow: 0px 2px 8px rgba(0, 0, 0, 0.95); }
.wtag__tap { font-size: 9px; letter-spacing: 5px; color: var(--c-text-2); -unity-font-style: bold; text-shadow: 0px 2px 6px rgba(0, 0, 0, 0.95); }

/* ---------------------------------------------------------------------
   6. CONFIRM DIALOG
   --------------------------------------------------------------------- */
.modal-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(2, 5, 12, 0.82); }
.dlg { width: 780px; padding: 34px 40px 30px 44px; background-color: rgb(10, 16, 30); border-top-width: 3px; border-color: var(--accent); }
.dlg__bar { position: absolute; left: 0; top: 0; bottom: 0; width: 5px; background-color: var(--accent); }
.dlg__title { font-size: 64px; letter-spacing: 9px; color: var(--c-text); -unity-font-style: bold-and-italic; -unity-text-align: middle-left; }
.dlg__text { margin: 10px 0 4px 0; font-size: 12px; letter-spacing: 3px; color: var(--c-text-2); white-space: normal; -unity-font-style: bold; -unity-text-align: upper-left; }
.dlg__sum { flex-direction: row; align-items: center; margin-top: 12px; background-color: var(--c-fill-soft); }
.sum__art { width: 200px; height: 150px; overflow: hidden; background-color: var(--accent-soft); -unity-background-scale-mode: scale-and-crop; }
.sum__list { flex-grow: 1; padding: 0 20px 0 24px; }
.sum__row { flex-direction: row; align-items: center; height: 46px; border-bottom-width: 1px; border-color: var(--c-hair); }
.sum__dot { width: 7px; height: 7px; margin-right: 14px; rotate: 45deg; background-color: var(--accent); }
.sum__label { font-size: 11px; letter-spacing: 5px; color: var(--c-text-3); -unity-font-style: bold; }
.sum__val { font-size: 20px; letter-spacing: 4px; color: var(--c-text); -unity-font-style: bold-and-italic; }
.dlg__row { flex-direction: row; margin-top: 22px; }
.dlg__btn { flex-grow: 1; flex-basis: 0; height: 88px; margin-right: 10px; }
.dlg__btn:last-child { margin-right: 0; }
.car__slash { position: absolute; right: 22%; top: -50%; width: 26px; height: 220%; rotate: 24deg; background-color: var(--c-fill-soft); }
