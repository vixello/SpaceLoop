<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="Scrims" src="project://database/Assets/Ui%20Toolkit/Common/Components/Scrims.uxml?fileID=9197481963319205126&amp;guid=b8d0443616d7dbb44b0593bbb8f9b959&amp;type=3#Scrims" />
    <ui:Template name="ScreenHeader" src="project://database/Assets/Ui%20Toolkit/Common/Components/ScreenHeader.uxml?fileID=9197481963319205126&amp;guid=1894d762554522c48b2121541c7adca5&amp;type=3#ScreenHeader" />
    <Style src="project://database/Assets/Ui%20Toolkit/Common/Common.uss?fileID=7433441132597879392&amp;guid=f1e0c419fffe5c54ea31b5bd59f0c918&amp;type=3#Common" />
    <Style src="project://database/Assets/Ui%20Toolkit/Matchmaking/MatchmakingUnranked.uss?fileID=7433441132597879392&amp;guid=48eea208afcbc19478eec87015fd08ed&amp;type=3#MatchmakingUnranked" />
    
    <ui:VisualElement name="root" class="screen">
        <ui:VisualElement name="rotate-drag-zone" class="layer drag-zone" />
        <ui:Instance template="Scrims" picking-mode="Ignore" class="layer" />
        <ui:VisualElement name="hud" picking-mode="Ignore" class="layer hud">
            <ui:Instance template="ScreenHeader" name="screen-header" picking-mode="Ignore">
                <AttributeOverrides element-name="screen-eyebrow" text="MULTIPLAYER  /  CASUAL  /  NO RP AT STAKE" />
                <AttributeOverrides element-name="screen-title" text="UNRANKED" />
            </ui:Instance>

            <!-- DIAL SWITCH (MATCHES RANKED TAB) -->
            <ui:VisualElement class="mm-dial-row">
                <ui:VisualElement class="mm-dial">
                    <ui:Button name="mode-ranked" class="btn mm-dial__segment mm-dial__segment--left accent-amber">
                        <ui:VisualElement picking-mode="Ignore" class="sheen" />
                        <ui:Label text="RANKED" picking-mode="Ignore" class="tab__label" />
                        <ui:Label text="SEASON 04" picking-mode="Ignore" class="tab__badge" />
                    </ui:Button>
                    <ui:VisualElement picking-mode="Ignore" class="mm-dial__divider" />
                    <ui:Button name="mode-unranked" class="btn mm-dial__segment mm-dial__segment--right tab--active accent-cyan">
                        <ui:VisualElement picking-mode="Ignore" class="sheen" />
                        <ui:Label text="UNRANKED" picking-mode="Ignore" class="tab__label" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement picking-mode="Ignore" class="mm-body mm-body--attached">
                <ui:VisualElement picking-mode="Ignore" class="mm-stage">
                    <ui:VisualElement picking-mode="Ignore" class="spacer" />
                    <ui:VisualElement picking-mode="Ignore" class="mm-plate accent-cyan">
                        <ui:VisualElement picking-mode="Ignore" class="mm-plate__bar" />
