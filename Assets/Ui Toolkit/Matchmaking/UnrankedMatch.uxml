                            <ui:Label text="YOUR RIDE" picking-mode="Ignore" class="eyebrow eyebrow--accent" />
                            <ui:Label name="vehicle-name" text="ZEPHYR GT-X" picking-mode="Ignore" class="mm-plate__name" />
                            <ui:Label text="DRIVER  /  KAI NOVA" picking-mode="Ignore" class="mm-plate__sub" />
                        </ui:VisualElement>
                        <ui:Button name="btn-change-loadout" class="btn btn-ghost accent-cyan">
                            <ui:VisualElement picking-mode="Ignore" class="sheen" />
                            <ui:Label text="CHANGE" picking-mode="Ignore" class="btn-ghost__label" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="queue-panel" picking-mode="Ignore" class="mm-panel accent-cyan">
