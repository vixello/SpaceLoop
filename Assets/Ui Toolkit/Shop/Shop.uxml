                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="row3 row3--wrap" picking-mode="Ignore">
                                <ui:Button class="btn shop-card shop-card--sq rarity-legendary shop-card--selected">
                                    <ui:VisualElement class="shop-card__art art-a2" picking-mode="Ignore">
                                        <ui:VisualElement class="shop-card__slash" picking-mode="Ignore" />
