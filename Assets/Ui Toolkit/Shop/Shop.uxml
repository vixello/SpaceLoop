                                <ui:Label class="shop-card__owned" text="OWNED" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:Button>
                        <ui:Button class="btn shop-card rarity-rare">
                            <ui:VisualElement class="shop-card__art art-car-2" picking-mode="Ignore">
                                <ui:VisualElement class="shop-card__slash" picking-mode="Ignore" />
                                <ui:Label class="tag shop-card__rarity" text="RARE" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="shop-card__bar" picking-mode="Ignore" />
                            <ui:VisualElement class="sheen" picking-mode="Ignore" />
                            <ui:VisualElement class="shop-card__info" picking-mode="Ignore">
                                <ui:Label class="shop-card__name" text="VANTA R9" picking-mode="Ignore" />
                                <ui:Label class="shop-card__type" text="TUNER  /  CLASS A" picking-mode="Ignore" />
                                <ui:VisualElement class="price accent-amber" picking-mode="Ignore">
                                    <ui:VisualElement class="price__icon" picking-mode="Ignore" />
                                    <ui:Label class="price__value" text="180,000" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:Button>
                        <ui:Button class="btn shop-card rarity-rare">
                            <ui:VisualElement class="shop-card__art art-car-3" picking-mode="Ignore">
                                <ui:VisualElement class="shop-card__slash" picking-mode="Ignore" />
                                <ui:Label class="tag shop-card__rarity" text="RARE" picking-mode="Ignore" />
                                <ui:Label class="tag tag--sale shop-card__sale" text="-15%" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="shop-card__bar" picking-mode="Ignore" />
                            <ui:VisualElement class="sheen" picking-mode="Ignore" />
                            <ui:VisualElement class="shop-card__info" picking-mode="Ignore">
                                <ui:Label class="shop-card__name" text="HELIX 88" picking-mode="Ignore" />
                                <ui:Label class="shop-card__type" text="MUSCLE  /  CLASS A" picking-mode="Ignore" />
                                <ui:VisualElement class="price accent-amber" picking-mode="Ignore">
                                    <ui:VisualElement class="price__icon" picking-mode="Ignore" />
                                    <ui:Label class="price__value" text="220,000" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:Button>
                        <ui:Button class="btn shop-card rarity-legendary">
                            <ui:VisualElement class="shop-card__art art-car-4" picking-mode="Ignore">
                                <ui:VisualElement class="shop-card__slash" picking-mode="Ignore" />
                                <ui:Label class="tag shop-card__rarity" text="LEGENDARY" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="shop-card__bar" picking-mode="Ignore" />
                            <ui:VisualElement class="sheen" picking-mode="Ignore" />
                            <ui:VisualElement class="shop-card__info" picking-mode="Ignore">
                                <ui:Label class="shop-card__name" text="OBSIDIAN KING" picking-mode="Ignore" />
                                <ui:Label class="shop-card__type" text="HYPERCAR  /  CLASS S" picking-mode="Ignore" />
                                <ui:VisualElement class="price accent-magenta" picking-mode="Ignore">
                                    <ui:VisualElement class="price__icon" picking-mode="Ignore" />
                                    <ui:Label class="price__value" text="3,200" picking-mode="Ignore" />
