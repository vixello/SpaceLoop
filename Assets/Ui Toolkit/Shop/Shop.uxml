<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/Ui Toolkit/Common/Common.uss" />
    <ui:Style src="project://database/Assets/Ui Toolkit/Shop/Shop.uss" />
    <ui:Template name="Scrims" src="project://database/Assets/Ui Toolkit/Common/Components/Scrims.uxml" />
    <ui:Template name="ScreenHeader" src="project://database/Assets/Ui Toolkit/Common/Components/ScreenHeader.uxml" />

    <!-- 3D preview scene renders behind. Tabs toggle the pages inside the store panel. Image slots: set background-image on .shop-card__art, .feat__art, .promo__art, .bundle__art. -->
    <ui:VisualElement class="screen" name="root" picking-mode="Position">
        <ui:VisualElement class="layer drag-zone" name="rotate-drag-zone" picking-mode="Position" />
        <ui:Instance class="layer" template="Scrims" picking-mode="Ignore" />
        <ui:VisualElement class="layer hud" name="hud" picking-mode="Ignore">
            <ui:Instance template="ScreenHeader" name="screen-header" picking-mode="Ignore">
                <ui:AttributeOverrides element-name="screen-eyebrow" text="STORE  /  DAILY REFRESH 06:12:44" />
                <ui:AttributeOverrides element-name="screen-title" text="SHOP" />
            </ui:Instance>
            <ui:VisualElement class="ticker accent-magenta" picking-mode="Ignore">
                <ui:Label class="tag tag--sale" text="LIMITED" picking-mode="Ignore" />
                <ui:Label class="ticker__text" text="WEEKEND OVERDRIVE  //  ALL SKINS AND OUTFITS UP TO 40% OFF" picking-mode="Ignore" />
                <ui:VisualElement class="spacer" picking-mode="Ignore" />
                <ui:Label class="ticker__timer" text="ENDS 05:12:44" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="tabs-row shop-tabs" picking-mode="Position">
                <ui:Button class="btn tab tab--active accent-amber" name="tab-featured">
                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                    <ui:VisualElement class="edge" picking-mode="Ignore" />
                    <ui:Label class="tab__label" text="FEATURED" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button class="btn tab accent-magenta" name="tab-sale">
                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                    <ui:VisualElement class="edge" picking-mode="Ignore" />
                    <ui:Label class="tab__label" text="SALE" picking-mode="Ignore" />
                    <ui:Label class="tab__badge" text="-40%" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button class="btn tab accent-cyan" name="tab-drivers">
                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                    <ui:VisualElement class="edge" picking-mode="Ignore" />
                    <ui:Label class="tab__label" text="DRIVERS" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button class="btn tab accent-cyan" name="tab-outfits">
                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                    <ui:VisualElement class="edge" picking-mode="Ignore" />
                    <ui:Label class="tab__label" text="OUTFITS" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button class="btn tab accent-cyan" name="tab-vehicles">
                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                    <ui:VisualElement class="edge" picking-mode="Ignore" />
                    <ui:Label class="tab__label" text="VEHICLES" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button class="btn tab accent-cyan" name="tab-skins">
                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                    <ui:VisualElement class="edge" picking-mode="Ignore" />
                    <ui:Label class="tab__label" text="SKINS" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button class="btn tab accent-amber" name="tab-bundles">
                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                    <ui:VisualElement class="edge" picking-mode="Ignore" />
                    <ui:Label class="tab__label" text="BUNDLES" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement class="body" picking-mode="Ignore">
                <ui:VisualElement class="stage" picking-mode="Ignore">
                    <ui:VisualElement class="stage__tools" picking-mode="Ignore">
                        <ui:Button class="btn rot-btn accent-cyan" name="rotate-left">
                            <ui:VisualElement class="chevron chevron--left" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button class="btn rot-btn accent-cyan" name="rotate-right">
                            <ui:VisualElement class="chevron" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="spacer" picking-mode="Ignore" />
                    <ui:VisualElement class="detail rarity-legendary accent-amber" picking-mode="Ignore">
                        <ui:VisualElement class="detail__bar" picking-mode="Ignore" />
                        <ui:VisualElement class="detail__text" picking-mode="Ignore">
                            <ui:VisualElement class="detail__tags" picking-mode="Ignore">
                                <ui:Label class="tag" text="LEGENDARY" name="detail-rarity" picking-mode="Ignore" />
                                <ui:Label class="tag tag--accent" text="VEHICLE SKIN" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:Label class="detail__name" text="PHANTOM WRAP" name="detail-name" picking-mode="Ignore" />
                            <ui:Label class="detail__desc" text="MATTE BLACK BODY WITH REACTIVE VIOLET PINSTRIPES THAT PULSE ON BOOST." name="detail-desc" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="detail__buy" picking-mode="Ignore">
                            <ui:VisualElement class="price accent-magenta detail__price" picking-mode="Ignore">
                                <ui:VisualElement class="price__icon" picking-mode="Ignore" />
                                <ui:Label class="price__value" text="1,200" picking-mode="Ignore" />
                                <ui:VisualElement class="price-old" picking-mode="Ignore">
                                    <ui:Label class="price-old__text" text="1,800" picking-mode="Ignore" />
                                    <ui:VisualElement class="price-old__line" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="detail__buttons" picking-mode="Ignore">
                                <ui:Button class="btn btn-ghost detail__try accent-cyan" name="btn-try">
                                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                    <ui:Label class="btn-ghost__label" text="PREVIEW" picking-mode="Ignore" />
                                </ui:Button>
                                <ui:Button class="btn btn-cta detail__buy-btn accent-amber" name="btn-buy">
                                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                    <ui:Label class="btn-cta__label" text="PURCHASE" picking-mode="Ignore" />
                                </ui:Button>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="store accent-cyan" name="store" picking-mode="Ignore">
                    <ui:VisualElement class="page" name="page-featured" picking-mode="Ignore">
                        <ui:ScrollView class="grid" touch-scroll-type="Elastic" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                            <ui:Button class="btn promo accent-amber" name="promo-pass">
                                <ui:VisualElement class="promo__art" picking-mode="Ignore" />
                                <ui:VisualElement class="promo__slash promo__slash--a" picking-mode="Ignore" />
                                <ui:VisualElement class="promo__slash promo__slash--b" picking-mode="Ignore" />
                                <ui:VisualElement class="promo__slash promo__slash--c" picking-mode="Ignore" />
                                <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                <ui:VisualElement class="edge" picking-mode="Ignore" />
                                <ui:VisualElement class="promo__body" picking-mode="Ignore">
                                    <ui:VisualElement class="promo__top" picking-mode="Ignore">
                                        <ui:Label class="tag tag--accent" text="SEASON 04" picking-mode="Ignore" />
                                        <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                        <ui:Label class="eyebrow" text="ENDS IN" picking-mode="Ignore" />
                                        <ui:VisualElement class="timer promo__timer" picking-mode="Ignore">
                                            <ui:VisualElement class="timer__cell" picking-mode="Ignore">
                                                <ui:Label class="timer__num" text="12" picking-mode="Ignore" />
                                                <ui:Label class="timer__unit" text="D" picking-mode="Ignore" />
                                            </ui:VisualElement>
                                            <ui:VisualElement class="timer__cell" picking-mode="Ignore">
                                                <ui:Label class="timer__num" text="06" picking-mode="Ignore" />
                                                <ui:Label class="timer__unit" text="H" picking-mode="Ignore" />
                                            </ui:VisualElement>
                                            <ui:VisualElement class="timer__cell" picking-mode="Ignore">
                                                <ui:Label class="timer__num" text="41" picking-mode="Ignore" />
                                                <ui:Label class="timer__unit" text="M" picking-mode="Ignore" />
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:Label class="promo__title" text="NEON DRIFT PASS" picking-mode="Ignore" />
                                    <ui:Label class="promo__desc" text="40 TIERS OF REWARDS. DRIVERS, OUTFITS, SKINS AND EXHAUST TRAILS." picking-mode="Ignore" />
                                    <ui:VisualElement class="promo__perks" picking-mode="Ignore">
                                        <ui:VisualElement class="perk" picking-mode="Ignore">
                                            <ui:VisualElement class="perk__dot" picking-mode="Ignore" />
                                            <ui:Label class="perk__text" text="EXCLUSIVE DRIVER: LYRA QUILL" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                        <ui:VisualElement class="perk" picking-mode="Ignore">
                                            <ui:VisualElement class="perk__dot" picking-mode="Ignore" />
                                            <ui:Label class="perk__text" text="LEGENDARY PHANTOM WRAP + OUTFIT" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                        <ui:VisualElement class="perk" picking-mode="Ignore">
                                            <ui:VisualElement class="perk__dot" picking-mode="Ignore" />
                                            <ui:Label class="perk__text" text="2,000 CORES RETURNED OVER THE SEASON" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                    <ui:VisualElement class="promo__bottom" picking-mode="Ignore">
                                        <ui:VisualElement class="price accent-magenta promo__price" picking-mode="Ignore">
                                            <ui:VisualElement class="price__icon" picking-mode="Ignore" />
                                            <ui:Label class="price__value" text="1,500" picking-mode="Ignore" />
                                            <ui:VisualElement class="price-old" picking-mode="Ignore">
                                                <ui:Label class="price-old__text" text="2,200" picking-mode="Ignore" />
                                                <ui:VisualElement class="price-old__line" picking-mode="Ignore" />
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                        <ui:VisualElement class="promo__cta" picking-mode="Ignore">
                                            <ui:Label class="promo__cta-text" text="GET THE PASS" picking-mode="Ignore" />
                                            <ui:VisualElement class="chevron" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:VisualElement class="feat-row" picking-mode="Ignore">
                                <ui:Button class="btn feat accent-cyan">
                                    <ui:VisualElement class="feat__art art-a1" picking-mode="Ignore" />
                                    <ui:VisualElement class="feat__slash" picking-mode="Ignore" />
                                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                    <ui:VisualElement class="edge" picking-mode="Ignore" />
                                    <ui:VisualElement class="feat__body" picking-mode="Ignore">
                                        <ui:Label class="tag tag--accent" text="NEW" picking-mode="Ignore" />
                                        <ui:Label class="feat__title" text="ZERO-7" picking-mode="Ignore" />
                                        <ui:Label class="feat__sub" text="NEW DRIVER  /  SPECTER CLASS" picking-mode="Ignore" />
                                        <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                        <ui:VisualElement class="price accent-magenta" picking-mode="Ignore">
                                            <ui:VisualElement class="price__icon" picking-mode="Ignore" />
                                            <ui:Label class="price__value" text="3,200" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:Button>
                                <ui:Button class="btn feat accent-magenta">
                                    <ui:VisualElement class="feat__art art-a2" picking-mode="Ignore" />
                                    <ui:VisualElement class="feat__slash" picking-mode="Ignore" />
                                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                    <ui:VisualElement class="edge" picking-mode="Ignore" />
                                    <ui:VisualElement class="feat__body" picking-mode="Ignore">
                                        <ui:Label class="tag tag--accent" text="NEW" picking-mode="Ignore" />
                                        <ui:Label class="feat__title" text="OBSIDIAN KING" picking-mode="Ignore" />
                                        <ui:Label class="feat__sub" text="NEW VEHICLE  /  CLASS S" picking-mode="Ignore" />
                                        <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                        <ui:VisualElement class="price accent-magenta" picking-mode="Ignore">
                                            <ui:VisualElement class="price__icon" picking-mode="Ignore" />
                                            <ui:Label class="price__value" text="2,400" picking-mode="Ignore" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:Button>
                            </ui:VisualElement>
                            <ui:VisualElement class="section-head" picking-mode="Ignore">
                                <ui:Label class="eyebrow eyebrow--accent" text="DAILY DEALS" picking-mode="Ignore" />
                                <ui:VisualElement class="spacer" picking-mode="Ignore" />
                                <ui:Label class="eyebrow" text="REFRESH IN" picking-mode="Ignore" />
                                <ui:VisualElement class="timer" picking-mode="Ignore">
                                    <ui:VisualElement class="timer__cell" picking-mode="Ignore">
                                        <ui:Label class="timer__num" text="06" picking-mode="Ignore" />
                                        <ui:Label class="timer__unit" text="H" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="timer__cell" picking-mode="Ignore">
                                        <ui:Label class="timer__num" text="12" picking-mode="Ignore" />
                                        <ui:Label class="timer__unit" text="M" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="row3" picking-mode="Ignore">
                                <ui:Button class="btn shop-card shop-card--sq rarity-rare">
                                    <ui:VisualElement class="shop-card__art art-a3" picking-mode="Ignore">
                                        <ui:VisualElement class="shop-card__slash" picking-mode="Ignore" />
                                        <ui:Label class="tag shop-card__rarity" text="RARE" picking-mode="Ignore" />
                                        <ui:Label class="tag tag--sale shop-card__sale" text="-33%" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="shop-card__bar" picking-mode="Ignore" />
                                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                    <ui:VisualElement class="shop-card__info" picking-mode="Ignore">
                                        <ui:Label class="shop-card__name" text="VOLT PULSE" picking-mode="Ignore" />
                                        <ui:Label class="shop-card__type" text="ENERGY SKIN" picking-mode="Ignore" />
                                        <ui:VisualElement class="price accent-amber" picking-mode="Ignore">
                                            <ui:VisualElement class="price__icon" picking-mode="Ignore" />
                                            <ui:Label class="price__value" text="12,000" picking-mode="Ignore" />
                                            <ui:VisualElement class="price-old" picking-mode="Ignore">
                                                <ui:Label class="price-old__text" text="18,000" picking-mode="Ignore" />
                                                <ui:VisualElement class="price-old__line" picking-mode="Ignore" />
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:Button>
                                <ui:Button class="btn shop-card shop-card--sq rarity-rare">
                                    <ui:VisualElement class="shop-card__art art-a4" picking-mode="Ignore">
                                        <ui:VisualElement class="shop-card__slash" picking-mode="Ignore" />
                                        <ui:Label class="tag shop-card__rarity" text="RARE" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="shop-card__bar" picking-mode="Ignore" />
                                    <ui:VisualElement class="sheen" picking-mode="Ignore" />
                                    <ui:VisualElement class="shop-card__info" picking-mode="Ignore">
