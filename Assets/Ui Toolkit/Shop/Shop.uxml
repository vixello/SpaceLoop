                                                <ui:VisualElement class="price-old__line" picking-mode="Ignore" />
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:Button>
                                <ui:Button class="btn shop-card shop-card--sq rarity-rare">
                                    <ui:VisualElement class="shop-card__art art-a3" picking-mode="Ignore">
                                        <ui:VisualElement class="shop-card__slash" picking-mode="Ignore" />
                                        <ui:Label class="tag shop-card__rarity" text="RARE" picking-mode="Ignore" />
