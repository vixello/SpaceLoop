                                        <ui:Label class="shop-card__type" text="OUTFIT  /  KAI NOVA" picking-mode="Ignore" />
                                        <ui:VisualElement class="price accent-amber" picking-mode="Ignore">
                                            <ui:VisualElement class="price__icon" picking-mode="Ignore" />
