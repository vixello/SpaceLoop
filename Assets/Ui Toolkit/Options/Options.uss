/* =====================================================================
   OPTIONS  (requires Common.uss)
   Left rail toggles six pages: LANGUAGE, AUDIO, STEERING, GRAPHICS
   (provisional), SUPPORT, REDEEM CODE. Each page is a settings column
   plus a live preview card. Toggle .opage--hidden and .otab--on from C#.

   Controls: Slider (styled below), Button switches (.swbtn--on), chips
   (.chip--active), TextFields. Unity's Slider has no fill bar, so the
   track is a plain bar; add a fill element and size it from C# if you
   want a filled look.
   ===================================================================== */

.body { flex-direction: row; flex-grow: 1; margin-top: 22px; }

/* ---------------------------------------------------------------------
   1. RAIL
   --------------------------------------------------------------------- */
.orail { width: 300px; flex-shrink: 0; margin-right: 22px; }
.rail-label { margin-bottom: 10px; }
.rail-label--gap { margin-top: 18px; }

.otab {
    flex-direction: row;
    align-items: center;
    height: 80px;
    margin-bottom: 6px;
    padding: 0 20px 0 22px;
    background-color: var(--c-surface);
}

.otab .glyph { margin-right: 20px; opacity: 0.75; }
.otab .edge { width: 0; }
.otab__label { font-size: 20px; letter-spacing: 5px; color: var(--c-text-2); -unity-font-style: bold-and-italic; }

.otab:hover { background-color: var(--c-surface-hi); translate: 8px 0; }
.otab:hover .otab__label { color: var(--c-text); }
.otab:hover .edge { width: 4px; }
.otab--on, .otab--on:hover { background-color: var(--accent-soft); translate: 0 0; }
.otab--on .otab__label { color: var(--c-text); }
.otab--on .glyph { opacity: 1; }
.otab--on .edge, .otab--on:hover .edge { width: 7px; }

.rail-foot { font-size: 10px; letter-spacing: 4px; color: var(--c-text-3); -unity-font-style: bold; -unity-text-align: middle-left; }

/* ---------------------------------------------------------------------
   2. PAGE LAYOUT
   --------------------------------------------------------------------- */
.opages { flex-grow: 1; flex-shrink: 1; }
.opage { flex-direction: row; flex-grow: 1; }
.opage--hidden { display: none; }

.ocol { flex-grow: 1; flex-shrink: 1; margin-right: 18px; padding: 18px 22px 18px 24px; background-color: var(--c-surface); border-top-width: 2px; border-color: var(--accent); }
.ocol--center { align-items: center; justify-content: center; }

.section-head { flex-direction: row; align-items: center; margin: 4px 0 12px 0; flex-shrink: 0; }
.note { margin-bottom: 12px; font-size: 12px; letter-spacing: 3px; color: var(--c-text-3); white-space: normal; -unity-font-style: bold; -unity-text-align: upper-left; }

.slist { flex-grow: 1; }

/* Setting row */
.srow {
    flex-direction: row;
    align-items: center;
    min-height: 84px;
    margin-bottom: 6px;
    padding: 8px 20px 8px 22px;
    background-color: var(--c-fill-soft);
    border-left-width: 3px;
    border-color: var(--c-hair-strong);
}

.srow:hover { background-color: var(--c-fill-mid); border-color: var(--accent); }
.srow__text { width: 280px; flex-shrink: 0; margin-right: 20px; }
.srow__label { font-size: 21px; letter-spacing: 4px; color: var(--c-text); -unity-font-style: bold-and-italic; -unity-text-align: middle-left; }
.srow__sub { font-size: 10px; letter-spacing: 3px; color: var(--c-text-3); white-space: normal; -unity-font-style: bold; -unity-text-align: upper-left; }
.srow__val { width: 80px; flex-shrink: 0; font-size: 24px; color: var(--accent); -unity-font-style: bold-and-italic; -unity-text-align: middle-right; }
.srow .chips { flex-grow: 1; justify-content: flex-end; }
.srow .chip { height: 40px; margin: 2px 0 2px 8px; padding: 0 16px 0 16px; }

/* Slider */
.slider { flex-grow: 1; margin: 0; }
.slider .unity-base-slider__drag-container { height: 44px; }
.slider .unity-base-slider__tracker { position: absolute; left: 0; right: 0; top: 18px; height: 8px; margin: 0; background-color: var(--c-fill-mid); border-width: 0; border-radius: 0; }
.slider .unity-base-slider__dragger { position: absolute; top: 3px; width: 22px; height: 38px; margin: 0; background-color: var(--accent); border-width: 0; border-radius: 0; }
.slider .unity-base-slider__dragger-border { display: none; }
.slider:hover .unity-base-slider__dragger { background-color: var(--accent-hi); }

/* Switch */
.swbtn { width: 78px; height: 38px; padding: 0; background-color: var(--c-fill-mid); border-radius: 19px; }
.swbtn:hover { background-color: var(--c-fill-mid); scale: 1.06 1.06; }
.swbtn--on, .swbtn--on:hover { background-color: var(--accent-mid); }
.switch { width: 100%; height: 100%; }
.switch__knob { position: absolute; left: 5px; top: 5px; width: 28px; height: 28px; border-radius: 14px; background-color: var(--c-text-2); transition-property: left, background-color; transition-duration: 0.2s; transition-timing-function: ease-out; }
.swbtn--on .switch__knob { left: 45px; background-color: var(--accent); }

/* ---------------------------------------------------------------------
   3. PREVIEW COLUMN
   --------------------------------------------------------------------- */
.prev { width: 32%; min-width: 420px; max-width: 560px; flex-shrink: 0; padding: 18px 22px 22px 24px; background-color: var(--c-surface); border-top-width: 2px; border-color: var(--accent); }
.prev__card { margin-top: 10px; padding: 26px 24px 22px 28px; background-color: var(--c-fill-soft); border-left-width: 4px; border-color: var(--accent); }
.prev__big { font-size: 48px; letter-spacing: 7px; color: var(--c-text); white-space: nowrap; -unity-font-style: bold-and-italic; -unity-text-align: middle-left; }
.prev__big--sm { font-size: 30px; }
.prev__sub { margin-top: 6px; font-size: 12px; letter-spacing: 3px; color: var(--c-text-2); white-space: normal; -unity-font-style: bold; -unity-text-align: upper-left; }
.prev__row { flex-direction: row; margin-top: 18px; }
.prev__row .tag { margin-right: 8px; }
.prev__note { margin-top: 14px; padding: 12px 16px 12px 18px; background-color: var(--c-fill-soft); }
.prev__note-text { font-size: 10px; letter-spacing: 4px; color: var(--c-text-3); -unity-font-style: bold; -unity-text-align: middle-left; }
.prev__note-val { font-size: 15px; letter-spacing: 3px; color: var(--c-text); -unity-font-style: bold; -unity-text-align: middle-left; }
.prev__tip { margin-top: 16px; white-space: normal; -unity-text-align: upper-left; }
.prev__btn { width: 100%; height: 76px; margin-top: 14px; }
.prev__two { flex-direction: row; margin-top: 14px; }
.prev__half { flex-grow: 1; flex-basis: 0; height: 72px; margin-right: 8px; padding: 0 8px 0 8px; }
.prev__half:last-child { margin-right: 0; }
.prev__links-label { margin: 18px 0 8px 0; }

/* ---------------------------------------------------------------------
   4. LANGUAGE
   --------------------------------------------------------------------- */
.lang-grid { flex-shrink: 0; height: 330px; margin-bottom: 14px; }
.lang-grid .unity-scroll-view__content-container { flex-direction: row; flex-wrap: wrap; align-content: flex-start; }

.lang {
    flex-direction: row;
    align-items: center;
    width: 32%;
    height: 92px;
    margin: 0 1.3% 8px 0;
    padding: 0 16px 0 0;
    background-color: var(--c-fill-soft);
    border-width: 1px;
    border-color: var(--c-hair);
}

.lang:focus { border-color: var(--c-hair); }
.lang:hover { background-color: var(--c-fill-mid); border-color: var(--accent); scale: 1.04 1.04; }
.lang--on, .lang--on:focus { background-color: var(--accent-soft); border-color: var(--accent); }
.lang--soon { opacity: 0.5; }

.lang__code { width: 64px; height: 100%; margin-right: 14px; align-items: center; justify-content: center; background-color: var(--c-fill-mid); }
.lang--on .lang__code { background-color: var(--accent); }
.lang__code-text { font-size: 22px; letter-spacing: 2px; color: var(--c-text); -unity-font-style: bold-and-italic; }
.lang--on .lang__code-text { color: var(--c-ink); }
.lang__text { flex-grow: 1; flex-shrink: 1; }
.lang__native { font-size: 19px; letter-spacing: 3px; color: var(--c-text); white-space: nowrap; -unity-font-style: bold-and-italic; -unity-text-align: middle-left; }
.lang__english { font-size: 9px; letter-spacing: 3px; color: var(--c-text-3); -unity-font-style: bold; -unity-text-align: middle-left; }
.lang__state { font-size: 8px; letter-spacing: 2px; color: var(--c-text-3); -unity-font-style: bold; }
.lang__sel { align-items: center; }
.lang__sel .check { margin: 0 0 2px 0; }
.lang__sel-text { font-size: 8px; letter-spacing: 2px; color: var(--accent); -unity-font-style: bold; }

/* ---------------------------------------------------------------------
   5. AUDIO EQUALIZER
   --------------------------------------------------------------------- */
.eq { flex-direction: row; align-items: flex-end; height: 240px; margin-top: 10px; padding: 18px 18px 0 18px; background-color: var(--c-fill-soft); border-bottom-width: 3px; border-color: var(--accent); }
.eq__bar { flex-grow: 1; flex-basis: 0; margin-right: 5px; background-color: var(--accent); }
.eq__bar:last-child { margin-right: 0; }

/* ---------------------------------------------------------------------
   6. STEERING
   --------------------------------------------------------------------- */
.schemes { flex-direction: row; flex-shrink: 0; margin-bottom: 12px; }

.sch {
    flex-grow: 1;
    flex-basis: 0;
    height: 146px;
    margin-right: 8px;
    padding: 12px 8px 8px 8px;
    align-items: center;
    background-color: var(--c-fill-soft);
    border-bottom-width: 3px;
    border-color: var(--c-hair-strong);
}

.sch:last-child { margin-right: 0; }
.sch:focus { border-color: var(--c-hair-strong); }
.sch:hover { background-color: var(--c-fill-mid); scale: 1.05 1.05; }
.sch--on, .sch--on:focus { background-color: var(--accent-soft); border-color: var(--accent); }

.sch__ico { width: 70px; height: 62px; align-items: center; justify-content: center; }
.sch__shape { background-color: rgba(0, 0, 0, 0); border-color: var(--c-text-2); }
.sch--on .sch__shape { border-color: var(--accent); }
.sch__shape--tilt { width: 32px; height: 56px; border-width: 4px; border-radius: 6px; rotate: 18deg; }
.sch__shape--wheel { width: 58px; height: 58px; border-width: 6px; border-radius: 29px; }
.sch__shape--arrows { width: 60px; height: 32px; border-left-width: 12px; border-right-width: 12px; }
.sch__shape--slide { width: 64px; height: 14px; border-width: 4px; border-radius: 7px; }
.sch__label { margin-top: 8px; font-size: 18px; letter-spacing: 5px; color: var(--c-text); -unity-font-style: bold-and-italic; }
.sch__sub { font-size: 9px; letter-spacing: 2px; color: var(--c-text-3); white-space: nowrap; -unity-font-style: bold; }

.slist--short { flex-grow: 1; }

.phone { margin-top: 10px; padding: 10px; background-color: rgb(6, 10, 20); border-width: 6px; border-radius: 30px; border-color: var(--c-hair-strong); }
.phone__screen { height: 250px; background-color: rgba(0, 229, 255, 0.07); border-radius: 18px; overflow: hidden; }
.phone__hud { position: absolute; left: 18px; top: 12px; }
.phone__hud-text { font-size: 10px; letter-spacing: 4px; color: var(--c-text-2); -unity-font-style: bold; }
.phone__tilt { position: absolute; left: 0; right: 0; top: 14px; align-items: center; }
.phone__tilt-text { padding: 3px 14px 3px 14px; font-size: 10px; letter-spacing: 5px; color: var(--c-ink); background-color: var(--accent); -unity-font-style: bold; }

.phone__wheel { position: absolute; left: 34px; bottom: 26px; width: 118px; height: 118px; }
.phone__wheel-ring { position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-radius: 59px; border-width: 7px; border-color: var(--accent); }
.phone__wheel-a { position: absolute; left: 6px; top: 55px; right: 6px; height: 8px; background-color: var(--accent); }
.phone__wheel-b { position: absolute; left: 55px; top: 60px; width: 8px; height: 52px; background-color: var(--accent); }
.phone__wheel-hub { position: absolute; left: 44px; top: 44px; width: 30px; height: 30px; border-radius: 15px; background-color: rgb(6, 10, 20); border-width: 5px; border-color: var(--accent); }

.phone__pedals { position: absolute; right: 22px; bottom: 22px; width: 150px; }
.pedal { height: 48px; margin-top: 6px; align-items: center; justify-content: center; background-color: var(--c-fill-mid); border-bottom-width: 3px; border-color: var(--c-text-3); }
.pedal--gas { height: 64px; border-color: var(--c-good); background-color: rgba(70, 255, 160, 0.14); }
.pedal--brake { border-color: rgb(255, 82, 96); background-color: rgba(255, 82, 96, 0.14); }
.pedal--drift { border-color: rgb(255, 190, 0); background-color: rgba(255, 190, 0, 0.14); }
.pedal__text { font-size: 12px; letter-spacing: 5px; color: var(--c-text); -unity-font-style: bold; }

/* ---------------------------------------------------------------------
   7. SUPPORT
   --------------------------------------------------------------------- */
.sf__label { margin: 12px 0 8px 0; }
.sf__meta { flex-direction: row; margin-top: 6px; }
.sf__count { font-size: 11px; letter-spacing: 3px; color: var(--c-text-3); -unity-font-style: bold; }
.sf__reply { font-size: 11px; letter-spacing: 3px; color: var(--c-text-2); -unity-font-style: bold; }
.sf__toggles { margin-top: 8px; }
.sf__send { width: 100%; height: 80px; margin-top: 6px; }

.sfield { margin: 0; }
.sfield .unity-base-text-field__input { height: 64px; margin: 0; padding: 0 20px 0 20px; color: var(--c-text); font-size: 20px; letter-spacing: 3px; background-color: var(--c-fill-soft); border-width: 0; border-bottom-width: 3px; border-radius: 0; border-color: var(--c-hair-strong); -unity-font-style: bold; -unity-text-align: middle-left; }
.sfield .unity-base-text-field__input:focus { background-color: var(--accent-soft); border-color: var(--accent); }
.sfield--multi .unity-base-text-field__input { height: 150px; padding: 14px 20px 14px 20px; white-space: normal; -unity-text-align: upper-left; }

.pid { flex-direction: row; align-items: center; height: 64px; margin-top: 10px; padding: 0 20px 0 20px; background-color: var(--c-fill-soft); }
.pid:hover { background-color: var(--c-fill-mid); scale: 1.02 1.02; }
.pid__text { flex-grow: 1; }
.pid__value { font-size: 22px; letter-spacing: 4px; color: var(--c-text); -unity-font-style: bold; -unity-text-align: middle-left; }
.pid__copy { font-size: 12px; letter-spacing: 4px; color: var(--accent); -unity-font-style: bold; }

.lrow { flex-direction: row; align-items: center; height: 72px; margin-bottom: 6px; padding: 0 20px 0 24px; background-color: var(--c-fill-soft); }
.lrow:hover { background-color: var(--c-fill-mid); translate: 6px 0; }
.lrow__text { flex-grow: 1; }
.lrow__label { font-size: 20px; letter-spacing: 4px; color: var(--c-text); -unity-font-style: bold-and-italic; -unity-text-align: middle-left; }
.lrow__sub { font-size: 10px; letter-spacing: 3px; color: var(--c-text-3); -unity-font-style: bold; -unity-text-align: middle-left; }

/* ---------------------------------------------------------------------
   8. REDEEM CODE
   --------------------------------------------------------------------- */
.ticket { width: 760px; background-color: rgb(12, 20, 38); border-left-width: 6px; border-color: var(--accent); }
.ticket__perf { position: absolute; right: 150px; top: 0; bottom: 0; width: 2px; background-color: var(--c-hair-strong); }
.ticket__main { padding: 34px 190px 34px 40px; }
.ticket__title { font-size: 64px; letter-spacing: 10px; color: var(--c-text); -unity-font-style: bold-and-italic; -unity-text-align: middle-left; }
.ticket__text { margin-bottom: 22px; font-size: 12px; letter-spacing: 3px; color: var(--c-text-2); white-space: normal; -unity-font-style: bold; -unity-text-align: upper-left; }
.ticket__hint { margin: 8px 0 18px 0; font-size: 10px; letter-spacing: 3px; color: var(--c-text-3); -unity-font-style: bold; }
.ticket__btn { width: 100%; height: 84px; }

.code-field { margin: 0; }
.code-field .unity-base-text-field__input { height: 96px; margin: 0; padding: 0 20px 0 20px; color: var(--c-text); font-size: 40px; letter-spacing: 10px; background-color: var(--c-fill-soft); border-width: 0; border-bottom-width: 4px; border-radius: 0; border-color: var(--accent); -unity-font-style: bold; -unity-text-align: middle-center; }
.code-field .unity-base-text-field__input:focus { background-color: var(--accent-soft); border-color: var(--accent-hi); }

.result { flex-direction: row; align-items: center; margin-top: 18px; padding: 16px 24px 16px 24px; background-color: var(--accent-soft); border-left-width: 4px; border-color: var(--accent); }
.result__title { margin: 0 20px 0 12px; font-size: 22px; letter-spacing: 4px; color: var(--c-text); -unity-font-style: bold-and-italic; }
.result__text { margin-right: 24px; font-size: 11px; letter-spacing: 3px; color: var(--c-text-2); -unity-font-style: bold; }
.result .price { margin-right: 16px; }

.hrow { flex-direction: row; align-items: center; height: 76px; margin-top: 8px; padding: 0 18px 0 20px; background-color: var(--c-fill-soft); border-left-width: 3px; border-color: var(--c-good); }
.hrow--bad { border-color: var(--c-text-3); opacity: 0.6; }
.hrow__code { width: 190px; font-size: 13px; letter-spacing: 3px; color: var(--c-text); -unity-font-style: bold; -unity-text-align: middle-left; }
.hrow__reward { font-size: 12px; letter-spacing: 3px; color: var(--accent); -unity-font-style: bold; }
.hrow__date { font-size: 11px; letter-spacing: 3px; color: var(--c-text-3); -unity-font-style: bold; }
