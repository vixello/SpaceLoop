# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Bb]uilds/*/

# MemoryCapturs can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# TextMesh Pro related folders
/[Aa]ssets/TextMesh*Pro/

# Visual Studio cache directory
.vs/

# Visual Studio Code cache directory
.vscode/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
.utmp/
*.utmp
*.utmp.meta
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*



# ---------------------------------------------------------
# ANDROID (Gradle, Resolver, EOS native libs etc.)
# ---------------------------------------------------------

# Gradle cache created by Unity + Google Play Games + AdMob
.gradle/
.gradle/**
/build/
/launcher/build/
/unityLibrary/build/
/unityLibrary/src/main/assets/bin/Data/*

# Play Services Resolver artifacts
/Assets/Plugins/Android/**/libs/
/Assets/Plugins/Android/**/bin/
/Assets/Plugins/Android/**/obj/
/Assets/Plugins/Android/AndroidManifest.xml.meta
Assets/Firebase/m2repository/**

# Burst and IL2CPP
Library/PackageCache/com.unity.burst*/
Library/PackageCache/com.unity.il2cpp*

# Native libs from SDKs (downloaded prebuilt libs)
*.aar
*.jar
*.so


# ---------------------------------------------------------
# IOS (CocoaPods, generated Xcode projects)
# ---------------------------------------------------------
/Pods/
/Podfile.lock
/xcuserdata/
/DerivedData/
/*.xcworkspace
/*.xcodeproj/project.xcworkspace/
*.mode1v3
*.mode2v3
*.perspectivev3


# ---------------------------------------------------------
# EOS SDK RELATED IGNORE
# ---------------------------------------------------------

# EOS auto-generated C# bindings in Library
Library/EpicOnlineServices/

# EOS native libs for platforms (do NOT commit)
# (Unity copies them into the build output automatically)
Assets/Plugins/EOS/SDK/Bin/**
Assets/Plugins/EOS/SDK/Lib/**
Assets/Plugins/EOS/SDK/Include/**

# EOS autogen config or cache files
eos_config.json
EOS_DeploymentSamples/Config/**
EOS/Config/**
*.pdb
*.json.meta
# EOS Unity package archives
*.tgz


# ---------------------------------------------------------
# GOOGLE PLAY GAMES PLUGIN
# ---------------------------------------------------------

# GPGS Resolver artifacts
Assets/GooglePlayGames/Editor/m2repository/**
Assets/GooglePlayGames/Editor/GooglePlayGames.settings

# Generated Android resources
Assets/GooglePlayGames/Editor/Generated/**

# Temporary json credentials (NEVER COMMIT)
*.keystore
*.jks
google-services.json
google-play-games.json
play-services.json
key.json


# ---------------------------------------------------------
# GOOGLE MOBILE ADS (ADMOB)
# ---------------------------------------------------------

# Generated adapter libs (resolver output)
Assets/GoogleMobileAds/Editor/m2repository/**
Assets/Plugins/Android/googlemobileads-unity.aar
Assets/Plugins/Android/googlemobileads-unity.aar.meta
Assets/Plugins/Android/googlemobileads**.aar
Assets/Plugins/Android/**/m2repository/**

# iOS AdMob Pods
Pods/
Podfile.lock


# ---------------------------------------------------------
# ETC
# ---------------------------------------------------------

# Addressables
Library/com.unity.addressables/**
Assets/AddressableAssetsData/AssetGroups/*.bin

# Rider
.idea/
*.sln.iml

# Crashlytics / Firebase
crashlytics-build.properties
fabric.properties

# Local environment files
.env
.env*
*.private
*.secret

# Keys
*.pem
*.cer
*.mobileprovision
*.p12

# Unity baked lighting
[Ll]ightmap-*.exr
[Ll]ightmap-*.png
[Ll]ightmap-*.hdr

# Lighting data asset
[Ll]ightingData.asset

# GI cache / baking data 
[Gg]i[Cc]ache/
[Ll]ibrary/

# Newer Unity baking system 
*.lighting
*.baking
*.bytes

# Specifically your case
*Baking Set*
*.CellData.bytes
*.CellSupportData.bytes
*.CellOptionalData.bytes